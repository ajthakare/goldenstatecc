# Bengals Cricket Club - Admin Interface Environment Variables
#
# SECURITY WARNING: Never commit this file to git!
# This file contains sensitive credentials that could compromise your deployment.

# Netlify Configuration
# Create a Personal Access Token at: https://app.netlify.com/user/applications
# Required permissions: Read/Write access to Netlify Blobs
NETLIFY_AUTH_TOKEN=<your-netlify-token-here>

# Netlify Site ID (found in Site Settings -> General -> Site details)
SITE_ID=<your-site-id-here>

# Session Security
# Generate with: node docs/scripts/generate-session-secret.cjs
# IMPORTANT: Rotate this secret every 6 months for security
SESSION_SECRET=<generate-64-char-random-string>

# Environment (set to "production" in Netlify)
NODE_ENV=development

# Weekly Blobs Backup (netlify/functions/backup-weekly.ts)
# Fine-grained GitHub PAT scoped to just the ajthakare/goldenstatecc-backups repo,
# with Contents: Read and write permission. Also used by local-debug/scripts/restore-from-backup.js.
BACKUP_GITHUB_TOKEN=<your-github-pat-here>
