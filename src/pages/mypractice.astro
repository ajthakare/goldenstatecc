---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { validateAdminSession, isMember } from '../middleware/auth';
import { parseLocalDate, formatDateDisplay } from '../utils';
import logo from '../assets/GSCC.svg';
import '../styles/admin.css';

// Check authentication
const cookieHeader = Astro.request.headers.get('cookie');
const session = validateAdminSession(cookieHeader || '');

// Redirect to login if not authenticated
if (!session || !isMember(session)) {
  return Astro.redirect('/login');
}
---

<Layout title="Practice Sessions - Golden State Cricket Club">
  <PageHeader kicker="Your season" title="Practice Sessions" subtitle="Next 30 days — mark your availability for upcoming practices" />

  <div class="max-w-5xl mx-auto px-4 py-8" style="overflow: visible; min-height: auto;">

    <!-- Emergency Contact Warning -->
    <div id="emergency-contact-warning" class="hidden mb-6 p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded-lg">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-yellow-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <div class="flex-1">
          <h3 class="font-semibold text-yellow-800 mb-1">Emergency Contact Information Missing</h3>
          <p class="text-sm text-yellow-700 mb-2">
            Please add your emergency contact information to your profile. This is required for safety purposes.
          </p>
          <a href="/profile" class="inline-block text-sm font-medium text-yellow-800 hover:text-yellow-900 underline">
            Update Profile →
          </a>
        </div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="state-container">
      <img src={logo.src} alt="GSCC" class="loading-logo" width="64" height="64" />
      <div class="spinner"></div>
      <p class="state-text">Loading practices...</p>
    </div>

    <!-- Error State -->
    <div id="error-container" class="alert alert-error" style="display: none;">
      <p id="error-text"></p>
    </div>

    <!-- No Practices State -->
    <div id="no-practices" class="state-container" style="display: none;">
      <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="empty-text">No upcoming practice sessions in the next 30 days</p>
      <p class="empty-subtext">Check back later for new practice sessions</p>
    </div>

    <!-- Practices Grid -->
    <div id="practices-grid" class="practices-grid" style="display: none;">
      <!-- Practices will be inserted here -->
    </div>
  </div>

  <!-- All practice styles are now in /src/styles/admin.css -->
  <style is:global>
    .loading-logo {
      width: 64px;
      height: 64px;
      margin-bottom: 20px;
      animation: pulse-logo 1.6s ease-in-out infinite;
    }

    @keyframes pulse-logo {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(0.94); }
    }

    /* Fix oversized empty state icon */
    #no-practices .empty-icon {
      width: 64px;
      height: 64px;
      color: #d1d5db;
      margin-bottom: 16px;
    }

    .state-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 64px 24px;
      text-align: center;
    }

    .empty-text {
      font-size: 18px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 8px;
    }

    .empty-subtext {
      font-size: 14px;
      color: #6b7280;
    }

    /* Extra Players Section Styling */
    .extra-players-section {
      margin-top: 1rem;
      margin-bottom: 1rem;
      padding: 1rem;
      background-color: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }

    .extra-players-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 500;
      color: #374151;
      margin-bottom: 0.5rem;
    }

    .extra-players-select {
      width: 100%;
      max-width: 300px;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      background-color: white;
      color: #111827;
      cursor: pointer;
      transition: all 0.2s;
    }

    .extra-players-select:hover:not(:disabled) {
      border-color: #A82B24;
    }

    .extra-players-select:focus {
      outline: none;
      border-color: #A82B24;
      box-shadow: 0 0 0 3px rgba(168, 43, 36, 0.12);
    }

    .extra-players-select:disabled {
      background-color: #f3f4f6;
      cursor: not-allowed;
      opacity: 0.6;
    }

    .extra-players-hint {
      display: block;
      font-size: 0.75rem;
      color: #6b7280;
      margin-top: 0.5rem;
      font-style: italic;
    }

    /* Available Players Section */
    .available-players-section {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid #e5e7eb;
    }

    .available-players-toggle {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      color: #374151;
      cursor: pointer;
      transition: all 0.2s;
    }

    .available-players-toggle:hover {
      background: #f3f4f6;
      border-color: #d1d5db;
    }

    .toggle-icon {
      transition: transform 0.2s;
      color: #6b7280;
    }

    .available-players-toggle.expanded .toggle-icon {
      transform: rotate(180deg);
    }

    .available-players-list {
      margin-top: 0.75rem;
      padding: 1rem;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }

    .players-loading {
      text-align: center;
      color: #6b7280;
      font-size: 0.875rem;
      padding: 1rem;
    }

    .players-section {
      margin-bottom: 1rem;
    }

    .players-section:last-child {
      margin-bottom: 0;
    }

    .players-section-title {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      color: #6b7280;
      margin-bottom: 0.5rem;
      letter-spacing: 0.05em;
    }

    .players-section-title.available {
      color: #1B6B3A;
    }

    .players-section-title.bowling-only {
      color: #8A6A15;
    }

    .player-names-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    a.player-name-badge {
      text-decoration: none;
      transition: box-shadow 0.15s;
    }

    a.player-name-badge:hover {
      box-shadow: 0 0 0 2px currentColor;
    }

    .player-name-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.375rem 0.75rem;
      background: white;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 0.875rem;
      color: #111827;
    }

    .player-name-badge.available {
      background: #EAF6EE;
      border-color: #9BC9AC;
      color: #1B6B3A;
    }

    .player-name-badge.bowling-only {
      background: #F7EFD8;
      border-color: #DFC77E;
      color: #8A6A15;
    }

    .no-players-message {
      text-align: center;
      color: #9ca3af;
      font-size: 0.875rem;
      font-style: italic;
      padding: 1rem;
    }

    /* Mobile-specific fixes to ensure all content is visible */
    @media (max-width: 768px) {
      html,
      body,
      main {
        overflow-y: auto !important;
        overflow-x: hidden !important;
        height: auto !important;
        min-height: 100vh;
      }

      #practices-grid,
      .practices-grid,
      .practice-card {
        overflow: visible !important;
        height: auto !important;
        min-height: 0 !important;
      }

      .max-w-5xl {
        overflow: visible !important;
        height: auto !important;
      }

      /* Ensure cards have proper bottom spacing */
      .practice-card {
        margin-bottom: 3rem !important;
        padding-bottom: 2rem !important;
      }

      .availability-buttons {
        margin-bottom: 1rem !important;
      }
    }

    /* Icon treatment for client-rendered practice cards */
    .practice-type-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--color-maroon-100, #F6E7E4);
      color: var(--color-maroon-600, #8C1D18);
      font-size: 0 !important;
    }
    .practice-detail svg { color: var(--color-muted-text, #6B635C); }
    .lock-message svg { color: var(--color-gold-600, #A9821B); }

    /* Wednesday slots: batting places and the one-slot note */
    .slot-capacity {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
      font-size: 0.875rem;
      color: var(--color-text-body, #374151);
    }
    .slot-capacity-bar {
      flex: 1;
      height: 8px;
      border-radius: 999px;
      background: #E5E7EB;
      overflow: hidden;
    }
    .slot-capacity-fill {
      height: 100%;
      border-radius: 999px;
      background: #10B981;
    }
    .slot-capacity.is-full .slot-capacity-fill { background: #DC2626; }
    .slot-capacity-text { font-weight: 600; white-space: nowrap; }
    .slot-capacity.is-full .slot-capacity-text { color: #B91C1C; }
    .slot-note {
      padding: 0.75rem 1rem;
      border-radius: 8px;
      background: #EFF6FF;
      border: 1px solid #BFDBFE;
      color: #1E40AF;
      font-size: 0.875rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }
    .slot-note.is-full {
      background: #FEF2F2;
      border-color: #FECACA;
      color: #991B1B;
    }
    /* Slot picker inside the Wednesday card */
    .slot-picker { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.25rem; }
    .slot-option {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.75rem 0.875rem; border: 1.5px solid #E5E7EB; border-radius: 10px;
      background: #fff; cursor: pointer; transition: border-color 0.15s, background 0.15s;
    }
    .slot-option.is-selected { border-color: var(--color-maroon-600, #8C1D18); background: #FBF5F4; }
    .slot-option input { width: 1.1rem; height: 1.1rem; margin: 0; flex-shrink: 0; accent-color: var(--color-maroon-600, #8C1D18); }
    .slot-option-main { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .slot-option-name { font-weight: 700; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
    .slot-option-you { font-size: 0.7rem; font-weight: 700; color: #065F46; background: #D1FAE5; padding: 0.1rem 0.45rem; border-radius: 999px; }
    .slot-option-time { font-size: 0.85rem; color: #4B5563; white-space: nowrap; }
    .slot-option-count { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; width: 4.75rem; flex-shrink: 0; }
    .slot-option-count .slot-capacity-bar { flex: none; width: 100%; height: 6px; border-radius: 999px; background: #E5E7EB; overflow: hidden; display: block; }
    .slot-option-count .slot-capacity-fill { display: block; height: 100%; border-radius: 999px; background: #10B981; }
    .slot-option.is-full .slot-capacity-fill { background: #DC2626; }
    .slot-option-text { font-size: 0.8rem; font-weight: 600; white-space: nowrap; }
    .slot-option.is-full .slot-option-text { color: #B91C1C; }
    .slot-status-line { align-items: center; }
    .slot-status-line + .slot-status-line { margin-top: 0.35rem; }
    .slot-status-name { font-weight: 700; font-size: 0.85rem; min-width: 3.25rem; }
    .slot-players + .slot-players { margin-top: 1rem; }
    .slot-players-title { font-weight: 700; font-size: 0.85rem; margin-bottom: 0.5rem; color: #374151; }

    .practice-type-badge.badge-slot {
      background: #EEF2FF;
      color: #3730A3;
      margin-left: 0.25rem;
    }
  </style>

  <script>
    import { practiceHeading } from '../utils/practiceSlots';
    // Inline icon helpers (client-rendered cards can't use the <Icon> component)
    const _svg = (paths, sz = 16) =>
      `<svg xmlns="http://www.w3.org/2000/svg" width="${sz}" height="${sz}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-0.18em;flex-shrink:0">${paths}</svg>`;
    const IC = {
      activity: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
      bat: '<g transform="rotate(-40 12 12)"><rect x="9" y="5" width="6" height="13" rx="3"/><line x1="12" y1="5" x2="12" y2="2.5"/></g><circle cx="17" cy="18" r="2.5"/>',
      rings: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>',
      calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
      clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
      pin: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
      check: '<path d="M20 6 9 17l-5-5"/>',
      x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
      lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
    };
    let practices: any[] = [];
    let updatingPracticeId: string | null = null;

    // Check for emergency contact info and show warning if missing
    async function checkEmergencyContact() {
      try {
        const response = await fetch('/.netlify/functions/auth-check');
        if (response.ok) {
          const result = await response.json();
          const user = result.user;

          if (!user.emergencyContactName || !user.emergencyContactNumber) {
            const warningEl = document.getElementById('emergency-contact-warning');
            if (warningEl) {
              warningEl.classList.remove('hidden');
            }
          }
        }
      } catch (error) {
        console.error('Error checking emergency contact:', error);
      }
    }

    // Call on page load
    checkEmergencyContact();

    // Utility functions for date and time
    function parseLocalDate(dateString: string): Date {
      const parts = dateString.split('-');
      return new Date(
        parseInt(parts[0]),
        parseInt(parts[1]) - 1,
        parseInt(parts[2])
      );
    }

    function formatDateDisplay(dateString: string): string {
      const date = parseLocalDate(dateString);
      return date.toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });
    }

    async function loadPractices() {
      const loading = document.getElementById('loading');
      const errorContainer = document.getElementById('error-container');
      const errorText = document.getElementById('error-text');
      const noPractices = document.getElementById('no-practices');
      const practicesGrid = document.getElementById('practices-grid');

      try {
        loading!.style.display = 'flex';
        errorContainer!.style.display = 'none';
        noPractices!.style.display = 'none';
        practicesGrid!.style.display = 'none';

        const response = await fetch('/.netlify/functions/practice-list', {
          credentials: 'same-origin',
        });

        if (!response.ok) {
          const data = await response.json();
          console.error('API error:', data);
          throw new Error(data.error || 'Failed to load practices');
        }

        practices = await response.json();

        loading!.style.display = 'none';

        if (practices.length === 0) {
          noPractices!.style.display = 'flex';
        } else {
          practicesGrid!.style.display = 'grid';
          renderPractices();
        }
      } catch (error) {
        console.error('Error loading practices:', error);
        loading!.style.display = 'none';
        errorContainer!.style.display = 'block';
        errorText!.textContent = error instanceof Error ? error.message : 'Unknown error';
      }
    }

    function renderPractices() {
      const practicesGrid = document.getElementById('practices-grid');
      if (!practicesGrid) return;

      practicesGrid.innerHTML = '';

      // The slots of one Wednesday share a single card
      const renderedGroups = new Set<string>();
      practices.forEach((practice) => {
        if (practice.slotGroup) {
          if (renderedGroups.has(practice.slotGroup)) return;
          renderedGroups.add(practice.slotGroup);
          const slots = practices
            .filter((p) => p.slotGroup === practice.slotGroup)
            .sort((a, b) => (a.slotNumber || 0) - (b.slotNumber || 0));
          practicesGrid.appendChild(renderSlotCard(slots));
          return;
        }

        const card = document.createElement('div');
        card.className = 'practice-card';
        card.id = `practice-${practice.id}`;

        const typeIcon = _svg(practice.type === 'net' ? IC.bat : IC.rings, 22);
        const typeName = practice.type === 'net' ? 'Net Session' : 'Field Practice';
        const slotBadge = practice.slotNumber ? `<span class="practice-type-badge badge-slot">Slot ${practice.slotNumber}</span>` : '';
        const typeBadgeClass = practice.type === 'net' ? 'badge-net' : 'badge-field';

        // Format date using utility function
        const formattedDate = formatDateDisplay(practice.date);

        // Build availability buttons HTML based on practice type
        const isLocked = practice.locked || false;
        const disabledAttr = isLocked ? 'disabled' : '';

        // Wednesday slots: capped batting places (Yes + guests), one slot per member
        const myPlaces = practice.myResponse === 'yes' ? 1 + (practice.myExtraPlayers || 0)
          : practice.myResponse === 'bowling-only' ? (practice.myExtraPlayers || 0) : 0;
        const capacity = practice.capacity || 0;
        const placesLeftForMe = capacity ? capacity - (practice.battingCount - myPlaces) : Infinity;
        const isFull = capacity > 0 && practice.battingCount >= capacity;
        const inOtherSlot = practice.inOtherSlot || null;
        // Yes needs a place unless already Yes; switching to Yes keeps any guests
        const yesBlocked = !!inOtherSlot || (practice.myResponse !== 'yes' && placesLeftForMe < 1 + (practice.myExtraPlayers || 0));
        const bowlingBlocked = !!inOtherSlot;
        const yesDisabled = isLocked || yesBlocked ? 'disabled' : '';
        const bowlingDisabled = isLocked || bowlingBlocked ? 'disabled' : '';

        let buttonsHTML = '';
        if (practice.type === 'net') {
          // Net sessions: Yes, Bowling Only, Not Available
          const yesClass = practice.myResponse === 'yes' ? 'active-yes' : '';
          const bowlingClass = practice.myResponse === 'bowling-only' ? 'active-bowling' : '';
          const noClass = practice.myResponse === 'not-available' ? 'active-no' : '';

          buttonsHTML = `
            <button class="availability-btn ${yesClass}" onclick="updateAvailability('${practice.id}', 'yes')" ${yesDisabled}>
              ${_svg(IC.check, 15)} Yes
            </button>
            <button class="availability-btn ${bowlingClass}" onclick="updateAvailability('${practice.id}', 'bowling-only')" ${bowlingDisabled}>
              Bowling Only
            </button>
            <button class="availability-btn ${noClass}" onclick="updateAvailability('${practice.id}', 'not-available')" ${disabledAttr}>
              ${_svg(IC.x, 15)} Not Available
            </button>
          `;
        } else {
          // Field practices: Yes, Not Available
          const yesClass = practice.myResponse === 'yes' ? 'active-yes' : '';
          const noClass = practice.myResponse === 'not-available' ? 'active-no' : '';

          buttonsHTML = `
            <button class="availability-btn ${yesClass}" onclick="updateAvailability('${practice.id}', 'yes')" ${disabledAttr}>
              ${_svg(IC.check, 15)} Yes
            </button>
            <button class="availability-btn ${noClass}" onclick="updateAvailability('${practice.id}', 'not-available')" ${disabledAttr}>
              ${_svg(IC.x, 15)} Not Available
            </button>
          `;
        }

        // Add lock message if practice is locked
        const lockMessageHTML = isLocked ? `
          <div class="lock-message">
            ${_svg(IC.lock, 15)} This practice session is locked by admin. Please reach out to admin to check if availability change is allowed.
          </div>
        ` : '';

        const capacityHTML = capacity ? `
          <div class="slot-capacity ${isFull ? 'is-full' : ''}">
            <div class="slot-capacity-bar"><div class="slot-capacity-fill" style="width: ${Math.min(100, Math.round((practice.battingCount / capacity) * 100))}%"></div></div>
            <span class="slot-capacity-text">${isFull ? 'Full · ' : ''}${practice.battingCount}/${capacity} batting</span>
          </div>
        ` : '';

        let slotNoteHTML = '';
        if (inOtherSlot) {
          slotNoteHTML = `<div class="slot-note">You're in Slot ${inOtherSlot} this Wednesday. To switch, withdraw from Slot ${inOtherSlot} first.</div>`;
        } else if (isFull && practice.myResponse !== 'yes') {
          slotNoteHTML = `<div class="slot-note is-full">This slot is full for batting. You can still join as Bowling only, or pick the other slot.</div>`;
        }

        // Build team status HTML based on practice type
        let teamStatusHTML = '';
        if (practice.type === 'net') {
          // In a slot, show batting places (Yes + all guests), matching the bar above
          teamStatusHTML = `
            <span class="status-count">
              <span class="status-count-value">${capacity ? practice.battingCount : practice.availabilityCounts.totalExpected}</span> ${capacity ? 'batting' : 'yes'}
            </span>
            <span class="status-count">
              <span class="status-count-value">${practice.availabilityCounts.bowlingOnly}</span> bowling only
            </span>
            <span class="status-count">
              <span class="status-count-value">${practice.availabilityCounts.notAvailable}</span> not available
            </span>
          `;
        } else {
          teamStatusHTML = `
            <span class="status-count">
              <span class="status-count-value">${practice.availabilityCounts.totalExpected}</span> yes
            </span>
            <span class="status-count">
              <span class="status-count-value">${practice.availabilityCounts.notAvailable}</span> not available
            </span>
          `;
        }

        card.innerHTML = `
          <div class="practice-header">
            <div class="practice-type-icon">${typeIcon}</div>
            <div class="practice-info">
              <h3 class="practice-title">${practiceHeading(practice.title)}</h3>
              <span class="practice-type-badge ${typeBadgeClass}">${typeName}</span>${slotBadge}
            </div>
          </div>

          <div class="practice-details">
            <div class="practice-detail">
              ${_svg(IC.calendar)} ${formattedDate}
            </div>
            <div class="practice-detail">
              ${_svg(IC.clock)} ${practice.time}
            </div>
            <div class="practice-detail">
              ${_svg(IC.pin)} ${practice.location}
            </div>
          </div>

          ${practice.description ? `<p style="color: #4b5563; margin-bottom: 1.25rem;">${practice.description}</p>` : ''}

          ${capacityHTML}
          ${slotNoteHTML}

          <div class="availability-section">
            <label class="availability-label">My Availability:</label>
            <div class="availability-buttons" id="buttons-${practice.id}">
              ${buttonsHTML}
            </div>
          </div>

          <div class="extra-players-section" id="extra-${practice.id}">
            <label class="extra-players-label" for="extra-players-${practice.id}">
              Bringing friends/guests?
            </label>
            <select
              id="extra-players-${practice.id}"
              class="extra-players-select"
              onchange="updateExtraPlayers('${practice.id}')"
              ${disabledAttr}
            >
              <option value="0">No extras</option>
              <option value="1">+1 person</option>
              <option value="2">+2 people</option>
              <option value="3">+3 people</option>
              <option value="4">+4 people</option>
              <option value="5">+5 or more</option>
            </select>
            <small class="extra-players-hint">Unregistered players joining practice</small>
          </div>

          ${lockMessageHTML}

          <div class="team-status">
            <div class="team-status-title">Team Status:</div>
            <div class="team-status-counts">
              ${teamStatusHTML}
            </div>
          </div>

          <!-- View Available Players Section -->
          <div class="available-players-section">
            <button
              class="available-players-toggle"
              onclick="toggleAvailablePlayers('${practice.id}')"
              id="toggle-${practice.id}"
            >
              <span class="toggle-text">View Available Players</span>
              <span class="toggle-icon">▼</span>
            </button>
            <div class="available-players-list" id="players-${practice.id}" style="display: none;">
              <div class="players-loading">Loading...</div>
            </div>
          </div>
        `;

        practicesGrid.appendChild(card);

        // Set the selected value for extraPlayers dropdown
        const extraPlayersSelect = document.getElementById(`extra-players-${practice.id}`) as HTMLSelectElement;
        if (extraPlayersSelect && practice.myExtraPlayers !== undefined) {
          const value = Math.min(practice.myExtraPlayers, 5).toString(); // Cap at 5 for dropdown
          extraPlayersSelect.value = value;
        }
        // In a slot, offer only as many guests as there are places left
        if (extraPlayersSelect && capacity) {
          const ownPlace = practice.myResponse === 'yes' ? 1 : 0;
          const maxGuests = placesLeftForMe - ownPlace;
          extraPlayersSelect.querySelectorAll('option').forEach((opt) => {
            const n = parseInt(opt.value);
            opt.disabled = n > 0 && n > maxGuests && n !== (practice.myExtraPlayers || 0);
          });
          if (inOtherSlot) extraPlayersSelect.disabled = true;
        }
      });
    }

    // ---- Wednesday slots: one card, pick a slot, then answer ----
    const slotSelection: Record<string, string> = {};
    const isIn = (p: any) => p.myResponse === 'yes' || p.myResponse === 'bowling-only';
    const mySlot = (slots: any[]) => slots.find(isIn) || null;
    // Batting places left for this member in a slot (their own places count as free)
    const placesLeftFor = (p: any) => {
      const mine = p.myResponse === 'yes' ? 1 + (p.myExtraPlayers || 0) : p.myResponse === 'bowling-only' ? (p.myExtraPlayers || 0) : 0;
      return (p.capacity || 0) - (p.battingCount - mine);
    };
    const slotsOf = (key: string) => practices
      .filter((p) => p.slotGroup === key)
      .sort((a, b) => (a.slotNumber || 0) - (b.slotNumber || 0));
    const selectedSlot = (key: string, slots: any[]) =>
      slots.find((p) => p.id === slotSelection[key])
      || mySlot(slots)
      || slots.find((p) => p.battingCount < p.capacity)
      || slots[0];

    function renderSlotCard(slots: any[]): HTMLElement {
      const key = slots[0].slotGroup;
      const mine = mySlot(slots);
      const sel = selectedSlot(key, slots);
      slotSelection[key] = sel.id;
      const first = slots[0];
      const moving = !!mine && mine.id !== sel.id;
      const eveningOff = !mine && slots.some((p) => p.myResponse === 'not-available');
      const anyLocked = slots.some((p) => p.locked);
      const guestSlot = mine || sel;
      const guests = guestSlot.myExtraPlayers || 0;
      const selLeft = placesLeftFor(sel);
      const selIsMine = !!mine && mine.id === sel.id;
      const cantLeave = moving && mine.locked;

      const yesOn = selIsMine && sel.myResponse === 'yes';
      const bowlOn = selIsMine && sel.myResponse === 'bowling-only';
      const yesBlocked = sel.locked || cantLeave || (!yesOn && selLeft < 1 + guests);
      const bowlBlocked = sel.locked || cantLeave || (!bowlOn && !selIsMine && selLeft < guests);

      const card = document.createElement('div');
      card.className = 'practice-card';
      card.id = `practice-${key}`;

      const optionsHTML = slots.map((p) => {
        const full = p.battingCount >= p.capacity;
        const pct = Math.min(100, Math.round((p.battingCount / p.capacity) * 100));
        return `
          <label class="slot-option ${p.id === sel.id ? 'is-selected' : ''} ${full ? 'is-full' : ''}">
            <input type="radio" name="slot-${key}" value="${p.id}" ${p.id === sel.id ? 'checked' : ''} onchange="selectSlot('${key}', '${p.id}')" />
            <span class="slot-option-main">
              <span class="slot-option-name">Slot ${p.slotNumber}${mine && mine.id === p.id ? ' <span class="slot-option-you">You\'re in</span>' : ''}${p.locked ? ` ${_svg(IC.lock, 13)}` : ''}</span>
              <span class="slot-option-time">${p.time}</span>
            </span>
            <span class="slot-option-count">
              <span class="slot-capacity-bar"><span class="slot-capacity-fill" style="width: ${pct}%"></span></span>
              <span class="slot-option-text">${full ? 'Full · ' : ''}${p.battingCount}/${p.capacity}</span>
            </span>
          </label>`;
      }).join('');

      let noteHTML = '';
      if (sel.locked) {
        noteHTML = `<div class="lock-message">${_svg(IC.lock, 15)} Slot ${sel.slotNumber} is locked by admin. Please reach out to admin if you need a change.</div>`;
      } else if (cantLeave) {
        noteHTML = `<div class="lock-message">${_svg(IC.lock, 15)} You're in Slot ${mine.slotNumber}, which is locked by admin, so you can't move out of it.</div>`;
      } else if (moving) {
        noteHTML = `<div class="slot-note">You're in Slot ${mine.slotNumber}. Pressing Yes or Bowling only moves you to Slot ${sel.slotNumber}.</div>`;
      } else if (sel.battingCount >= sel.capacity && !yesOn) {
        noteHTML = `<div class="slot-note is-full">Slot ${sel.slotNumber} is full for batting. You can still join as Bowling only, or pick the other slot.</div>`;
      }

      // Guests count in the member's slot (or the one picked), up to the places left
      const maxGuests = placesLeftFor(guestSlot) - (guestSlot.myResponse === 'yes' ? 1 : 0);
      const guestOptions = [['0', 'No extras'], ['1', '+1 person'], ['2', '+2 people'], ['3', '+3 people'], ['4', '+4 people'], ['5', '+5 or more']]
        .map(([v, label]) => {
          const n = parseInt(v);
          const disabled = n > 0 && n > maxGuests && n !== guests;
          return `<option value="${v}" ${Math.min(guests, 5) === n ? 'selected' : ''} ${disabled ? 'disabled' : ''}>${label}</option>`;
        }).join('');

      card.innerHTML = `
        <div class="practice-header">
          <div class="practice-type-icon">${_svg(IC.bat, 22)}</div>
          <div class="practice-info">
            <h3 class="practice-title">${practiceHeading(first.title)}</h3>
            <span class="practice-type-badge badge-net">Net Session</span><span class="practice-type-badge badge-slot">${slots.length} slots</span>
          </div>
        </div>

        <div class="practice-details">
          <div class="practice-detail">${_svg(IC.calendar)} ${formatDateDisplay(first.date)}</div>
          <div class="practice-detail">${_svg(IC.pin)} ${first.location}</div>
        </div>

        ${first.description ? `<p style="color: #4b5563; margin-bottom: 1.25rem;">${first.description}</p>` : ''}

        <div class="slot-picker" role="radiogroup" aria-label="Pick your slot">
          <div class="availability-label">Pick your slot:</div>
          ${optionsHTML}
        </div>

        ${noteHTML}

        <div class="availability-section">
          <label class="availability-label">My Availability:</label>
          <div class="availability-buttons" id="buttons-${key}">
            <button class="availability-btn ${yesOn ? 'active-yes' : ''}" onclick="slotVote('${key}', 'yes')" ${yesBlocked ? 'disabled' : ''}>
              ${_svg(IC.check, 15)} Yes
            </button>
            <button class="availability-btn ${bowlOn ? 'active-bowling' : ''}" onclick="slotVote('${key}', 'bowling-only')" ${bowlBlocked ? 'disabled' : ''}>
              Bowling Only
            </button>
            <button class="availability-btn ${eveningOff ? 'active-no' : ''}" onclick="slotVote('${key}', 'not-available')" ${anyLocked ? 'disabled' : ''}>
              ${_svg(IC.x, 15)} Not Available
            </button>
          </div>
        </div>

        <div class="extra-players-section">
          <label class="extra-players-label" for="extra-players-${key}">Bringing friends/guests?</label>
          <select id="extra-players-${key}" class="extra-players-select" onchange="slotGuests('${key}')" ${guestSlot.locked ? 'disabled' : ''}>
            ${guestOptions}
          </select>
          <small class="extra-players-hint">Unregistered players joining practice${mine ? ` (Slot ${mine.slotNumber})` : ''}</small>
        </div>

        <div class="team-status">
          <div class="team-status-title">Team Status:</div>
          ${slots.map((p) => `
            <div class="team-status-counts slot-status-line">
              <span class="slot-status-name">Slot ${p.slotNumber}</span>
              <span class="status-count"><span class="status-count-value">${p.battingCount}</span> batting</span>
              <span class="status-count"><span class="status-count-value">${p.availabilityCounts.bowlingOnly}</span> bowling only</span>
            </div>`).join('')}
          <div class="team-status-counts slot-status-line">
            <span class="status-count"><span class="status-count-value">${first.eveningNotAvailable ?? 0}</span> not available</span>
          </div>
        </div>

        <div class="available-players-section">
          <button class="available-players-toggle" onclick="toggleSlotPlayers('${key}')" id="toggle-${key}">
            <span class="toggle-text">View Available Players</span>
            <span class="toggle-icon">▼</span>
          </button>
          <div class="available-players-list" id="players-${key}" style="display: none;">
            <div class="players-loading">Loading...</div>
          </div>
        </div>
      `;
      return card;
    }

    function selectSlot(key: string, practiceId: string) {
      slotSelection[key] = practiceId;
      renderPractices();
    }

    async function postVote(body: Record<string, unknown>) {
      const res = await fetch('/.netlify/functions/practice-availability-update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Failed to update availability');
      }
    }

    async function runSlotUpdate(key: string, body: Record<string, unknown>) {
      if (updatingPracticeId) return;
      updatingPracticeId = key;
      document.querySelectorAll(`#practice-${key} button, #practice-${key} select, #practice-${key} input`)
        .forEach((el) => { (el as HTMLButtonElement).disabled = true; });
      try {
        await postVote(body);
        await loadPractices();
      } catch (error) {
        alert(error instanceof Error ? error.message : 'Failed to update availability');
        renderPractices();
      } finally {
        updatingPracticeId = null;
      }
    }

    function slotVote(key: string, response: string) {
      const slots = slotsOf(key);
      const mine = mySlot(slots);
      const sel = selectedSlot(key, slots);
      const select = document.getElementById(`extra-players-${key}`) as HTMLSelectElement | null;
      const extraPlayers = select ? parseInt(select.value) : 0;

      if (response === 'not-available') {
        // Not available is for the whole evening; pressing it again clears it
        const isOff = !mine && slots.some((p) => p.myResponse === 'not-available');
        return runSlotUpdate(key, { practiceId: sel.id, response: isOff ? null : 'not-available', wholeEvening: true });
      }
      if (mine && mine.id === sel.id && mine.myResponse === response) {
        return runSlotUpdate(key, { practiceId: sel.id, response: null, extraPlayers });
      }
      return runSlotUpdate(key, { practiceId: sel.id, response, extraPlayers, switchSlot: !!mine && mine.id !== sel.id });
    }

    function slotGuests(key: string) {
      const slots = slotsOf(key);
      const target = mySlot(slots) || selectedSlot(key, slots);
      const select = document.getElementById(`extra-players-${key}`) as HTMLSelectElement;
      return runSlotUpdate(key, { practiceId: target.id, response: target.myResponse || null, extraPlayers: parseInt(select.value) });
    }

    async function toggleSlotPlayers(key: string) {
      const toggleBtn = document.getElementById(`toggle-${key}`);
      const list = document.getElementById(`players-${key}`);
      if (!toggleBtn || !list) return;
      if (list.style.display !== 'none') {
        list.style.display = 'none';
        toggleBtn.classList.remove('expanded');
        return;
      }
      list.style.display = 'block';
      toggleBtn.classList.add('expanded');
      list.innerHTML = '<div class="players-loading">Loading players...</div>';
      try {
        const slots = slotsOf(key);
        const lists = await Promise.all(slots.map(async (p) => {
          const res = await fetch(`/.netlify/functions/practice-available-players-get?practiceId=${p.id}`, { credentials: 'same-origin' });
          if (!res.ok) throw new Error('Failed to load available players');
          return res.json();
        }));
        list.innerHTML = slots.map((p, i) => {
          const data = lists[i];
          // Guests bat too, so show them next to the count (matches the batting places above)
          const guestsOf = (players: any[]) => {
            const n = players.reduce((sum, pl) => sum + (pl.extraPlayers || 0), 0);
            return n ? ` + ${n} guest${n === 1 ? '' : 's'}` : '';
          };
          const names = (players: any[], cls: string) => players.map((pl) => playerBadge(pl, cls, pl.extraPlayers > 0 ? ` +${pl.extraPlayers}` : '')).join('');
          const body = data.totalYes === 0 && data.totalBowlingOnly === 0
            ? '<div class="no-players-message">No one yet</div>'
            : `${data.totalYes > 0 ? `<div class="players-section"><div class="players-section-title available">${_svg(IC.check, 14)} Batting (${data.totalYes}${guestsOf(data.yesPlayers)})</div><div class="player-names-list">${names(data.yesPlayers, 'available')}</div></div>` : ''}
               ${data.totalBowlingOnly > 0 ? `<div class="players-section"><div class="players-section-title bowling-only">${_svg(IC.activity, 14)} Bowling Only (${data.totalBowlingOnly}${guestsOf(data.bowlingOnlyPlayers)})</div><div class="player-names-list">${names(data.bowlingOnlyPlayers, 'bowling-only')}</div></div>` : ''}`;
          return `<div class="slot-players"><div class="slot-players-title">Slot ${p.slotNumber} · ${p.time}</div>${body}</div>`;
        }).join('');
      } catch (error) {
        list.innerHTML = '<div class="no-players-message">Failed to load players. Please try again.</div>';
      }
    }

    async function updateAvailability(practiceId: string, response: string) {
      // Prevent multiple simultaneous updates
      if (updatingPracticeId) {
        return;
      }

      updatingPracticeId = practiceId;

      // Find the practice
      const practice = practices.find(p => p.id === practiceId);
      if (!practice) return;

      // If user clicks the same button, remove their response (set to null)
      const newResponse = practice.myResponse === response ? null : response;

      // Disable all buttons for this practice
      const buttonsContainer = document.getElementById(`buttons-${practiceId}`);
      if (!buttonsContainer) return;

      const buttons = buttonsContainer.querySelectorAll('button');

      // Store original HTML for each button
      const originalHTML = new Map();
      buttons.forEach((btn, index) => {
        originalHTML.set(index, btn.innerHTML);
        btn.disabled = true;
      });

      // Only show spinner on the clicked button
      buttons.forEach((btn, index) => {
        const btnResponse = btn.getAttribute('onclick')?.match(/'([^']+)'\)$/)?.[1];
        if (btnResponse === response) {
          btn.innerHTML = '<span class="btn-spinner"></span>';
        }
      });

      try {
        // Get current extraPlayers value from dropdown
        const extraPlayersSelect = document.getElementById(`extra-players-${practiceId}`) as HTMLSelectElement;
        const extraPlayers = extraPlayersSelect ? parseInt(extraPlayersSelect.value) : 0;

        const apiResponse = await fetch('/.netlify/functions/practice-availability-update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            practiceId,
            response: newResponse,
            extraPlayers,
          }),
        });

        if (!apiResponse.ok) {
          const errorData = await apiResponse.json();
          throw new Error(errorData.error || 'Failed to update availability');
        }

        const result = await apiResponse.json();

        // Reload practices to get updated counts
        await loadPractices();

      } catch (error) {
        console.error('Error updating availability:', error);
        alert(error instanceof Error ? error.message : 'Failed to update availability');

        // Re-enable buttons on error
        buttons.forEach(btn => {
          btn.disabled = false;
        });
        renderPractices();
      } finally {
        updatingPracticeId = null;
      }
    }

    async function updateExtraPlayers(practiceId: string) {
      // Prevent multiple simultaneous updates
      if (updatingPracticeId) {
        return;
      }

      updatingPracticeId = practiceId;

      try {
        // Get the practice and current values
        const practice = practices.find(p => p.id === practiceId);
        if (!practice) return;

        const extraPlayersSelect = document.getElementById(`extra-players-${practiceId}`) as HTMLSelectElement;
        if (!extraPlayersSelect) return;

        const extraPlayers = parseInt(extraPlayersSelect.value);

        const apiResponse = await fetch('/.netlify/functions/practice-availability-update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            practiceId,
            response: practice.myResponse || null,
            extraPlayers,
          }),
        });

        if (!apiResponse.ok) {
          const errorData = await apiResponse.json();
          throw new Error(errorData.error || 'Failed to update extra players');
        }

        const result = await apiResponse.json();

        // Update local data
        practice.myExtraPlayers = extraPlayers;

        // Reload practices to get updated counts
        await loadPractices();

      } catch (error) {
        console.error('Error updating extra players:', error);
        alert(error instanceof Error ? error.message : 'Failed to update extra players');
        renderPractices();
      } finally {
        updatingPracticeId = null;
      }
    }

    // Track which practices have loaded players
    const loadedPlayers = new Set<string>();

    // Player names link to their profile; names are user-entered, so escape them
    const escapeHtml = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
    const playerBadge = (p: { id?: string; name: string }, cls: string, suffix = '') => p.id
      ? `<a href="/players/${encodeURIComponent(p.id)}" class="player-name-badge ${cls}">${escapeHtml(p.name)}${suffix}</a>`
      : `<span class="player-name-badge ${cls}">${escapeHtml(p.name)}${suffix}</span>`;

    async function toggleAvailablePlayers(practiceId: string) {
      const toggleBtn = document.getElementById(`toggle-${practiceId}`);
      const playersList = document.getElementById(`players-${practiceId}`);

      if (!toggleBtn || !playersList) return;

      // Toggle display
      const isExpanded = playersList.style.display !== 'none';

      if (isExpanded) {
        // Collapse
        playersList.style.display = 'none';
        toggleBtn.classList.remove('expanded');
      } else {
        // Expand
        playersList.style.display = 'block';
        toggleBtn.classList.add('expanded');

        // Fetch players if not already loaded
        if (!loadedPlayers.has(practiceId)) {
          await fetchAvailablePlayers(practiceId);
          loadedPlayers.add(practiceId);
        }
      }
    }

    async function fetchAvailablePlayers(practiceId: string) {
      const playersList = document.getElementById(`players-${practiceId}`);
      if (!playersList) return;

      try {
        playersList.innerHTML = '<div class="players-loading">Loading players...</div>';

        const response = await fetch(`/.netlify/functions/practice-available-players-get?practiceId=${practiceId}`, {
          credentials: 'same-origin',
        });

        if (!response.ok) {
          throw new Error('Failed to load available players');
        }

        const data = await response.json();

        // Build HTML for players list
        let html = '';

        if (data.totalYes === 0 && data.totalBowlingOnly === 0) {
          html = '<div class="no-players-message">No players have marked their availability yet</div>';
        } else {
          // Show "Yes" players
          if (data.totalYes > 0) {
            html += `
              <div class="players-section">
                <div class="players-section-title available">${_svg(IC.check, 14)} Available Players (${data.totalYes})</div>
                <div class="player-names-list">
                  ${data.yesPlayers.map(p => `
                    ${playerBadge(p, 'available', p.extraPlayers > 0 ? ` +${p.extraPlayers}` : '')}
                  `).join('')}
                </div>
              </div>
            `;
          }

          // Show "Bowling Only" players (only for net practices)
          if (data.practiceType === 'net' && data.totalBowlingOnly > 0) {
            html += `
              <div class="players-section">
                <div class="players-section-title bowling-only">${_svg(IC.activity, 14)} Bowling Only (${data.totalBowlingOnly})</div>
                <div class="player-names-list">
                  ${data.bowlingOnlyPlayers.map(p => `
                    ${playerBadge(p, 'bowling-only', p.extraPlayers > 0 ? ` +${p.extraPlayers}` : '')}
                  `).join('')}
                </div>
              </div>
            `;
          }
        }

        playersList.innerHTML = html;
      } catch (error) {
        console.error('Error fetching available players:', error);
        playersList.innerHTML = '<div class="no-players-message">Failed to load players. Please try again.</div>';
      }
    }

    // Load practices on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadPractices();
    });

    // Expose functions globally
    (window as any).updateAvailability = updateAvailability;
    (window as any).updateExtraPlayers = updateExtraPlayers;
    (window as any).toggleAvailablePlayers = toggleAvailablePlayers;
    (window as any).selectSlot = selectSlot;
    (window as any).slotVote = slotVote;
    (window as any).slotGuests = slotGuests;
    (window as any).toggleSlotPlayers = toggleSlotPlayers;
  </script>
</Layout>
