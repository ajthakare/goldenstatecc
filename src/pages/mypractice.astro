---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { validateAdminSession, isMember } from '../middleware/auth';
import { parseLocalDate, formatDateDisplay } from '../utils';
import '../styles/admin.css';

// Check authentication
const cookieHeader = Astro.request.headers.get('cookie');
const session = validateAdminSession(cookieHeader || '');

// Redirect to login if not authenticated
if (!session || !isMember(session)) {
  return Astro.redirect('/login');
}
---

<Layout title="Practice Sessions - Golden State Cricket Club">
  <PageHeader kicker="Your season" title="Practice Sessions" subtitle="Next 30 days — mark your availability for upcoming practices" />

  <div class="max-w-5xl mx-auto px-4 py-8" style="overflow: visible; min-height: auto;">

    <!-- Emergency Contact Warning -->
    <div id="emergency-contact-warning" class="hidden mb-6 p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded-lg">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-yellow-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <div class="flex-1">
          <h3 class="font-semibold text-yellow-800 mb-1">Emergency Contact Information Missing</h3>
          <p class="text-sm text-yellow-700 mb-2">
            Please add your emergency contact information to your profile. This is required for safety purposes.
          </p>
          <a href="/profile" class="inline-block text-sm font-medium text-yellow-800 hover:text-yellow-900 underline">
            Update Profile →
          </a>
        </div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="state-container">
      <div class="spinner"></div>
      <p class="state-text">Loading practices...</p>
    </div>

    <!-- Error State -->
    <div id="error-container" class="alert alert-error" style="display: none;">
      <p id="error-text"></p>
    </div>

    <!-- No Practices State -->
    <div id="no-practices" class="state-container" style="display: none;">
      <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="empty-text">No upcoming practice sessions in the next 30 days</p>
      <p class="empty-subtext">Check back later for new practice sessions</p>
    </div>

    <!-- Practices Grid -->
    <div id="practices-grid" class="practices-grid" style="display: none;">
      <!-- Practices will be inserted here -->
    </div>
  </div>

  <!-- All practice styles are now in /src/styles/admin.css -->
  <style is:global>
    /* Fix oversized empty state icon */
    #no-practices .empty-icon {
      width: 64px;
      height: 64px;
      color: #d1d5db;
      margin-bottom: 16px;
    }

    .state-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 64px 24px;
      text-align: center;
    }

    .empty-text {
      font-size: 18px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 8px;
    }

    .empty-subtext {
      font-size: 14px;
      color: #6b7280;
    }

    /* Extra Players Section Styling */
    .extra-players-section {
      margin-top: 1rem;
      margin-bottom: 1rem;
      padding: 1rem;
      background-color: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }

    .extra-players-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 500;
      color: #374151;
      margin-bottom: 0.5rem;
    }

    .extra-players-select {
      width: 100%;
      max-width: 300px;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      background-color: white;
      color: #111827;
      cursor: pointer;
      transition: all 0.2s;
    }

    .extra-players-select:hover:not(:disabled) {
      border-color: #A82B24;
    }

    .extra-players-select:focus {
      outline: none;
      border-color: #A82B24;
      box-shadow: 0 0 0 3px rgba(168, 43, 36, 0.12);
    }

    .extra-players-select:disabled {
      background-color: #f3f4f6;
      cursor: not-allowed;
      opacity: 0.6;
    }

    .extra-players-hint {
      display: block;
      font-size: 0.75rem;
      color: #6b7280;
      margin-top: 0.5rem;
      font-style: italic;
    }

    /* Available Players Section */
    .available-players-section {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid #e5e7eb;
    }

    .available-players-toggle {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      color: #374151;
      cursor: pointer;
      transition: all 0.2s;
    }

    .available-players-toggle:hover {
      background: #f3f4f6;
      border-color: #d1d5db;
    }

    .toggle-icon {
      transition: transform 0.2s;
      color: #6b7280;
    }

    .available-players-toggle.expanded .toggle-icon {
      transform: rotate(180deg);
    }

    .available-players-list {
      margin-top: 0.75rem;
      padding: 1rem;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }

    .players-loading {
      text-align: center;
      color: #6b7280;
      font-size: 0.875rem;
      padding: 1rem;
    }

    .players-section {
      margin-bottom: 1rem;
    }

    .players-section:last-child {
      margin-bottom: 0;
    }

    .players-section-title {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      color: #6b7280;
      margin-bottom: 0.5rem;
      letter-spacing: 0.05em;
    }

    .players-section-title.available {
      color: #1B6B3A;
    }

    .players-section-title.bowling-only {
      color: #8A6A15;
    }

    .player-names-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .player-name-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.375rem 0.75rem;
      background: white;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 0.875rem;
      color: #111827;
    }

    .player-name-badge.available {
      background: #EAF6EE;
      border-color: #9BC9AC;
      color: #1B6B3A;
    }

    .player-name-badge.bowling-only {
      background: #F7EFD8;
      border-color: #DFC77E;
      color: #8A6A15;
    }

    .no-players-message {
      text-align: center;
      color: #9ca3af;
      font-size: 0.875rem;
      font-style: italic;
      padding: 1rem;
    }

    /* Mobile-specific fixes to ensure all content is visible */
    @media (max-width: 768px) {
      html,
      body,
      main {
        overflow-y: auto !important;
        overflow-x: hidden !important;
        height: auto !important;
        min-height: 100vh;
      }

      #practices-grid,
      .practices-grid,
      .practice-card {
        overflow: visible !important;
        height: auto !important;
        min-height: 0 !important;
      }

      .max-w-5xl {
        overflow: visible !important;
        height: auto !important;
      }

      /* Ensure cards have proper bottom spacing */
      .practice-card {
        margin-bottom: 3rem !important;
        padding-bottom: 2rem !important;
      }

      .availability-buttons {
        margin-bottom: 1rem !important;
      }
    }

    /* Icon treatment for client-rendered practice cards */
    .practice-type-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--color-maroon-100, #F6E7E4);
      color: var(--color-maroon-600, #8C1D18);
      font-size: 0 !important;
    }
    .practice-detail svg { color: var(--color-muted-text, #6B635C); }
    .lock-message svg { color: var(--color-gold-600, #A9821B); }
  </style>

  <script>
    // Inline icon helpers (client-rendered cards can't use the <Icon> component)
    const _svg = (paths, sz = 16) =>
      `<svg xmlns="http://www.w3.org/2000/svg" width="${sz}" height="${sz}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-0.18em;flex-shrink:0">${paths}</svg>`;
    const IC = {
      activity: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
      bat: '<g transform="rotate(-40 12 12)"><rect x="9" y="5" width="6" height="13" rx="3"/><line x1="12" y1="5" x2="12" y2="2.5"/></g><circle cx="17" cy="18" r="2.5"/>',
      rings: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>',
      calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
      clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
      pin: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
      check: '<path d="M20 6 9 17l-5-5"/>',
      x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
      lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
    };
    let practices: any[] = [];
    let updatingPracticeId: string | null = null;

    // Check for emergency contact info and show warning if missing
    async function checkEmergencyContact() {
      try {
        const response = await fetch('/.netlify/functions/auth-check');
        if (response.ok) {
          const result = await response.json();
          const user = result.user;

          if (!user.emergencyContactName || !user.emergencyContactNumber) {
            const warningEl = document.getElementById('emergency-contact-warning');
            if (warningEl) {
              warningEl.classList.remove('hidden');
            }
          }
        }
      } catch (error) {
        console.error('Error checking emergency contact:', error);
      }
    }

    // Call on page load
    checkEmergencyContact();

    // Utility functions for date and time
    function parseLocalDate(dateString: string): Date {
      const parts = dateString.split('-');
      return new Date(
        parseInt(parts[0]),
        parseInt(parts[1]) - 1,
        parseInt(parts[2])
      );
    }

    function formatDateDisplay(dateString: string): string {
      const date = parseLocalDate(dateString);
      return date.toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });
    }

    async function loadPractices() {
      const loading = document.getElementById('loading');
      const errorContainer = document.getElementById('error-container');
      const errorText = document.getElementById('error-text');
      const noPractices = document.getElementById('no-practices');
      const practicesGrid = document.getElementById('practices-grid');

      try {
        loading!.style.display = 'flex';
        errorContainer!.style.display = 'none';
        noPractices!.style.display = 'none';
        practicesGrid!.style.display = 'none';

        const response = await fetch('/.netlify/functions/practice-list', {
          credentials: 'same-origin',
        });

        if (!response.ok) {
          const data = await response.json();
          console.error('API error:', data);
          throw new Error(data.error || 'Failed to load practices');
        }

        practices = await response.json();

        loading!.style.display = 'none';

        if (practices.length === 0) {
          noPractices!.style.display = 'flex';
        } else {
          practicesGrid!.style.display = 'grid';
          renderPractices();
        }
      } catch (error) {
        console.error('Error loading practices:', error);
        loading!.style.display = 'none';
        errorContainer!.style.display = 'block';
        errorText!.textContent = error instanceof Error ? error.message : 'Unknown error';
      }
    }

    function renderPractices() {
      const practicesGrid = document.getElementById('practices-grid');
      if (!practicesGrid) return;

      practicesGrid.innerHTML = '';

      practices.forEach((practice) => {
        const card = document.createElement('div');
        card.className = 'practice-card';
        card.id = `practice-${practice.id}`;

        const typeIcon = _svg(practice.type === 'net' ? IC.bat : IC.rings, 22);
        const typeName = practice.type === 'net' ? 'Net Session' : 'Field Practice';
        const typeBadgeClass = practice.type === 'net' ? 'badge-net' : 'badge-field';

        // Format date using utility function
        const formattedDate = formatDateDisplay(practice.date);

        // Build availability buttons HTML based on practice type
        const isLocked = practice.locked || false;
        const disabledAttr = isLocked ? 'disabled' : '';

        let buttonsHTML = '';
        if (practice.type === 'net') {
          // Net sessions: Yes, Bowling Only, Not Available
          const yesClass = practice.myResponse === 'yes' ? 'active-yes' : '';
          const bowlingClass = practice.myResponse === 'bowling-only' ? 'active-bowling' : '';
          const noClass = practice.myResponse === 'not-available' ? 'active-no' : '';

          buttonsHTML = `
            <button class="availability-btn ${yesClass}" onclick="updateAvailability('${practice.id}', 'yes')" ${disabledAttr}>
              ${_svg(IC.check, 15)} Yes
            </button>
            <button class="availability-btn ${bowlingClass}" onclick="updateAvailability('${practice.id}', 'bowling-only')" ${disabledAttr}>
              Bowling Only
            </button>
            <button class="availability-btn ${noClass}" onclick="updateAvailability('${practice.id}', 'not-available')" ${disabledAttr}>
              ${_svg(IC.x, 15)} Not Available
            </button>
          `;
        } else {
          // Field practices: Yes, Not Available
          const yesClass = practice.myResponse === 'yes' ? 'active-yes' : '';
          const noClass = practice.myResponse === 'not-available' ? 'active-no' : '';

          buttonsHTML = `
            <button class="availability-btn ${yesClass}" onclick="updateAvailability('${practice.id}', 'yes')" ${disabledAttr}>
              ${_svg(IC.check, 15)} Yes
            </button>
            <button class="availability-btn ${noClass}" onclick="updateAvailability('${practice.id}', 'not-available')" ${disabledAttr}>
              ${_svg(IC.x, 15)} Not Available
            </button>
          `;
        }

        // Add lock message if practice is locked
        const lockMessageHTML = isLocked ? `
          <div class="lock-message">
            ${_svg(IC.lock, 15)} This practice session is locked by admin. Please reach out to admin to check if availability change is allowed.
          </div>
        ` : '';

        // Build team status HTML based on practice type
        let teamStatusHTML = '';
        if (practice.type === 'net') {
          teamStatusHTML = `
            <span class="status-count">
              <span class="status-count-value">${practice.availabilityCounts.totalExpected}</span> yes
            </span>
            <span class="status-count">
              <span class="status-count-value">${practice.availabilityCounts.bowlingOnly}</span> bowling only
            </span>
            <span class="status-count">
              <span class="status-count-value">${practice.availabilityCounts.notAvailable}</span> not available
            </span>
          `;
        } else {
          teamStatusHTML = `
            <span class="status-count">
              <span class="status-count-value">${practice.availabilityCounts.totalExpected}</span> yes
            </span>
            <span class="status-count">
              <span class="status-count-value">${practice.availabilityCounts.notAvailable}</span> not available
            </span>
          `;
        }

        card.innerHTML = `
          <div class="practice-header">
            <div class="practice-type-icon">${typeIcon}</div>
            <div class="practice-info">
              <h3 class="practice-title">${practice.title}</h3>
              <span class="practice-type-badge ${typeBadgeClass}">${typeName}</span>
            </div>
          </div>

          <div class="practice-details">
            <div class="practice-detail">
              ${_svg(IC.calendar)} ${formattedDate}
            </div>
            <div class="practice-detail">
              ${_svg(IC.clock)} ${practice.time}
            </div>
            <div class="practice-detail">
              ${_svg(IC.pin)} ${practice.location}
            </div>
          </div>

          ${practice.description ? `<p style="color: #4b5563; margin-bottom: 1.25rem;">${practice.description}</p>` : ''}

          <div class="availability-section">
            <label class="availability-label">My Availability:</label>
            <div class="availability-buttons" id="buttons-${practice.id}">
              ${buttonsHTML}
            </div>
          </div>

          <div class="extra-players-section" id="extra-${practice.id}">
            <label class="extra-players-label" for="extra-players-${practice.id}">
              Bringing friends/guests?
            </label>
            <select
              id="extra-players-${practice.id}"
              class="extra-players-select"
              onchange="updateExtraPlayers('${practice.id}')"
              ${disabledAttr}
            >
              <option value="0">No extras</option>
              <option value="1">+1 person</option>
              <option value="2">+2 people</option>
              <option value="3">+3 people</option>
              <option value="4">+4 people</option>
              <option value="5">+5 or more</option>
            </select>
            <small class="extra-players-hint">Unregistered players joining practice</small>
          </div>

          ${lockMessageHTML}

          <div class="team-status">
            <div class="team-status-title">Team Status:</div>
            <div class="team-status-counts">
              ${teamStatusHTML}
            </div>
          </div>

          <!-- View Available Players Section -->
          <div class="available-players-section">
            <button
              class="available-players-toggle"
              onclick="toggleAvailablePlayers('${practice.id}')"
              id="toggle-${practice.id}"
            >
              <span class="toggle-text">View Available Players</span>
              <span class="toggle-icon">▼</span>
            </button>
            <div class="available-players-list" id="players-${practice.id}" style="display: none;">
              <div class="players-loading">Loading...</div>
            </div>
          </div>
        `;

        practicesGrid.appendChild(card);

        // Set the selected value for extraPlayers dropdown
        const extraPlayersSelect = document.getElementById(`extra-players-${practice.id}`) as HTMLSelectElement;
        if (extraPlayersSelect && practice.myExtraPlayers !== undefined) {
          const value = Math.min(practice.myExtraPlayers, 5).toString(); // Cap at 5 for dropdown
          extraPlayersSelect.value = value;
        }
      });
    }

    async function updateAvailability(practiceId: string, response: string) {
      // Prevent multiple simultaneous updates
      if (updatingPracticeId) {
        return;
      }

      updatingPracticeId = practiceId;

      // Find the practice
      const practice = practices.find(p => p.id === practiceId);
      if (!practice) return;

      // If user clicks the same button, remove their response (set to null)
      const newResponse = practice.myResponse === response ? null : response;

      // Disable all buttons for this practice
      const buttonsContainer = document.getElementById(`buttons-${practiceId}`);
      if (!buttonsContainer) return;

      const buttons = buttonsContainer.querySelectorAll('button');

      // Store original HTML for each button
      const originalHTML = new Map();
      buttons.forEach((btn, index) => {
        originalHTML.set(index, btn.innerHTML);
        btn.disabled = true;
      });

      // Only show spinner on the clicked button
      buttons.forEach((btn, index) => {
        const btnResponse = btn.getAttribute('onclick')?.match(/'([^']+)'\)$/)?.[1];
        if (btnResponse === response) {
          btn.innerHTML = '<span class="btn-spinner"></span>';
        }
      });

      try {
        // Get current extraPlayers value from dropdown
        const extraPlayersSelect = document.getElementById(`extra-players-${practiceId}`) as HTMLSelectElement;
        const extraPlayers = extraPlayersSelect ? parseInt(extraPlayersSelect.value) : 0;

        const apiResponse = await fetch('/.netlify/functions/practice-availability-update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            practiceId,
            response: newResponse,
            extraPlayers,
          }),
        });

        if (!apiResponse.ok) {
          const errorData = await apiResponse.json();
          throw new Error(errorData.error || 'Failed to update availability');
        }

        const result = await apiResponse.json();

        // Reload practices to get updated counts
        await loadPractices();

      } catch (error) {
        console.error('Error updating availability:', error);
        alert(error instanceof Error ? error.message : 'Failed to update availability');

        // Re-enable buttons on error
        buttons.forEach(btn => {
          btn.disabled = false;
        });
        renderPractices();
      } finally {
        updatingPracticeId = null;
      }
    }

    async function updateExtraPlayers(practiceId: string) {
      // Prevent multiple simultaneous updates
      if (updatingPracticeId) {
        return;
      }

      updatingPracticeId = practiceId;

      try {
        // Get the practice and current values
        const practice = practices.find(p => p.id === practiceId);
        if (!practice) return;

        const extraPlayersSelect = document.getElementById(`extra-players-${practiceId}`) as HTMLSelectElement;
        if (!extraPlayersSelect) return;

        const extraPlayers = parseInt(extraPlayersSelect.value);

        const apiResponse = await fetch('/.netlify/functions/practice-availability-update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            practiceId,
            response: practice.myResponse || null,
            extraPlayers,
          }),
        });

        if (!apiResponse.ok) {
          const errorData = await apiResponse.json();
          throw new Error(errorData.error || 'Failed to update extra players');
        }

        const result = await apiResponse.json();

        // Update local data
        practice.myExtraPlayers = extraPlayers;

        // Reload practices to get updated counts
        await loadPractices();

      } catch (error) {
        console.error('Error updating extra players:', error);
        alert(error instanceof Error ? error.message : 'Failed to update extra players');
        renderPractices();
      } finally {
        updatingPracticeId = null;
      }
    }

    // Track which practices have loaded players
    const loadedPlayers = new Set<string>();

    async function toggleAvailablePlayers(practiceId: string) {
      const toggleBtn = document.getElementById(`toggle-${practiceId}`);
      const playersList = document.getElementById(`players-${practiceId}`);

      if (!toggleBtn || !playersList) return;

      // Toggle display
      const isExpanded = playersList.style.display !== 'none';

      if (isExpanded) {
        // Collapse
        playersList.style.display = 'none';
        toggleBtn.classList.remove('expanded');
      } else {
        // Expand
        playersList.style.display = 'block';
        toggleBtn.classList.add('expanded');

        // Fetch players if not already loaded
        if (!loadedPlayers.has(practiceId)) {
          await fetchAvailablePlayers(practiceId);
          loadedPlayers.add(practiceId);
        }
      }
    }

    async function fetchAvailablePlayers(practiceId: string) {
      const playersList = document.getElementById(`players-${practiceId}`);
      if (!playersList) return;

      try {
        playersList.innerHTML = '<div class="players-loading">Loading players...</div>';

        const response = await fetch(`/.netlify/functions/practice-available-players-get?practiceId=${practiceId}`, {
          credentials: 'same-origin',
        });

        if (!response.ok) {
          throw new Error('Failed to load available players');
        }

        const data = await response.json();

        // Build HTML for players list
        let html = '';

        if (data.totalYes === 0 && data.totalBowlingOnly === 0) {
          html = '<div class="no-players-message">No players have marked their availability yet</div>';
        } else {
          // Show "Yes" players
          if (data.totalYes > 0) {
            html += `
              <div class="players-section">
                <div class="players-section-title available">${_svg(IC.check, 14)} Available Players (${data.totalYes})</div>
                <div class="player-names-list">
                  ${data.yesPlayers.map(p => `
                    <span class="player-name-badge available">
                      ${p.name}${p.extraPlayers > 0 ? ` +${p.extraPlayers}` : ''}
                    </span>
                  `).join('')}
                </div>
              </div>
            `;
          }

          // Show "Bowling Only" players (only for net practices)
          if (data.practiceType === 'net' && data.totalBowlingOnly > 0) {
            html += `
              <div class="players-section">
                <div class="players-section-title bowling-only">${_svg(IC.activity, 14)} Bowling Only (${data.totalBowlingOnly})</div>
                <div class="player-names-list">
                  ${data.bowlingOnlyPlayers.map(p => `
                    <span class="player-name-badge bowling-only">
                      ${p.name}${p.extraPlayers > 0 ? ` +${p.extraPlayers}` : ''}
                    </span>
                  `).join('')}
                </div>
              </div>
            `;
          }
        }

        playersList.innerHTML = html;
      } catch (error) {
        console.error('Error fetching available players:', error);
        playersList.innerHTML = '<div class="no-players-message">Failed to load players. Please try again.</div>';
      }
    }

    // Load practices on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadPractices();
    });

    // Expose functions globally
    (window as any).updateAvailability = updateAvailability;
    (window as any).updateExtraPlayers = updateExtraPlayers;
    (window as any).toggleAvailablePlayers = toggleAvailablePlayers;
  </script>
</Layout>
