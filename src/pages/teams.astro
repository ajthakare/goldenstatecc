---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';

// Fetch active season
let activeSeason: any = null;
try {
    const res = await fetch(`${Astro.url.origin}/.netlify/functions/seasons-get-active`);
    if (res.ok) activeSeason = await res.json();
} catch (e) {}

const seasonTeams = activeSeason?.teams ?? [];

// Fetch this season's fixtures to derive each team's record + recent form
let seasonFixtures: any[] = [];
if (activeSeason?.id) {
    try {
        const res = await fetch(`${Astro.url.origin}/.netlify/functions/fixtures-list?seasonId=${activeSeason.id}`);
        if (res.ok) seasonFixtures = await res.json();
    } catch (e) {}
}

const RESULT_PILL: Record<string, { letter: string; label: string; cls: string }> = {
    win:       { letter: 'W', label: 'Won',       cls: 'form-w' },
    loss:      { letter: 'L', label: 'Lost',      cls: 'form-l' },
    tie:       { letter: 'T', label: 'Tied',      cls: 'form-t' },
    abandoned: { letter: 'A', label: 'Abandoned', cls: 'form-n' },
    forfeit:   { letter: 'F', label: 'Forfeit',   cls: 'form-n' },
};

function fmtShortDate(d: string) {
    const [y, m, day] = String(d).split('-').map(Number);
    if (!y || !m || !day) return d;
    return new Date(y, m - 1, day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

// fixtures-list returns fixtures sorted by date ascending
function getTeamRecord(teamName: string) {
    const played = seasonFixtures.filter(
        (f) => f.team === teamName && f.result && RESULT_PILL[f.result]
    );
    let win = 0, loss = 0, tie = 0, other = 0;
    for (const f of played) {
        if (f.result === 'win') win++;
        else if (f.result === 'loss') loss++;
        else if (f.result === 'tie') tie++;
        else other++;
    }
    const decided = win + loss + tie;
    const winRate = decided > 0 ? Math.round((win / decided) * 100) : 0;
    const form = played.slice(-5).map((f) => ({
        ...RESULT_PILL[f.result as string],
        tip: `${RESULT_PILL[f.result as string].label} vs ${f.opponent} · ${fmtShortDate(f.date)}`,
    }));
    return { total: played.length, win, loss, tie, other, decided, winRate, form };
}

function teamAccent(name: string) {
    if (name.includes('Tigers'))  return '#C9A227';
    if (name.includes('Bulls'))   return '#64748B';
    if (name.includes('Thunder')) return '#A82B24';
    if (name.includes('Bears'))   return '#4B7B54';
    return '#9CA3AF';
}

const playerDevelopment = [
    { icon: 'activity', title: 'Competitive League Exposure', content: 'Regular participation in NCCA leagues gives players consistent competitive cricket experience.' },
    { icon: 'crown', title: 'Leadership Opportunities', content: 'Members can take on captaincy, coaching, and organizational roles within the club.' },
    { icon: 'trophy', title: 'Regional & National Tournaments', content: 'Players compete in regional and national tournaments beyond local leagues.' },
    { icon: 'star', title: 'USA Minor & Masters Leagues', content: 'Our members have the opportunity to play in USA Minor and Masters League competitions.' }
];
---

<Layout title="Teams - Golden State Cricket Club">
    <PageHeader kicker="Squads" title="Our Teams" subtitle={activeSeason ? activeSeason.name : 'Current Season'} />

    <Section title="" align="left">
        {seasonTeams.length === 0 ? (
            <p class="text-center text-muted py-12">No active season found. Please set an active season in the admin panel.</p>
        ) : (
            <div class="grid sm:grid-cols-2 gap-6">
                {seasonTeams.map((team: any) => {
                    const accent = teamAccent(team.teamName);
                    const rec = getTeamRecord(team.teamName);
                    return (
                        <div class="team-card flex flex-col" style={`border-top:3px solid ${accent};`}>
                            <div class="px-5 pt-4 pb-3 flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <h3 class="text-lg font-bold text-heading leading-tight mb-1.5">{team.teamName}</h3>
                                    <span class="badge badge-neutral badge-tier">{team.division}</span>
                                </div>
                                {rec.form.length > 0 && (
                                    <div class="flex gap-1.5 shrink-0">
                                        {rec.form.map((p: any) => (
                                            <span class={`form-pill ${p.cls}`} title={p.tip} aria-label={p.tip}>{p.letter}</span>
                                        ))}
                                    </div>
                                )}
                            </div>

                            <div class="px-5 py-4 flex-1 border-t border-[color:var(--color-hairline)]">
                                {(team.captain || team.viceCaptain) && (
                                    <div class="grid grid-cols-2 gap-3">
                                        {team.captain && (
                                            <div>
                                                <div class="lbl">Captain</div>
                                                <div class="text-sm font-semibold text-heading">{team.captain}</div>
                                            </div>
                                        )}
                                        {team.viceCaptain && (
                                            <div>
                                                <div class="lbl">Vice-captain</div>
                                                <div class="text-sm font-semibold text-heading">{team.viceCaptain}</div>
                                            </div>
                                        )}
                                    </div>
                                )}

                                {team.homeGroundName && (
                                    <div class="flex gap-2 mt-3 text-sm">
                                        <Icon name="map-pin" size={15} class="shrink-0 mt-0.5 text-muted" />
                                        <div>
                                            <div class="font-semibold text-heading">{team.homeGroundName}</div>
                                            {team.homeGroundAddress && <div class="text-xs text-subtle mt-0.5">{team.homeGroundAddress}</div>}
                                        </div>
                                    </div>
                                )}

                                <div class="border-t border-[color:var(--color-hairline)] my-3.5"></div>

                                {rec.total === 0 ? (
                                    <p class="text-sm text-muted">No results yet this season</p>
                                ) : (
                                    <>
                                        <div class="flex items-baseline gap-1.5 mb-2">
                                            <span class="text-xl font-extrabold text-heading" style="font-variant-numeric:tabular-nums;">{rec.winRate}%</span>
                                            <span class="text-[13px] text-muted">win rate</span>
                                        </div>
                                        <div class="flex h-1.5 rounded-full overflow-hidden" style="background:var(--color-hairline);">
                                            {rec.win > 0 && <span style={`width:${(rec.win / rec.decided) * 100}%;background:#1B6B3A;`}></span>}
                                            {rec.loss > 0 && <span style={`width:${(rec.loss / rec.decided) * 100}%;background:#A82B24;`}></span>}
                                            {rec.tie > 0 && <span style={`width:${(rec.tie / rec.decided) * 100}%;background:#A9821B;`}></span>}
                                        </div>
                                        <div class="text-xs text-muted mt-1.5">
                                            <span class="font-bold text-heading">{rec.win}</span>W ·
                                            <span class="font-bold text-heading"> {rec.loss}</span>L ·
                                            <span class="font-bold text-heading"> {rec.tie}</span>T
                                            {rec.other > 0 && <> · <span class="font-bold text-heading">{rec.other}</span> NR</>}
                                            <span> · {rec.total} played</span>
                                        </div>
                                    </>
                                )}
                            </div>

                            <div class="border-t border-[color:var(--color-hairline)] px-5 py-3">
                                <a href={`/fixtures?team=${encodeURIComponent(team.teamName)}`} class="card-link">
                                    View fixtures <Icon name="arrow-right" size={15} />
                                </a>
                            </div>
                        </div>
                    );
                })}
            </div>
        )}
    </Section>

    <Section title="Player Development" kicker="Pathway" variant="alternate">
        <div class="grid sm:grid-cols-2 gap-6">
            {playerDevelopment.map(item => (
                <Card title={item.title} content={item.content} icon={item.icon} />
            ))}
        </div>
    </Section>

    <Section title="" align="left">
        <div class="accent-box">
            <h2 class="section-heading">Interested in joining a team?</h2>
            <p class="text-body-base measure">
                Golden State Cricket Club, part of <strong>Bengals Inc.</strong> (a 501(c)(3) non-profit),
                welcomes players of all skill levels from Northern California. We are a meritocracy-based club
                committed to fostering talent and providing opportunities for competitive cricket in the BACA and NCCA leagues.
            </p>
            <p class="text-body-base measure mt-3">
                <strong>Supporting our community:</strong> your membership dues fund youth programs,
                inclusive membership for students, and community cricket initiatives that make the sport accessible to all.
            </p>
            <a href="/members" class="btn btn-lg mt-6">Learn about membership <Icon name="arrow-right" size={16} /></a>
        </div>
    </Section>
</Layout>

<style>
    .lbl {
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-subtle-text);
        margin-bottom: 0.15rem;
    }
    .form-pill {
        width: 1.5rem;
        height: 1.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        font-size: 0.6875rem;
        font-weight: 800;
        color: #fff;
    }
    .form-w { background: #1B6B3A; }
    .form-l { background: #A82B24; }
    .form-t { background: #A9821B; }
    .form-n { background: #9CA3AF; }
</style>
