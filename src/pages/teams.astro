---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';

// Fetch active season
let activeSeason: any = null;
try {
    const res = await fetch(`${Astro.url.origin}/.netlify/functions/seasons-get-active`);
    if (res.ok) activeSeason = await res.json();
} catch (e) {}

const seasonTeams = activeSeason?.teams ?? [];

// Fetch this season's fixtures to derive each team's record + recent form
let seasonFixtures: any[] = [];
if (activeSeason?.id) {
    try {
        const res = await fetch(`${Astro.url.origin}/.netlify/functions/fixtures-list?seasonId=${activeSeason.id}`);
        if (res.ok) seasonFixtures = await res.json();
    } catch (e) {}
}

const RESULT_PILL: Record<string, { letter: string; label: string; cls: string }> = {
    win:       { letter: 'W', label: 'Won',       cls: 'bg-green-500 text-white' },
    loss:      { letter: 'L', label: 'Lost',      cls: 'bg-red-500 text-white' },
    tie:       { letter: 'T', label: 'Tied',      cls: 'bg-yellow-500 text-white' },
    abandoned: { letter: 'A', label: 'Abandoned', cls: 'bg-gray-400 text-white' },
    forfeit:   { letter: 'F', label: 'Forfeit',   cls: 'bg-gray-400 text-white' },
};

function fmtShortDate(d: string) {
    const [y, m, day] = String(d).split('-').map(Number);
    if (!y || !m || !day) return d;
    return new Date(y, m - 1, day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

// fixtures-list returns fixtures sorted by date ascending
function getTeamRecord(teamName: string) {
    const played = seasonFixtures.filter(
        (f) => f.team === teamName && f.result && RESULT_PILL[f.result]
    );
    let win = 0, loss = 0, tie = 0, other = 0;
    for (const f of played) {
        if (f.result === 'win') win++;
        else if (f.result === 'loss') loss++;
        else if (f.result === 'tie') tie++;
        else other++;
    }
    const decided = win + loss + tie;
    const winRate = decided > 0 ? Math.round((win / decided) * 100) : 0;
    const form = played.slice(-5).map((f) => ({
        ...RESULT_PILL[f.result as string],
        tip: `${RESULT_PILL[f.result as string].label} vs ${f.opponent} · ${fmtShortDate(f.date)}`,
    }));
    return { total: played.length, win, loss, tie, other, decided, winRate, form };
}

function getTeamColors(name: string) {
    if (name.includes('Tigers'))  return { header: '#fffbeb', border: '#fbbf24', badge: '#fef3c7', badgeBorder: '#fcd34d', badgeText: '#78350f' };
    if (name.includes('Bulls'))   return { header: '#eff6ff', border: '#60a5fa', badge: '#dbeafe', badgeBorder: '#93c5fd', badgeText: '#1e40af' };
    if (name.includes('Thunder')) return { header: '#faf5ff', border: '#c084fc', badge: '#f3e8ff', badgeBorder: '#d8b4fe', badgeText: '#6b21a8' };
    if (name.includes('Bears'))   return { header: '#f0fdf4', border: '#4ade80', badge: '#dcfce7', badgeBorder: '#86efac', badgeText: '#166534' };
    return { header: '#f9fafb', border: '#9ca3af', badge: '#f3f4f6', badgeBorder: '#d1d5db', badgeText: '#1f2937' };
}

const playerDevelopment = [
    {
        title: 'Competitive League Exposure',
        content: 'Regular participation in NCCA leagues provides players with consistent competitive cricket experience.'
    },
    {
        title: 'Leadership Opportunities',
        content: 'Members have opportunities to take on captaincy, coaching, and organizational roles within the club.'
    },
    {
        title: 'Regional & National Tournaments',
        content: 'Players participate in regional and national tournaments, expanding their cricket experience beyond local leagues.'
    },
    {
        title: 'USA Minor & Masters Leagues',
        content: 'Our members have the opportunity to play in USA Minor and Masters League competitions.'
    }
];
---

<Layout title="Teams - Golden State Cricket Club">
    <h1 class="page-title heading-margin-sm">Our Teams</h1>
    <p class="text-intro mb-8">{activeSeason ? activeSeason.name : 'Current Season'}</p>

    <Section>
        {seasonTeams.length === 0 ? (
            <p class="text-center text-gray-500 py-12">No active season found. Please set an active season in the admin panel.</p>
        ) : (
            <div class="grid sm:grid-cols-2 gap-6 mb-12">
                {seasonTeams.map((team: any) => {
                    const c = getTeamColors(team.teamName);
                    const rec = getTeamRecord(team.teamName);
                    return (
                        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col">
                            {/* Header — the only team-tinted area */}
                            <div style={`background:${c.header};border-bottom:2px solid ${c.border};`} class="px-5 py-3.5 flex items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <h3 class="text-lg font-bold text-gray-900 leading-tight mb-1.5">{team.teamName}</h3>
                                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold border" style={`background:${c.badge};border-color:${c.badgeBorder};color:${c.badgeText}`}>
                                        {team.division}
                                    </span>
                                </div>
                                {rec.form.length > 0 && (
                                    <div class="flex gap-1.5 shrink-0">
                                        {rec.form.map((p: any) => (
                                            <span
                                                class={`w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold ${p.cls}`}
                                                title={p.tip}
                                                aria-label={p.tip}
                                            >
                                                {p.letter}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>

                            {/* Body */}
                            <div class="px-5 py-4 flex-1">
                                {(team.captain || team.viceCaptain) && (
                                    <div class="grid grid-cols-2 gap-3">
                                        {team.captain && (
                                            <div>
                                                <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-0.5">Captain</div>
                                                <div class="text-sm font-semibold text-gray-800">{team.captain}</div>
                                            </div>
                                        )}
                                        {team.viceCaptain && (
                                            <div>
                                                <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-0.5">Vice-captain</div>
                                                <div class="text-sm font-semibold text-gray-800">{team.viceCaptain}</div>
                                            </div>
                                        )}
                                    </div>
                                )}

                                {team.homeGroundName && (
                                    <div class="flex gap-2 mt-3 text-sm">
                                        <span class="shrink-0">📍</span>
                                        <div>
                                            <div class="font-semibold text-gray-800">{team.homeGroundName}</div>
                                            {team.homeGroundAddress && (
                                                <div class="text-xs text-gray-500 mt-0.5">{team.homeGroundAddress}</div>
                                            )}
                                        </div>
                                    </div>
                                )}

                                <div class="border-t border-gray-100 my-3.5"></div>

                                {/* Season record */}
                                {rec.total === 0 ? (
                                    <p class="text-sm text-gray-500">No results yet this season</p>
                                ) : (
                                    <>
                                        <div class="flex items-baseline gap-1.5 mb-2">
                                            <span class="text-xl font-extrabold text-gray-900">{rec.winRate}%</span>
                                            <span class="text-[13px] text-gray-500">win rate</span>
                                        </div>
                                        <div class="flex h-1.5 rounded-full overflow-hidden bg-gray-100">
                                            {rec.win > 0 && <span class="bg-green-500" style={`width:${(rec.win / rec.decided) * 100}%`}></span>}
                                            {rec.loss > 0 && <span class="bg-red-500" style={`width:${(rec.loss / rec.decided) * 100}%`}></span>}
                                            {rec.tie > 0 && <span class="bg-yellow-500" style={`width:${(rec.tie / rec.decided) * 100}%`}></span>}
                                        </div>
                                        <div class="text-xs text-gray-500 mt-1.5">
                                            <span class="font-bold text-gray-700">{rec.win}</span>W ·
                                            <span class="font-bold text-gray-700"> {rec.loss}</span>L ·
                                            <span class="font-bold text-gray-700"> {rec.tie}</span>T
                                            {rec.other > 0 && <> · <span class="font-bold text-gray-700">{rec.other}</span> NR</>}
                                            <span> · {rec.total} played</span>
                                        </div>
                                    </>
                                )}
                            </div>

                            {/* Footer */}
                            <div class="border-t border-gray-100 px-5 py-3 text-center">
                                <a
                                    href={`/fixtures?team=${encodeURIComponent(team.teamName)}`}
                                    class="text-sm font-bold text-primary hover:underline"
                                >
                                    View fixtures &rarr;
                                </a>
                            </div>
                        </div>
                    );
                })}
            </div>
        )}
    </Section>

    <Section title="Player Development" variant="alternate">
        <div class="grid sm:grid-cols-2 gap-6">
            {playerDevelopment.map(item => (
                <Card title={item.title} content={item.content} />
            ))}
        </div>
    </Section>

    <Section>
        <div class="section-centered bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-lg p-8">
            <h2 class="subsection-heading">Interested in Joining a Team?</h2>
            <p class="text-body-base text-justified mb-4">
                Golden State Cricket Club (GSCC), part of <strong>Bengals Inc.</strong> (a 501(c)(3) non-profit),
                welcomes players of all skill levels from Northern California. We are a meritocracy-based club
                committed to fostering talent and providing opportunities for competitive cricket in BACA and NCCA leagues.
            </p>
            <div class="bg-white border-2 border-primary/30 rounded-lg p-4 mb-6">
                <p class="text-body-base">
                    <strong>Supporting Our Community:</strong> Your membership dues support Bengals Inc.'s mission—
                    funding youth programs, inclusive membership for students, and community cricket initiatives
                    that make the sport accessible to all.
                </p>
            </div>
            <a href="/members" class="btn btn-lg">Learn About Membership</a>
        </div>
    </Section>
</Layout>
