---
export const prerender = false;

import { logoutCookies } from '../middleware/auth';

// Clear the session cookie (shared and host-only), then go to login if
// ?from=pwa, otherwise the home page
const from = Astro.url.searchParams.get('from');
const headers = new Headers({ Location: from === 'pwa' ? '/login' : '/' });
for (const cookie of logoutCookies(import.meta.env.PROD, Astro.url.host)) {
  headers.append('Set-Cookie', cookie);
}
return new Response(null, { status: 302, headers });
---
