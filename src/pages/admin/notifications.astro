---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { NOTIFICATION_URL_OPTIONS } from '../../types/notificationGroup';

const cookieHeader = Astro.request.headers.get('cookie');
let authenticated = false;
let username = '';
let userRole = 'admin';
let isAdminUser = false;

if (cookieHeader) {
  try {
    const response = await fetch(
      `${Astro.url.origin}/.netlify/functions/auth-check`,
      { headers: { cookie: cookieHeader } }
    );
    const data = await response.json();
    authenticated = data.authenticated;
    username = data.user?.firstName || data.user?.username || '';
    userRole = data.user?.role_auth || data.user?.role || 'admin';
    isAdminUser = userRole === 'admin' || userRole === 'super_admin';
  } catch {
    authenticated = false;
  }
}

if (!authenticated) return Astro.redirect('/admin/login');
if (!isAdminUser) return Astro.redirect('/');
---

<AdminLayout title="Send Notification - GSCC Admin" username={username} userRole={userRole} activePage="notifications">
  <div class="notif-page">

    <div class="page-header">
      <h1 class="page-title">Notifications</h1>
      <p class="page-description">Push notifications to players' phones and browsers, and manage reusable recipient groups</p>
    </div>

    <!-- Top tabs -->
    <div class="notif-tabs" role="tablist" aria-label="Notification sections">
      <button type="button" id="tab-send" class="tab-btn active" role="tab" aria-selected="true" aria-controls="panel-send">
        Send Notification
      </button>
      <button type="button" id="tab-groups" class="tab-btn" role="tab" aria-selected="false" aria-controls="panel-groups">
        Manage Groups <span id="groups-tab-count" class="tab-count">0</span>
      </button>
    </div>

    <!-- TAB 1: SEND NOTIFICATION -->
    <div id="panel-send" role="tabpanel" aria-labelledby="tab-send">
      <div class="notif-card">

        <!-- Subscriber count -->
        <div class="subscriber-bar">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
          <span id="subscriber-count">Loading subscriber count...</span>
        </div>

        <!-- Quick presets -->
        <div class="section-label">Quick presets</div>
        <div class="presets">
          <button type="button" class="preset-btn" data-title="Vote for Next Week's Fixtures" data-body="Check upcoming matches and mark your availability before voting closes." data-url="/myfixtures">
            <span class="preset-icon">📅</span>
            <div>
              <div class="preset-title">Vote for fixtures</div>
              <div class="preset-desc">Prompts players to mark availability</div>
            </div>
          </button>
          <button type="button" class="preset-btn" data-title="Voting Closes in 2 Hours" data-body="Last chance! Mark your availability for this weekend's fixtures now." data-url="/myfixtures">
            <span class="preset-icon">⏰</span>
            <div>
              <div class="preset-title">Voting closing soon</div>
              <div class="preset-desc">Urgency reminder before deadline</div>
            </div>
          </button>
          <button type="button" class="preset-btn" data-title="Practice Vote is Open" data-body="Let us know if you're coming to practice this week." data-url="/mypractice">
            <span class="preset-icon">🏏</span>
            <div>
              <div class="preset-title">Practice vote open</div>
              <div class="preset-desc">Asks players to respond for practice</div>
            </div>
          </button>
          <button type="button" class="preset-btn" data-title="Upload Match Summary & Scorecard" data-body="Captains & VCs: please upload today's match summary and complete the scorecard." data-url="/admin/fixtures">
            <span class="preset-icon">📋</span>
            <div>
              <div class="preset-title">Match summary &amp; scorecard</div>
              <div class="preset-desc">Sunday reminder for Captains &amp; VCs</div>
            </div>
          </button>
        </div>

        <div class="divider"></div>

        <!-- Audience -->
        <div class="section-label">Send to</div>
        <div class="audience" role="radiogroup" aria-label="Send to">
          <label class="audience-option"><input type="radio" name="audience" value="all" checked /> Everyone with notifications on</label>
          <label class="audience-option"><input type="radio" name="audience" value="groups" /> Groups</label>
          <label class="audience-option"><input type="radio" name="audience" value="chosen" /> Chosen players</label>
        </div>

        <!-- Groups picker -->
        <div id="group-picker" class="picker" hidden>
          <div id="send-groups-list" class="send-groups-list"></div>
          <p id="group-picker-note" class="picker-note"></p>
        </div>

        <!-- Individual players picker -->
        <div id="picker" class="picker" hidden>
          <input id="player-search" type="search" placeholder="Search players with notifications on" autocomplete="off" />
          <div id="chosen-chips" class="chips"></div>
          <ul id="player-list" class="player-list" aria-label="Players with notifications on"></ul>
          <div class="picker-footer">
            <p id="picker-note" class="picker-note"></p>
            <button type="button" id="save-chosen-as-group-btn" class="link-btn" hidden>Save selection as group →</button>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Custom fields -->
        <div class="section-label">Message</div>
        <div class="fields">
          <div class="field">
            <label for="notif-title">Title <span class="char-count" id="title-count">0 / 60</span></label>
            <input id="notif-title" type="text" maxlength="60" placeholder="e.g. Vote for Next Week's Fixtures" />
          </div>
          <div class="field">
            <label for="notif-body">Body <span class="char-count" id="body-count">0 / 140</span></label>
            <textarea id="notif-body" maxlength="140" rows="3" placeholder="e.g. Check upcoming matches and mark your availability before voting closes."></textarea>
          </div>
          <div class="field">
            <label for="notif-url">Opens</label>
            <select id="notif-url">
              {NOTIFICATION_URL_OPTIONS.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Preview -->
        <div class="section-label" style="margin-top:0.5rem;">Preview</div>
        <div class="preview-box">
          <div class="preview-icon">
            <img src="/icons/icon-192.png" alt="GSCC" width="36" height="36" style="border-radius:8px;" />
          </div>
          <div class="preview-content">
            <div class="preview-title" id="preview-title">Notification title</div>
            <div class="preview-body" id="preview-body">Notification message will appear here.</div>
          </div>
        </div>

        <!-- Result -->
        <div id="send-result" class="result-box" style="display:none;"></div>

        <!-- Send button -->
        <button type="button" id="send-btn" class="send-btn">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          <span id="send-label">Send to everyone</span>
        </button>

      </div>
    </div>

    <!-- TAB 2: MANAGE GROUPS -->
    <div id="panel-groups" role="tabpanel" aria-labelledby="tab-groups" hidden>
      <div class="groups-container">

        <div class="groups-toolbar">
          <div>
            <h2 class="groups-heading">Notification Groups</h2>
            <p class="groups-subheading">Create reusable recipient lists (e.g. Captains &amp; VCs, Umpires, Squads) with optional default messages.</p>
          </div>
          <button type="button" id="new-group-btn" class="primary-btn">+ New Group</button>
        </div>

        <div id="groups-status" class="result-box" style="display:none;"></div>

        <!-- Group Create/Edit Editor -->
        <div id="group-editor" class="notif-card editor-card" hidden>
          <div class="editor-header">
            <h3 id="editor-title" class="editor-heading">Create Notification Group</h3>
            <button type="button" id="editor-close-btn" class="icon-close-btn" aria-label="Close editor">✕</button>
          </div>

          <div class="fields">
            <div class="field">
              <label for="group-name">Group Name <span class="char-count" id="group-name-count">0 / 60</span></label>
              <input id="group-name" type="text" maxlength="60" placeholder="e.g. Captains & VCs" />
            </div>

            <div class="field">
              <label for="group-desc">Description (optional) <span class="char-count" id="group-desc-count">0 / 160</span></label>
              <input id="group-desc" type="text" maxlength="160" placeholder="e.g. Team leaders for Sunday match summaries and scorecards" />
            </div>

            <!-- Quick-fill shortcuts -->
            <div class="field">
              <div class="label-row">
                <span class="field-label-text">Quick-fill members</span>
                <button type="button" id="group-clear-members" class="link-btn">Clear all</button>
              </div>
              <div id="quick-fill-bar" class="quick-fill-bar"></div>
              <p id="quick-fill-note" class="picker-note"></p>
            </div>

            <!-- Member picker (all active players) -->
            <div class="field">
              <label for="group-player-search">
                Members
                <span class="char-count" id="group-member-count">0 selected</span>
              </label>
              <div id="group-member-chips" class="chips"></div>
              <input id="group-player-search" type="search" placeholder="Search all active club players..." autocomplete="off" />
              <ul id="group-player-list" class="player-list" aria-label="Club players"></ul>
              <p class="picker-note">You can add any active player, even if they haven't enabled notifications yet.</p>
            </div>

            <div class="divider"></div>

            <!-- Optional default message template -->
            <div class="section-label">Default message template (optional)</div>
            <div class="field">
              <label for="group-tpl-title">Default Title <span class="char-count" id="group-tpl-title-count">0 / 60</span></label>
              <input id="group-tpl-title" type="text" maxlength="60" placeholder="e.g. Upload Match Summary & Scorecard" />
            </div>
            <div class="field">
              <label for="group-tpl-body">Default Body <span class="char-count" id="group-tpl-body-count">0 / 140</span></label>
              <textarea id="group-tpl-body" maxlength="140" rows="2" placeholder="e.g. Captains & VCs: please upload today's match summary and complete the scorecard."></textarea>
            </div>
            <div class="field">
              <label for="group-tpl-url">Default Opens</label>
              <select id="group-tpl-url">
                {NOTIFICATION_URL_OPTIONS.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
            </div>
          </div>

          <div id="editor-error" class="result-box error" style="display:none;"></div>

          <div class="editor-actions">
            <button type="button" id="editor-cancel-btn" class="secondary-btn">Cancel</button>
            <button type="button" id="editor-save-btn" class="primary-btn">Save Group</button>
          </div>
        </div>

        <!-- Saved groups list -->
        <div id="manage-groups-list" class="manage-groups-list">
          <div class="empty-card">Loading groups...</div>
        </div>

      </div>
    </div>

  </div>
</AdminLayout>

<style>
  .notif-page {
    width: 100%;
    max-width: 760px;
  }

  .page-header {
    margin-bottom: 1.25rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin: 0 0 0.25rem;
  }

  .page-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Top Tabs */
  .notif-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 2px solid var(--color-border, #E9E4DD);
    margin-bottom: 1.25rem;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1.1rem;
    min-height: 44px;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    font-family: inherit;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .tab-btn:hover {
    color: var(--color-text-heading);
  }

  .tab-btn.active {
    color: #8C1D18;
    border-bottom-color: #8C1D18;
  }

  .tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    background: #FAF7F2;
    border: 1px solid #E9E4DD;
    color: #1A1614;
  }

  .tab-btn.active .tab-count {
    background: #F6E7E4;
    border-color: #E3BEB8;
    color: #8C1D18;
  }

  .notif-card {
    background: white;
    border: 1px solid var(--color-border, #E9E4DD);
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 680px;
  }

  .editor-card {
    max-width: 100%;
    border-color: #C9A227;
    box-shadow: 0 6px 20px rgba(26, 22, 20, 0.06);
  }

  .subscriber-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: #FAF7F2;
    border: 1px solid #E9E4DD;
    border-radius: 0.5rem;
    padding: 0.625rem 0.875rem;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #A9821B;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .presets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.5rem;
  }

  .preset-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    min-height: 54px;
    background: #FAF7F2;
    border: 1px solid var(--color-border, #E9E4DD);
    border-radius: 0.625rem;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, border-color 0.15s;
    width: 100%;
  }

  .preset-btn:hover {
    background: #F6E7E4;
    border-color: #8C1D18;
  }

  .preset-btn.selected {
    background: #F6E7E4;
    border-color: #8C1D18;
  }

  .preset-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .preset-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-heading);
  }

  .preset-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.125rem;
  }

  .divider {
    height: 1px;
    background: var(--color-border, #E9E4DD);
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field label,
  .label-row {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-body);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .field-label-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-body);
  }

  .char-count {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .field input,
  .field textarea,
  .field select {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border, #E9E4DD);
    border-radius: 0.5rem;
    font-size: 1rem;
    font-family: inherit;
    color: var(--color-text-body);
    background: white;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s;
  }

  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    border-color: #8C1D18;
  }

  .field textarea {
    resize: vertical;
  }

  .preview-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: #FAF7F2;
    border-radius: 0.75rem;
    border: 1px solid #E9E4DD;
  }

  .preview-icon {
    flex-shrink: 0;
  }

  .preview-content {
    flex: 1;
    min-width: 0;
  }

  .preview-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #1A1614;
    margin-bottom: 0.2rem;
  }

  .preview-body {
    font-size: 0.75rem;
    color: #475569;
    line-height: 1.4;
  }

  .result-box {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }

  .result-box.success {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .result-box.error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  .send-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 48px;
    padding: 0.75rem;
    background: #1A1614;
    color: white;
    border: none;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }

  .send-btn:hover:not(:disabled) {
    background: #8C1D18;
  }

  .send-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.6rem 1.1rem;
    background: #8C1D18;
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .primary-btn:hover:not(:disabled) {
    background: #6F1612;
  }

  .primary-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.6rem 1rem;
    background: white;
    color: #1A1614;
    border: 1px solid #D6CEC4;
    border-radius: 0.5rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .secondary-btn:hover {
    background: #FAF7F2;
  }

  .link-btn {
    background: none;
    border: 0;
    padding: 0.25rem 0;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #8C1D18;
    cursor: pointer;
  }

  .link-btn:hover {
    text-decoration: underline;
  }

  .audience {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
  }

  .audience-option {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    font-size: 0.925rem;
    color: var(--color-text-body);
    cursor: pointer;
  }

  .audience-option input[type="radio"] {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: #8C1D18;
  }

  .picker {
    display: grid;
    gap: 0.6rem;
  }

  .picker input[type="search"] {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border-strong, #D6CEC4);
    border-radius: 8px;
    font: inherit;
    font-size: 1rem;
    background: white;
    color: var(--color-text-body);
    box-sizing: border-box;
  }

  .picker-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chips:empty {
    display: none;
  }

  /* Rows and chips are created by the script, so these need :global() to reach them */
  .chips :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: #F6E7E4;
    color: #8C1D18;
    font-size: 0.8rem;
    font-weight: 600;
    border: 0;
    cursor: pointer;
  }

  .player-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 280px;
    overflow-y: auto;
    border: 1px solid var(--color-border, #E9E4DD);
    border-radius: 10px;
    background: white;
  }

  .player-list :global(li) {
    border-bottom: 1px solid var(--color-border, #E9E4DD);
  }

  .player-list :global(li:last-child) {
    border-bottom: 0;
  }

  .player-list :global(label) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    min-height: 44px;
    cursor: pointer;
    font-size: 0.925rem;
    color: var(--color-text-heading);
    box-sizing: border-box;
  }

  .player-list :global(label:hover) {
    background: #FAF7F2;
  }

  .player-list :global(input[type="checkbox"]) {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    flex: none;
    accent-color: #8C1D18;
  }

  .player-list :global(.name) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .player-list :global(.devices) {
    flex: none;
    font-size: 0.75rem;
    font-weight: 600;
    color: #166534;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    white-space: nowrap;
  }

  .player-list :global(.devices.muted) {
    color: var(--color-text-muted);
    background: #FAF7F2;
    border-color: #E9E4DD;
  }

