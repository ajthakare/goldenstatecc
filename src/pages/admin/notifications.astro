    border: 1px solid #E9E4DD;
    color: #1A1614;
  }

  .manage-groups-list :global(.stat-pill.good) {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #166534;
  }

  .manage-groups-list :global(.member-preview) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .manage-groups-list :global(.member-tag) {
    font-size: 0.775rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: #FAF7F2;
    border: 1px solid #E9E4DD;
    color: #1A1614;
  }

  .manage-groups-list :global(.template-preview) {
    font-size: 0.8rem;
    color: #57534E;
    background: #FFFDF5;
    border: 1px solid #EEDBA0;
    border-radius: 0.5rem;
    padding: 0.45rem 0.7rem;
  }

  .manage-groups-list :global(.group-card-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }

  .manage-groups-list :global(.card-btn) {
    min-height: 40px;
    padding: 0.4rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid #D6CEC4;
    background: white;
    color: #1A1614;
    font-family: inherit;
    font-size: 0.825rem;
    font-weight: 600;
    cursor: pointer;
  }

  .manage-groups-list :global(.card-btn:hover) {
    background: #FAF7F2;
  }

  .manage-groups-list :global(.card-btn.send) {
    background: #1A1614;
    border-color: #1A1614;
    color: white;
  }

  .manage-groups-list :global(.card-btn.send:hover) {
    background: #8C1D18;
    border-color: #8C1D18;
  }

  .manage-groups-list :global(.card-btn.danger) {
    color: #991b1b;
    border-color: #fecaca;
    background: #fef2f2;
  }

  .manage-groups-list :global(.card-btn.danger:hover) {
    background: #fee2e2;
  }
</style>

<script>
  import type { NotificationGroup, QuickFillPreset } from '../../types/notificationGroup';

  type Devices = { web: number; app: number };
  type SimplePlayer = { id: string; name: string; active: boolean };

  let byPlayer: Record<string, Devices> = {};
  let names: Record<string, string> = {};
  let allActivePlayers: SimplePlayer[] = [];
  let groups: NotificationGroup[] = [];
  let quickFills: QuickFillPreset[] = [];
  let activeSeasonName: string | null = null;

  const chosen = new Set<string>();
  const selectedGroupIds = new Set<string>();

  // Group editor state
  let editingGroupId: string | null = null;
  const editorMembers = new Set<string>();

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const audience = () => (document.querySelector('input[name="audience"]:checked') as HTMLInputElement).value;

  function deviceText(d: Devices | undefined) {
    if (!d) return '';
    const parts: string[] = [];
    if (d.app) parts.push(`${d.app} app`);
    if (d.web) parts.push(`${d.web} browser`);
    return parts.join(' · ');
  }

  function activeIdSet() {
    return new Set(allActivePlayers.map((p) => p.id));
  }

  function groupStats(group: NotificationGroup) {
    const activeIds = activeIdSet();
    const memberIds = activeIds.size > 0
      ? group.playerIds.filter((id) => activeIds.has(id))
      : [...group.playerIds];
    const subscribed = memberIds.filter((id) => !!byPlayer[id]).length;
    return { memberIds, total: memberIds.length, subscribed };
  }

  function selectedGroupsSummary() {
    const activeIds = activeIdSet();
    const unique = new Set<string>();
    for (const gid of selectedGroupIds) {
      const g = groups.find((item) => item.id === gid);
      if (!g) continue;
      for (const pid of g.playerIds) {
        if (activeIds.size === 0 || activeIds.has(pid)) unique.add(pid);
      }
    }
    const reachable = [...unique].filter((id) => !!byPlayer[id]).length;
    return { groupCount: selectedGroupIds.size, uniqueMembers: unique.size, reachable };
  }

  // ---- Tabs ----
  function switchTab(tab: 'send' | 'groups') {
    const isSend = tab === 'send';
    $('tab-send').classList.toggle('active', isSend);
    $('tab-send').setAttribute('aria-selected', String(isSend));
    $('panel-send').hidden = !isSend;

    $('tab-groups').classList.toggle('active', !isSend);
    $('tab-groups').setAttribute('aria-selected', String(!isSend));
    $('panel-groups').hidden = isSend;
  }

  $('tab-send').addEventListener('click', () => switchTab('send'));
  $('tab-groups').addEventListener('click', () => switchTab('groups'));

  // ---- Send button & audience ----
  function updateSendLabel() {
    const mode = audience();
    const btn = $('send-btn') as HTMLButtonElement;
    if (mode === 'all') {
      $('send-label').textContent = 'Send to everyone';
      btn.disabled = false;
      return;
    }
    if (mode === 'groups') {
      const { groupCount, reachable } = selectedGroupsSummary();
      if (groupCount === 0) {
        $('send-label').textContent = 'Choose groups to send to';
        btn.disabled = true;
      } else {
        $('send-label').textContent =
          `Send to ${groupCount} group${groupCount !== 1 ? 's' : ''} (${reachable} reachable)`;
        btn.disabled = false;
      }
      return;
    }
    const n = chosen.size;
    $('send-label').textContent =
      n === 0 ? 'Choose players to send to' : `Send to ${n} player${n !== 1 ? 's' : ''}`;
    btn.disabled = n === 0;
  }

  function applyMessageTemplate(tpl: { title: string; body: string; url: string }) {
    ($('notif-title') as HTMLInputElement).value = tpl.title;
    ($('notif-body') as HTMLTextAreaElement).value = tpl.body;
    const urlSelect = $('notif-url') as HTMLSelectElement;
    if ([...urlSelect.options].some((o) => o.value === tpl.url)) {
      urlSelect.value = tpl.url;
    }
    updatePreview();
    updateCharCounts();
  }

  function renderSendGroups() {
    const container = $('send-groups-list');
    container.replaceChildren();

    if (groups.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'empty-card';
      empty.textContent = 'No notification groups yet. ';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'link-btn';
      btn.textContent = 'Create your first group →';
      btn.addEventListener('click', () => {
        switchTab('groups');
        openEditor(null);
      });
      empty.append(btn);
      container.append(empty);
      $('group-picker-note').textContent = '';
      updateSendLabel();
      return;
    }

    for (const g of groups) {
      const stats = groupStats(g);
      const isChecked = selectedGroupIds.has(g.id);

      const row = document.createElement('label');
      row.className = `send-group-row${isChecked ? ' selected' : ''}`;

      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = isChecked;
      box.addEventListener('change', () => {
        if (box.checked) {
          selectedGroupIds.add(g.id);
          // Convenience: if title & body are empty and this group has a default template, fill it
          const titleVal = ($('notif-title') as HTMLInputElement).value.trim();
          const bodyVal = ($('notif-body') as HTMLTextAreaElement).value.trim();
          if (!titleVal && !bodyVal && g.defaultMessage) {
            applyMessageTemplate(g.defaultMessage);
          }
        } else {
          selectedGroupIds.delete(g.id);
        }
        renderSendGroups();
        updateSendLabel();
      });

      const info = document.createElement('div');
      info.className = 'send-group-info';

      const top = document.createElement('div');
      top.className = 'send-group-top';

      const nameEl = document.createElement('span');
      nameEl.className = 'send-group-name';
      nameEl.textContent = g.name;

      const pill = document.createElement('span');
      pill.className = `reach-pill${stats.subscribed === 0 ? ' warn' : ''}`;
      pill.textContent = `${stats.total} member${stats.total !== 1 ? 's' : ''} · ${stats.subscribed} subscribed`;

      top.append(nameEl, pill);
      info.append(top);

      if (g.description) {
        const descEl = document.createElement('div');
        descEl.className = 'send-group-desc';
        descEl.textContent = g.description;
        info.append(descEl);
      }

      if (g.defaultMessage) {
        const tplBtn = document.createElement('button');
        tplBtn.type = 'button';
        tplBtn.className = 'tpl-load-btn';
        tplBtn.textContent = `Load template: "${g.defaultMessage.title}"`;
        tplBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          applyMessageTemplate(g.defaultMessage!);
        });
        info.append(tplBtn);
      }

      row.append(box, info);
      container.append(row);
    }

    const summary = selectedGroupsSummary();
    $('group-picker-note').textContent = summary.groupCount
      ? `Selected: ${summary.groupCount} group${summary.groupCount !== 1 ? 's' : ''} · ${summary.uniqueMembers} unique player${summary.uniqueMembers !== 1 ? 's' : ''} (${summary.reachable} with notifications on).`
      : 'Pick one or more groups. Players in multiple groups are only notified once.';
    updateSendLabel();
  }

  // ---- Individual player picker (Send tab) ----
  function renderPicker() {
    const q = ($('player-search') as HTMLInputElement).value.trim().toLowerCase();
    const ids = Object.keys(byPlayer)
      .filter((id) => names[id])
      .sort((a, b) => names[a].localeCompare(names[b]));
    const list = $('player-list');
    list.replaceChildren();
    for (const id of ids.filter((id) => !q || names[id].toLowerCase().includes(q))) {
      const li = document.createElement('li');
      const label = document.createElement('label');
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = chosen.has(id);
      box.addEventListener('change', () => {
        box.checked ? chosen.add(id) : chosen.delete(id);
        renderChips();
        updateSendLabel();
      });
      const name = document.createElement('span');
      name.className = 'name';
      name.textContent = names[id];
      const devices = document.createElement('span');
      devices.className = 'devices';
      devices.textContent = deviceText(byPlayer[id]);
      label.append(box, name, devices);
      li.append(label);
      list.append(li);
    }
    $('picker-note').textContent = ids.length
      ? 'Only players with notifications turned on are listed.'
      : 'No players have notifications turned on yet.';
    $('save-chosen-as-group-btn').hidden = chosen.size === 0;
  }

  function renderChips() {
    const chips = $('chosen-chips');
    chips.replaceChildren();
    for (const id of chosen) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'chip';
      chip.textContent = `${names[id] || 'Player'} ✕`;
      chip.setAttribute('aria-label', `Remove ${names[id] || 'player'}`);
      chip.addEventListener('click', () => {
        chosen.delete(id);
        renderChips();
        renderPicker();
        updateSendLabel();
      });
      chips.append(chip);
    }
    $('save-chosen-as-group-btn').hidden = chosen.size === 0;
  }

  $('save-chosen-as-group-btn').addEventListener('click', () => {
    switchTab('groups');
    openEditor(null, [...chosen]);
  });

  // ---- Manage Groups Tab ----
  function renderManageGroups() {
    $('groups-tab-count').textContent = String(groups.length);
    const list = $('manage-groups-list');
    list.replaceChildren();

    if (groups.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'empty-card';
      empty.textContent = 'No groups created yet. Click "+ New Group" to create one (for example, Captains & VCs).';
      list.append(empty);
      return;
    }

    for (const g of groups) {
      const stats = groupStats(g);
      const card = document.createElement('div');
      card.className = 'group-card';

      const head = document.createElement('div');
      head.className = 'group-card-head';

      const titleWrap = document.createElement('div');
      const titleEl = document.createElement('div');
      titleEl.className = 'group-card-title';
      titleEl.textContent = g.name;
      titleWrap.append(titleEl);
      if (g.description) {
        const descEl = document.createElement('div');
        descEl.className = 'group-card-desc';
        descEl.textContent = g.description;
        titleWrap.append(descEl);
      }

      const badges = document.createElement('div');
      badges.className = 'group-card-badges';
      const totalPill = document.createElement('span');
      totalPill.className = 'stat-pill';
      totalPill.textContent = `${stats.total} member${stats.total !== 1 ? 's' : ''}`;
      const subPill = document.createElement('span');
      subPill.className = `stat-pill${stats.subscribed > 0 ? ' good' : ''}`;
      subPill.textContent = `${stats.subscribed} with notifications on`;
      badges.append(totalPill, subPill);

      head.append(titleWrap, badges);
      card.append(head);

      // Member preview chips (up to 8)
      const preview = document.createElement('div');
      preview.className = 'member-preview';
      const sortedNames = stats.memberIds
        .map((id) => names[id] || 'Unknown player')
        .sort((a, b) => a.localeCompare(b));
      const shown = sortedNames.slice(0, 8);
      for (const n of shown) {
        const tag = document.createElement('span');
        tag.className = 'member-tag';
        tag.textContent = n;
        preview.append(tag);
      }
      if (sortedNames.length > 8) {
        const more = document.createElement('span');
        more.className = 'member-tag';
        more.textContent = `+${sortedNames.length - 8} more`;
        preview.append(more);
      }
      card.append(preview);

      if (g.defaultMessage) {
        const tpl = document.createElement('div');
        tpl.className = 'template-preview';
        tpl.textContent = `Default message: "${g.defaultMessage.title}" → ${g.defaultMessage.url}`;
        card.append(tpl);
      }

      const actions = document.createElement('div');
      actions.className = 'group-card-actions';

      const sendBtn = document.createElement('button');
      sendBtn.type = 'button';
      sendBtn.className = 'card-btn send';
      sendBtn.textContent = 'Send to group';
      sendBtn.addEventListener('click', () => {
        selectedGroupIds.clear();
        selectedGroupIds.add(g.id);
        const groupsRadio = document.querySelector('input[name="audience"][value="groups"]') as HTMLInputElement;
        groupsRadio.checked = true;
        $('group-picker').hidden = false;
        $('picker').hidden = true;
        if (g.defaultMessage) {
          applyMessageTemplate(g.defaultMessage);
        }
        renderSendGroups();
        updateSendLabel();
        switchTab('send');
      });

      const editBtn = document.createElement('button');
      editBtn.type = 'button';
      editBtn.className = 'card-btn';
      editBtn.textContent = 'Edit';
      editBtn.addEventListener('click', () => openEditor(g));

      const delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.className = 'card-btn danger';
      delBtn.textContent = 'Delete';
      delBtn.addEventListener('click', () => deleteGroup(g));

      actions.append(sendBtn, editBtn, delBtn);
      card.append(actions);
      list.append(card);
    }
  }

  // ---- Group Editor ----
  function updateEditorCounts() {
    $('group-name-count').textContent = `${($('group-name') as HTMLInputElement).value.length} / 60`;
    $('group-desc-count').textContent = `${($('group-desc') as HTMLInputElement).value.length} / 160`;
    $('group-tpl-title-count').textContent = `${($('group-tpl-title') as HTMLInputElement).value.length} / 60`;
    $('group-tpl-body-count').textContent = `${($('group-tpl-body') as HTMLTextAreaElement).value.length} / 140`;
    const subCount = [...editorMembers].filter((id) => !!byPlayer[id]).length;
    $('group-member-count').textContent = `${editorMembers.size} selected (${subCount} subscribed)`;
  }

  function renderQuickFills() {
    const bar = $('quick-fill-bar');
    bar.replaceChildren();
    if (quickFills.length === 0) {
      $('quick-fill-note').textContent = 'No active-season rosters or roles available for quick-fill yet.';
      return;
    }
    for (const preset of quickFills) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `qf-btn ${preset.category}`;
      btn.textContent = `+ ${preset.label} (${preset.playerIds.length})`;
      btn.addEventListener('click', () => {
        for (const id of preset.playerIds) editorMembers.add(id);
        renderEditorChips();
        renderEditorPlayerList();
        updateEditorCounts();
      });
      bar.append(btn);
    }
    $('quick-fill-note').textContent = activeSeasonName
      ? `Adds matching players from ${activeSeasonName} into this group (you can still add or remove anyone).`
      : 'Adds matching players into this group (you can still add or remove anyone).';
  }

  function renderEditorChips() {
    const chips = $('group-member-chips');
    chips.replaceChildren();
    const sorted = [...editorMembers].sort((a, b) => (names[a] || a).localeCompare(names[b] || b));
    for (const id of sorted) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'chip';
      chip.textContent = `${names[id] || 'Player'} ✕`;
      chip.setAttribute('aria-label', `Remove ${names[id] || 'player'}`);
      chip.addEventListener('click', () => {
        editorMembers.delete(id);
        renderEditorChips();
        renderEditorPlayerList();
        updateEditorCounts();
      });
      chips.append(chip);
    }
  }

  function renderEditorPlayerList() {
    const q = ($('group-player-search') as HTMLInputElement).value.trim().toLowerCase();
    const list = $('group-player-list');
    list.replaceChildren();

    const filtered = allActivePlayers.filter((p) => !q || p.name.toLowerCase().includes(q));
    for (const p of filtered) {
      const li = document.createElement('li');
      const label = document.createElement('label');
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = editorMembers.has(p.id);
      box.addEventListener('change', () => {
        box.checked ? editorMembers.add(p.id) : editorMembers.delete(p.id);
        renderEditorChips();
        updateEditorCounts();
      });
      const nameEl = document.createElement('span');
      nameEl.className = 'name';
      nameEl.textContent = p.name;

      const dev = document.createElement('span');
      const d = byPlayer[p.id];
      dev.className = d ? 'devices' : 'devices muted';
      dev.textContent = d ? deviceText(d) : 'Not subscribed yet';

      label.append(box, nameEl, dev);
      li.append(label);
      list.append(li);
    }
  }

  function openEditor(group: NotificationGroup | null, prefillPlayerIds?: string[]) {
    editingGroupId = group ? group.id : null;
    editorMembers.clear();
    if (group) {
      for (const id of group.playerIds) editorMembers.add(id);
    } else if (prefillPlayerIds) {
      for (const id of prefillPlayerIds) editorMembers.add(id);
    }

    $('editor-title').textContent = group ? `Edit "${group.name}"` : 'Create Notification Group';
    ($('group-name') as HTMLInputElement).value = group?.name || '';
    ($('group-desc') as HTMLInputElement).value = group?.description || '';
    ($('group-tpl-title') as HTMLInputElement).value = group?.defaultMessage?.title || '';
    ($('group-tpl-body') as HTMLTextAreaElement).value = group?.defaultMessage?.body || '';
    ($('group-tpl-url') as HTMLSelectElement).value = group?.defaultMessage?.url || '/admin/fixtures';
    ($('group-player-search') as HTMLInputElement).value = '';
    $('editor-error').style.display = 'none';
    $('groups-status').style.display = 'none';

    renderQuickFills();
    renderEditorChips();
    renderEditorPlayerList();
    updateEditorCounts();

    $('group-editor').hidden = false;
    $('group-name').focus();
  }

  function closeEditor() {
    editingGroupId = null;
    $('group-editor').hidden = true;
    $('editor-error').style.display = 'none';
  }

  $('new-group-btn').addEventListener('click', () => openEditor(null));
  $('editor-close-btn').addEventListener('click', closeEditor);
  $('editor-cancel-btn').addEventListener('click', closeEditor);
  $('group-clear-members').addEventListener('click', () => {
    editorMembers.clear();
    renderEditorChips();
    renderEditorPlayerList();
    updateEditorCounts();
  });
  $('group-player-search').addEventListener('input', renderEditorPlayerList);
  $('group-name').addEventListener('input', updateEditorCounts);
  $('group-desc').addEventListener('input', updateEditorCounts);
  $('group-tpl-title').addEventListener('input', updateEditorCounts);
  $('group-tpl-body').addEventListener('input', updateEditorCounts);

  $('editor-save-btn').addEventListener('click', async () => {
    const name = ($('group-name') as HTMLInputElement).value.trim();
    const description = ($('group-desc') as HTMLInputElement).value.trim();
    const tplTitle = ($('group-tpl-title') as HTMLInputElement).value.trim();
    const tplBody = ($('group-tpl-body') as HTMLTextAreaElement).value.trim();
    const tplUrl = ($('group-tpl-url') as HTMLSelectElement).value;
    const errEl = $('editor-error');
    const saveBtn = $('editor-save-btn') as HTMLButtonElement;

    errEl.style.display = 'none';
    if (!name) {
      errEl.textContent = 'Please enter a group name.';
      errEl.style.display = 'block';
      return;
    }
    if (editorMembers.size === 0) {
      errEl.textContent = 'Please select at least one player for the group.';
      errEl.style.display = 'block';
      return;
    }
    if ((tplTitle && !tplBody) || (!tplTitle && tplBody)) {
      errEl.textContent = 'Default message needs both a title and a body (or leave both blank).';
      errEl.style.display = 'block';
      return;
    }

    const payload: Record<string, unknown> = {
      ...(editingGroupId ? { id: editingGroupId } : {}),
      name,
      description,
      playerIds: [...editorMembers],
      defaultMessage: tplTitle && tplBody ? { title: tplTitle, body: tplBody, url: tplUrl } : null,
    };

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';
    try {
      const endpoint = editingGroupId
        ? '/.netlify/functions/notification-groups-update'
        : '/.netlify/functions/notification-groups-create';
      const res = await fetch(endpoint, {
        method: editingGroupId ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) {
        errEl.textContent = data.error || 'Could not save group.';
        errEl.style.display = 'block';
      } else {
        const wasEdit = !!editingGroupId;
        closeEditor();
        await loadGroups();
        const statusEl = $('groups-status');
        statusEl.className = 'result-box success';
        statusEl.textContent = wasEdit
          ? `Updated group "${data.group.name}".`
          : `Created group "${data.group.name}".`;
        statusEl.style.display = 'block';
      }
    } catch {
      errEl.textContent = 'Network error. Please try again.';
      errEl.style.display = 'block';
    }
    saveBtn.disabled = false;
    saveBtn.textContent = 'Save Group';
  });

  async function deleteGroup(g: NotificationGroup) {
    if (!confirm(`Delete notification group "${g.name}"? This cannot be undone.`)) return;
    const statusEl = $('groups-status');
    statusEl.style.display = 'none';
    try {
      const res = await fetch(`/.netlify/functions/notification-groups-delete?id=${encodeURIComponent(g.id)}`, {
        method: 'DELETE',
      });
      const data = await res.json();
      if (!res.ok) {
        statusEl.className = 'result-box error';
        statusEl.textContent = data.error || 'Could not delete group.';
        statusEl.style.display = 'block';
        return;
      }
      selectedGroupIds.delete(g.id);
      if (editingGroupId === g.id) closeEditor();
      await loadGroups();
      statusEl.className = 'result-box success';
      statusEl.textContent = `Deleted group "${g.name}".`;
      statusEl.style.display = 'block';
    } catch {
      statusEl.className = 'result-box error';
      statusEl.textContent = 'Network error while deleting group.';
      statusEl.style.display = 'block';
    }
  }

  // ---- Data loaders ----
  async function loadSubscriberCount() {
    try {
      const res = await fetch('/.netlify/functions/push-subscriber-count');
      if (!res.ok) throw new Error();
      const data = await res.json();
      byPlayer = data.byPlayer || {};
      const players = Object.keys(byPlayer).length;
      $('subscriber-count').textContent =
        `${players} player${players !== 1 ? 's' : ''} · ${data.count} device${data.count !== 1 ? 's' : ''} (${data.app ?? 0} app, ${data.web ?? data.count} browser)`;
      renderPicker();
      renderSendGroups();
      renderManageGroups();
      if (!$('group-editor').hidden) {
        renderEditorPlayerList();
        updateEditorCounts();
      }
    } catch {
      $('subscriber-count').textContent = 'Could not load subscriber count';
    }
  }

  async function loadNames() {
    try {
      const res = await fetch('/.netlify/functions/players-list');
      if (!res.ok) return;
      const players = await res.json();
      names = Object.fromEntries(
        players.map((p: any) => [p.id, `${p.firstName ?? ''} ${p.lastName ?? ''}`.trim()])
      );
      allActivePlayers = players
        .filter(
          (p: any) =>
            !p.accountDeletedAt &&
            p.isActive !== false &&
            (!p.registrationStatus || p.registrationStatus === 'approved')
        )
        .map((p: any) => ({
          id: p.id,
          name: `${p.firstName ?? ''} ${p.lastName ?? ''}`.trim(),
          active: true,
        }))
        .filter((p: SimplePlayer) => !!p.name)
        .sort((a: SimplePlayer, b: SimplePlayer) => a.name.localeCompare(b.name));

      renderPicker();
      renderSendGroups();
      renderManageGroups();
      if (!$('group-editor').hidden) {
        renderEditorChips();
        renderEditorPlayerList();
        updateEditorCounts();
      }
    } catch {}
  }

  async function loadGroups() {
    try {
      const res = await fetch('/.netlify/functions/notification-groups-list');
      if (!res.ok) throw new Error();
      const data = await res.json();
      groups = Array.isArray(data.groups) ? data.groups : [];
      quickFills = Array.isArray(data.quickFills) ? data.quickFills : [];
      activeSeasonName = data.activeSeasonName || null;

      // Drop any stale selectedGroupIds
      const validIds = new Set(groups.map((g) => g.id));
      for (const id of [...selectedGroupIds]) {
        if (!validIds.has(id)) selectedGroupIds.delete(id);
      }

      renderSendGroups();
      renderManageGroups();
      if (!$('group-editor').hidden) renderQuickFills();
    } catch {
      $('manage-groups-list').innerHTML = '<div class="empty-card">Could not load notification groups.</div>';
    }
  }

  loadSubscriberCount();
  loadNames();
  loadGroups();

  document.querySelectorAll('input[name="audience"]').forEach((r) =>
    r.addEventListener('change', () => {
      const mode = audience();
      $('group-picker').hidden = mode !== 'groups';
      $('picker').hidden = mode !== 'chosen';
      updateSendLabel();
    })
  );
  $('player-search').addEventListener('input', renderPicker);

  // Preset selection
  document.querySelectorAll<HTMLElement>('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-btn').forEach((b) => b.classList.remove('selected'));
      btn.classList.add('selected');
      applyMessageTemplate({
        title: btn.dataset.title || '',
        body: btn.dataset.body || '',
        url: btn.dataset.url || '/myfixtures',
      });
    });
  });

  // Live preview + char counts
  function updatePreview() {
    $('preview-title').textContent = ($('notif-title') as HTMLInputElement).value || 'Notification title';
    $('preview-body').textContent = ($('notif-body') as HTMLTextAreaElement).value || 'Notification message will appear here.';
  }

  function updateCharCounts() {
    $('title-count').textContent = `${($('notif-title') as HTMLInputElement).value.length} / 60`;
    $('body-count').textContent = `${($('notif-body') as HTMLTextAreaElement).value.length} / 140`;
  }

  $('notif-title').addEventListener('input', () => { updatePreview(); updateCharCounts(); });
  $('notif-body').addEventListener('input', () => { updatePreview(); updateCharCounts(); });

  // Send
  $('send-btn').addEventListener('click', async () => {
    const title = ($('notif-title') as HTMLInputElement).value.trim();
    const body = ($('notif-body') as HTMLTextAreaElement).value.trim();
    const url = ($('notif-url') as HTMLSelectElement).value;
    const resultEl = $('send-result');
    const sendBtn = $('send-btn') as HTMLButtonElement;
    const mode = audience();

    if (!title || !body) {
      resultEl.className = 'result-box error';
      resultEl.textContent = 'Please fill in both title and message.';
      resultEl.style.display = 'block';
      return;
    }
    if (mode === 'chosen' && chosen.size === 0) return;
    if (mode === 'groups' && selectedGroupIds.size === 0) return;

    const payload: Record<string, unknown> = { title, body, url };
    if (mode === 'groups') payload.groupIds = [...selectedGroupIds];
    else if (mode === 'chosen') payload.playerIds = [...chosen];

    sendBtn.disabled = true;
    $('send-label').textContent = 'Sending...';
    resultEl.style.display = 'none';

    try {
      const res = await fetch('/.netlify/functions/push-send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      resultEl.style.display = 'block';
      if (res.ok) {
        resultEl.className = 'result-box success';
        const groupSuffix = Array.isArray(data.groups) && data.groups.length
          ? ` (${data.groups.join(', ')})`
          : '';
        resultEl.textContent = !data.total
          ? `No devices to send to: nobody in the selected audience${groupSuffix} has notifications on.`
          : `Sent to ${data.sent} of ${data.total} device${data.total !== 1 ? 's' : ''}${groupSuffix}.${data.expired > 0 ? ` (${data.expired} expired removed)` : ''}`;
        loadSubscriberCount();
      } else {
        resultEl.className = 'result-box error';
        resultEl.textContent = data.error || 'Failed to send notification.';
      }
    } catch {
      resultEl.style.display = 'block';
      resultEl.className = 'result-box error';
      resultEl.textContent = 'Network error. Please try again.';
    }
    sendBtn.disabled = false;
    updateSendLabel();
  });

  updateSendLabel();
</script>
