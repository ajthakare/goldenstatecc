  }

  .manage-groups-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .empty-card,
  .manage-groups-list :global(.empty-card),
  .send-groups-list :global(.empty-card) {
    background: #FAF7F2;
    border: 1px dashed #D6CEC4;
    border-radius: 0.875rem;
