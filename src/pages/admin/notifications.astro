---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';

const cookieHeader = Astro.request.headers.get('cookie');
let authenticated = false;
let username = '';
let userRole = 'admin';
let isAdminUser = false;

if (cookieHeader) {
  try {
    const response = await fetch(
      `${Astro.url.origin}/.netlify/functions/auth-check`,
      { headers: { cookie: cookieHeader } }
    );
    const data = await response.json();
    authenticated = data.authenticated;
    username = data.user?.firstName || data.user?.username || '';
    userRole = data.user?.role_auth || data.user?.role || 'admin';
    isAdminUser = userRole === 'admin' || userRole === 'super_admin';
  } catch {
    authenticated = false;
  }
}

if (!authenticated) return Astro.redirect('/admin/login');
if (!isAdminUser) return Astro.redirect('/');
---

<AdminLayout title="Send Notification - GSCC Admin" username={username} userRole={userRole} activePage="notifications">
  <div class="notif-page">

    <div class="page-header">
      <h1 class="page-title">Send Notification</h1>
      <p class="page-description">Push a notification to all subscribed players</p>
    </div>

    <div class="notif-card">

      <!-- Subscriber count -->
      <div class="subscriber-bar">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
        <span id="subscriber-count">Loading subscriber count...</span>
      </div>

      <!-- Quick presets -->
      <div class="section-label">Quick presets</div>
      <div class="presets">
        <button class="preset-btn" data-title="Vote for Next Week's Fixtures" data-body="Check upcoming matches and mark your availability before voting closes." data-url="/myfixtures">
          <span class="preset-icon">📅</span>
          <div>
            <div class="preset-title">Vote for fixtures</div>
            <div class="preset-desc">Prompts players to mark availability</div>
          </div>
        </button>
        <button class="preset-btn" data-title="Voting Closes in 2 Hours" data-body="Last chance! Mark your availability for this weekend's fixtures now." data-url="/myfixtures">
          <span class="preset-icon">⏰</span>
          <div>
            <div class="preset-title">Voting closing soon</div>
            <div class="preset-desc">Urgency reminder before deadline</div>
          </div>
        </button>
        <button class="preset-btn" data-title="Practice Vote is Open" data-body="Let us know if you're coming to practice this week." data-url="/mypractice">
          <span class="preset-icon">🏏</span>
          <div>
            <div class="preset-title">Practice vote open</div>
            <div class="preset-desc">Asks players to respond for practice</div>
          </div>
        </button>
      </div>

      <div class="divider"></div>

      <!-- Custom fields -->
      <div class="section-label">Message</div>
      <div class="fields">
        <div class="field">
          <label for="notif-title">Title <span class="char-count" id="title-count">0 / 60</span></label>
          <input id="notif-title" type="text" maxlength="60" placeholder="e.g. Vote for Next Week's Fixtures" />
        </div>
        <div class="field">
          <label for="notif-body">Body <span class="char-count" id="body-count">0 / 140</span></label>
          <textarea id="notif-body" maxlength="140" rows="3" placeholder="e.g. Check upcoming matches and mark your availability before voting closes."></textarea>
        </div>
        <div class="field">
          <label for="notif-url">Opens</label>
          <select id="notif-url">
            <option value="/myfixtures">My Fixtures page</option>
            <option value="/mypractice">My Practice page</option>
          </select>
        </div>
      </div>

      <!-- Preview -->
      <div class="section-label" style="margin-top:1.5rem;">Preview</div>
      <div class="preview-box">
        <div class="preview-icon">
          <img src="/icons/icon-192.png" alt="GSCC" width="36" height="36" style="border-radius:8px;" />
        </div>
        <div class="preview-content">
          <div class="preview-title" id="preview-title">Notification title</div>
          <div class="preview-body" id="preview-body">Notification message will appear here.</div>
        </div>
      </div>

      <!-- Result -->
      <div id="send-result" class="result-box" style="display:none;"></div>

      <!-- Send button -->
      <button id="send-btn" class="send-btn">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        Send to All Players
      </button>

    </div>
  </div>
</AdminLayout>

<style>
  .notif-page {
    width: 100%;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin: 0 0 0.25rem;
  }

  .page-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .notif-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 600px;
  }

  .subscriber-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: var(--color-bg-card, #f9fafb);
    border-radius: 0.5rem;
    padding: 0.625rem 0.875rem;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .presets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .preset-btn {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    background: var(--color-bg-card, #f9fafb);
    border: 1px solid var(--color-border);
    border-radius: 0.625rem;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, border-color 0.15s;
    width: 100%;
  }

  .preset-btn:hover {
    background: #e8f0f8;
    border-color: #8C1D18;
  }

  .preset-btn.selected {
    background: #dbeafe;
    border-color: #8C1D18;
  }

  .preset-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .preset-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-heading);
  }

  .preset-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.125rem;
  }

  .divider {
    height: 1px;
    background: var(--color-border);
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-body);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .char-count {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .field input,
  .field textarea,
  .field select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-family: inherit;
    color: var(--color-text-body);
    background: white;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s;
  }

  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    border-color: #8C1D18;
  }

  .field textarea {
    resize: vertical;
  }

  .preview-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: #f1f5f9;
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
  }

  .preview-icon {
    flex-shrink: 0;
  }

  .preview-content {
    flex: 1;
    min-width: 0;
  }

  .preview-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.2rem;
  }

  .preview-body {
    font-size: 0.75rem;
    color: #475569;
    line-height: 1.4;
  }

  .result-box {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }

  .result-box.success {
    background: #f0fdf4;
    color: #166534;
  }

  .result-box.error {
    background: #fef2f2;
    color: #991b1b;
  }

  .send-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem;
    background: #1A1614;
    color: white;
    border: none;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }

  .send-btn:hover:not(:disabled) {
    background: #2a4a65;
  }

  .send-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>

<script>
  // Load subscriber count
  async function loadSubscriberCount() {
    try {
      const res = await fetch('/.netlify/functions/push-subscriber-count');
      if (res.ok) {
        const data = await res.json();
        document.getElementById('subscriber-count').textContent =
          `${data.count} player${data.count !== 1 ? 's' : ''} subscribed`;
      } else {
        document.getElementById('subscriber-count').textContent = 'Could not load subscriber count';
      }
    } catch {
      document.getElementById('subscriber-count').textContent = 'Could not load subscriber count';
    }
  }

  loadSubscriberCount();

  // Preset selection
  document.querySelectorAll('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      const titleEl = document.getElementById('notif-title') as HTMLInputElement;
      const bodyEl = document.getElementById('notif-body') as HTMLTextAreaElement;
      const urlEl = document.getElementById('notif-url') as HTMLSelectElement;
      titleEl.value = btn.dataset.title;
      bodyEl.value = btn.dataset.body;
      urlEl.value = btn.dataset.url;
      updatePreview();
      updateCharCounts();
    });
  });

  // Live preview + char counts
  function updatePreview() {
    const title = (document.getElementById('notif-title') as HTMLInputElement).value || 'Notification title';
    const body = (document.getElementById('notif-body') as HTMLTextAreaElement).value || 'Notification message will appear here.';
    document.getElementById('preview-title').textContent = title;
    document.getElementById('preview-body').textContent = body;
  }

  function updateCharCounts() {
    const title = (document.getElementById('notif-title') as HTMLInputElement).value;
    const body = (document.getElementById('notif-body') as HTMLTextAreaElement).value;
    document.getElementById('title-count').textContent = `${title.length} / 60`;
    document.getElementById('body-count').textContent = `${body.length} / 140`;
  }

  document.getElementById('notif-title').addEventListener('input', () => { updatePreview(); updateCharCounts(); });
  document.getElementById('notif-body').addEventListener('input', () => { updatePreview(); updateCharCounts(); });

  // Send
  document.getElementById('send-btn').addEventListener('click', async () => {
    const title = (document.getElementById('notif-title') as HTMLInputElement).value.trim();
    const body = (document.getElementById('notif-body') as HTMLTextAreaElement).value.trim();
    const url = (document.getElementById('notif-url') as HTMLSelectElement).value;
    const resultEl = document.getElementById('send-result');
    const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;

    if (!title || !body) {
      resultEl.className = 'result-box error';
      resultEl.textContent = 'Please fill in both title and message.';
      resultEl.style.display = 'block';
      return;
    }

    sendBtn.disabled = true;
    sendBtn.textContent = 'Sending...';
    resultEl.style.display = 'none';

    try {
      const res = await fetch('/.netlify/functions/push-send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, body, url }),
      });
      const data = await res.json();

      resultEl.style.display = 'block';
      if (res.ok) {
        resultEl.className = 'result-box success';
        resultEl.textContent = `Sent to ${data.sent} player${data.sent !== 1 ? 's' : ''}.${data.expired > 0 ? ` (${data.expired} expired subscriptions removed)` : ''}`;
        sendBtn.textContent = '✓ Sent';
        setTimeout(() => {
          sendBtn.disabled = false;
          sendBtn.innerHTML = '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg> Send to All Players';
        }, 3000);
        loadSubscriberCount();
      } else {
        resultEl.className = 'result-box error';
        resultEl.textContent = data.error || 'Failed to send notification.';
        sendBtn.disabled = false;
        sendBtn.innerHTML = '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg> Send to All Players';
      }
    } catch {
      resultEl.style.display = 'block';
      resultEl.className = 'result-box error';
      resultEl.textContent = 'Network error. Please try again.';
      sendBtn.disabled = false;
      sendBtn.innerHTML = '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg> Send to All Players';
    }
  });
</script>
