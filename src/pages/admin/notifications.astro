---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';

const cookieHeader = Astro.request.headers.get('cookie');
let authenticated = false;
let username = '';
let userRole = 'admin';
let isAdminUser = false;

if (cookieHeader) {
  try {
    const response = await fetch(
      `${Astro.url.origin}/.netlify/functions/auth-check`,
      { headers: { cookie: cookieHeader } }
    );
    const data = await response.json();
    authenticated = data.authenticated;
    username = data.user?.firstName || data.user?.username || '';
    userRole = data.user?.role_auth || data.user?.role || 'admin';
    isAdminUser = userRole === 'admin' || userRole === 'super_admin';
  } catch {
    authenticated = false;
  }
}

if (!authenticated) return Astro.redirect('/admin/login');
if (!isAdminUser) return Astro.redirect('/');
---

<AdminLayout title="Send Notification - GSCC Admin" username={username} userRole={userRole} activePage="notifications">
  <div class="notif-page">

    <div class="page-header">
      <h1 class="page-title">Send Notification</h1>
      <p class="page-description">Push a notification to players' phones and browsers</p>
    </div>

    <div class="notif-card">

      <!-- Subscriber count -->
      <div class="subscriber-bar">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
        <span id="subscriber-count">Loading subscriber count...</span>
      </div>

      <!-- Quick presets -->
      <div class="section-label">Quick presets</div>
      <div class="presets">
        <button class="preset-btn" data-title="Vote for Next Week's Fixtures" data-body="Check upcoming matches and mark your availability before voting closes." data-url="/myfixtures">
          <span class="preset-icon">📅</span>
          <div>
            <div class="preset-title">Vote for fixtures</div>
            <div class="preset-desc">Prompts players to mark availability</div>
          </div>
        </button>
        <button class="preset-btn" data-title="Voting Closes in 2 Hours" data-body="Last chance! Mark your availability for this weekend's fixtures now." data-url="/myfixtures">
          <span class="preset-icon">⏰</span>
          <div>
            <div class="preset-title">Voting closing soon</div>
            <div class="preset-desc">Urgency reminder before deadline</div>
          </div>
        </button>
        <button class="preset-btn" data-title="Practice Vote is Open" data-body="Let us know if you're coming to practice this week." data-url="/mypractice">
          <span class="preset-icon">🏏</span>
          <div>
            <div class="preset-title">Practice vote open</div>
            <div class="preset-desc">Asks players to respond for practice</div>
          </div>
        </button>
      </div>

      <div class="divider"></div>

      <!-- Audience -->
      <div class="section-label">Send to</div>
      <div class="audience" role="radiogroup" aria-label="Send to">
        <label class="audience-option"><input type="radio" name="audience" value="all" checked /> Everyone with notifications on</label>
        <label class="audience-option"><input type="radio" name="audience" value="chosen" /> Chosen players</label>
      </div>
      <div id="picker" class="picker" hidden>
        <input id="player-search" type="search" placeholder="Search players with notifications on" autocomplete="off" />
        <div id="chosen-chips" class="chips"></div>
        <ul id="player-list" class="player-list" aria-label="Players with notifications on"></ul>
        <p id="picker-note" class="picker-note"></p>
      </div>

      <div class="divider"></div>

      <!-- Custom fields -->
      <div class="section-label">Message</div>
      <div class="fields">
        <div class="field">
          <label for="notif-title">Title <span class="char-count" id="title-count">0 / 60</span></label>
          <input id="notif-title" type="text" maxlength="60" placeholder="e.g. Vote for Next Week's Fixtures" />
        </div>
        <div class="field">
          <label for="notif-body">Body <span class="char-count" id="body-count">0 / 140</span></label>
          <textarea id="notif-body" maxlength="140" rows="3" placeholder="e.g. Check upcoming matches and mark your availability before voting closes."></textarea>
        </div>
        <div class="field">
          <label for="notif-url">Opens</label>
          <select id="notif-url">
            <option value="/myfixtures">My Fixtures page</option>
            <option value="/mypractice">My Practice page</option>
            <option value="/fixtures">Fixtures page</option>
            <option value="/feed">Club Feed</option>
            <option value="/profile">Profile</option>
          </select>
        </div>
      </div>

      <!-- Preview -->
      <div class="section-label" style="margin-top:1.5rem;">Preview</div>
      <div class="preview-box">
        <div class="preview-icon">
          <img src="/icons/icon-192.png" alt="GSCC" width="36" height="36" style="border-radius:8px;" />
        </div>
        <div class="preview-content">
          <div class="preview-title" id="preview-title">Notification title</div>
          <div class="preview-body" id="preview-body">Notification message will appear here.</div>
        </div>
      </div>

      <!-- Result -->
      <div id="send-result" class="result-box" style="display:none;"></div>

      <!-- Send button -->
      <button id="send-btn" class="send-btn">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <span id="send-label">Send to everyone</span>
      </button>

    </div>
  </div>
</AdminLayout>

<style>
  .notif-page {
    width: 100%;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin: 0 0 0.25rem;
  }

  .page-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .notif-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 600px;
  }

  .subscriber-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: var(--color-bg-card, #f9fafb);
    border-radius: 0.5rem;
    padding: 0.625rem 0.875rem;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .presets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .preset-btn {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    background: var(--color-bg-card, #f9fafb);
    border: 1px solid var(--color-border);
    border-radius: 0.625rem;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, border-color 0.15s;
    width: 100%;
  }

  .preset-btn:hover {
    background: #e8f0f8;
    border-color: #8C1D18;
  }

  .preset-btn.selected {
    background: #dbeafe;
    border-color: #8C1D18;
  }

  .preset-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .preset-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-heading);
  }

  .preset-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.125rem;
  }

  .divider {
    height: 1px;
    background: var(--color-border);
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-body);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .char-count {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .field input,
  .field textarea,
  .field select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-family: inherit;
    color: var(--color-text-body);
    background: white;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s;
  }

  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    border-color: #8C1D18;
  }

  .field textarea {
    resize: vertical;
  }

  .preview-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: #f1f5f9;
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
  }

  .preview-icon {
    flex-shrink: 0;
  }

  .preview-content {
    flex: 1;
    min-width: 0;
  }

  .preview-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.2rem;
  }

  .preview-body {
    font-size: 0.75rem;
    color: #475569;
    line-height: 1.4;
  }

  .result-box {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }

  .result-box.success {
    background: #f0fdf4;
    color: #166534;
  }

  .result-box.error {
    background: #fef2f2;
    color: #991b1b;
  }

  .send-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem;
    background: #1A1614;
    color: white;
    border: none;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }

  .send-btn:hover:not(:disabled) {
    background: #2a4a65;
  }

  .send-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .audience { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-bottom: 0.75rem; }
  .audience-option { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; color: var(--color-text-body); cursor: pointer; }
  .picker { display: grid; gap: 0.6rem; }
  .picker input[type="search"] { width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--color-border-strong); border-radius: 8px; font: inherit; background: var(--color-bg-input); color: var(--color-text-body); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--color-maroon-100, #F6E7E4); color: var(--color-primary); font-size: 0.8rem; font-weight: 600; border: 0; cursor: pointer; }
  .player-list { list-style: none; margin: 0; padding: 0; max-height: 260px; overflow-y: auto; border: 1px solid var(--color-border); border-radius: 8px; }
  .player-list li { border-bottom: 1px solid var(--color-border); }
  .player-list li:last-child { border-bottom: 0; }
  .player-list label { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.75rem; cursor: pointer; font-size: 0.9rem; }
  .player-list .devices { margin-left: auto; font-size: 0.75rem; color: var(--color-text-muted); white-space: nowrap; }
  .picker-note { margin: 0; font-size: 0.8rem; color: var(--color-text-muted); }
</style>

<script>
  type Devices = { web: number; app: number };
  let byPlayer: Record<string, Devices> = {};
  let names: Record<string, string> = {};
  const chosen = new Set<string>();

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const audience = () => (document.querySelector('input[name="audience"]:checked') as HTMLInputElement).value;

  function deviceText(d: Devices) {
    const parts = [];
    if (d.app) parts.push(`${d.app} app`);
    if (d.web) parts.push(`${d.web} browser`);
    return parts.join(' · ');
  }

  function updateSendLabel() {
    const n = chosen.size;
    $('send-label').textContent = audience() === 'all' ? 'Send to everyone' : n === 0 ? 'Choose players to send to' : `Send to ${n} player${n !== 1 ? 's' : ''}`;
    ($('send-btn') as HTMLButtonElement).disabled = audience() === 'chosen' && n === 0;
  }

  function renderPicker() {
    const q = ($('player-search') as HTMLInputElement).value.trim().toLowerCase();
    const ids = Object.keys(byPlayer)
      .filter((id) => names[id])
      .sort((a, b) => names[a].localeCompare(names[b]));
    const list = $('player-list');
    list.replaceChildren();
    for (const id of ids.filter((id) => !q || names[id].toLowerCase().includes(q))) {
      const li = document.createElement('li');
      const label = document.createElement('label');
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = chosen.has(id);
      box.addEventListener('change', () => { box.checked ? chosen.add(id) : chosen.delete(id); renderChips(); updateSendLabel(); });
      const name = document.createElement('span');
      name.textContent = names[id];
      const devices = document.createElement('span');
      devices.className = 'devices';
      devices.textContent = deviceText(byPlayer[id]);
      label.append(box, name, devices);
      li.append(label);
      list.append(li);
    }
    $('picker-note').textContent = ids.length
      ? 'Only players with notifications turned on are listed.'
      : 'No players have notifications turned on yet.';
  }

  function renderChips() {
    const chips = $('chosen-chips');
    chips.replaceChildren();
    for (const id of chosen) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'chip';
      chip.textContent = `${names[id] || 'Player'} ✕`;
      chip.setAttribute('aria-label', `Remove ${names[id] || 'player'}`);
      chip.addEventListener('click', () => { chosen.delete(id); renderChips(); renderPicker(); updateSendLabel(); });
      chips.append(chip);
    }
  }

  // Subscriber count, devices per player, and player names
  async function loadSubscriberCount() {
    try {
      const res = await fetch('/.netlify/functions/push-subscriber-count');
      if (!res.ok) throw new Error();
      const data = await res.json();
      byPlayer = data.byPlayer || {};
      const players = Object.keys(byPlayer).length;
      $('subscriber-count').textContent =
        `${players} player${players !== 1 ? 's' : ''} · ${data.count} device${data.count !== 1 ? 's' : ''} (${data.app ?? 0} app, ${data.web ?? data.count} browser)`;
      renderPicker();
    } catch {
      $('subscriber-count').textContent = 'Could not load subscriber count';
    }
  }

  async function loadNames() {
    try {
      const res = await fetch('/.netlify/functions/players-list');
      if (!res.ok) return;
      const players = await res.json();
      names = Object.fromEntries(players.map((p: any) => [p.id, `${p.firstName ?? ''} ${p.lastName ?? ''}`.trim()]));
      renderPicker();
    } catch {}
  }

  loadSubscriberCount();
  loadNames();

  document.querySelectorAll('input[name="audience"]').forEach((r) =>
    r.addEventListener('change', () => { $('picker').hidden = audience() !== 'chosen'; updateSendLabel(); })
  );
  $('player-search').addEventListener('input', renderPicker);

  // Preset selection
  document.querySelectorAll<HTMLElement>('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-btn').forEach((b) => b.classList.remove('selected'));
      btn.classList.add('selected');
      ($('notif-title') as HTMLInputElement).value = btn.dataset.title || '';
      ($('notif-body') as HTMLTextAreaElement).value = btn.dataset.body || '';
      ($('notif-url') as HTMLSelectElement).value = btn.dataset.url || '/myfixtures';
      updatePreview();
      updateCharCounts();
    });
  });

  // Live preview + char counts
  function updatePreview() {
    $('preview-title').textContent = ($('notif-title') as HTMLInputElement).value || 'Notification title';
    $('preview-body').textContent = ($('notif-body') as HTMLTextAreaElement).value || 'Notification message will appear here.';
  }

  function updateCharCounts() {
    $('title-count').textContent = `${($('notif-title') as HTMLInputElement).value.length} / 60`;
    $('body-count').textContent = `${($('notif-body') as HTMLTextAreaElement).value.length} / 140`;
  }

  $('notif-title').addEventListener('input', () => { updatePreview(); updateCharCounts(); });
  $('notif-body').addEventListener('input', () => { updatePreview(); updateCharCounts(); });

  // Send
  $('send-btn').addEventListener('click', async () => {
    const title = ($('notif-title') as HTMLInputElement).value.trim();
    const body = ($('notif-body') as HTMLTextAreaElement).value.trim();
    const url = ($('notif-url') as HTMLSelectElement).value;
    const resultEl = $('send-result');
    const sendBtn = $('send-btn') as HTMLButtonElement;
    const toChosen = audience() === 'chosen';

    if (!title || !body) {
      resultEl.className = 'result-box error';
      resultEl.textContent = 'Please fill in both title and message.';
      resultEl.style.display = 'block';
      return;
    }
    if (toChosen && chosen.size === 0) return;

    sendBtn.disabled = true;
    $('send-label').textContent = 'Sending...';
    resultEl.style.display = 'none';

    try {
      const res = await fetch('/.netlify/functions/push-send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, body, url, ...(toChosen ? { playerIds: [...chosen] } : {}) }),
      });
      const data = await res.json();
      resultEl.style.display = 'block';
      if (res.ok) {
        resultEl.className = 'result-box success';
        resultEl.textContent = !data.total
          ? 'No devices to send to: nobody chosen has notifications on.'
          : `Sent to ${data.sent} of ${data.total} device${data.total !== 1 ? 's' : ''}.${data.expired > 0 ? ` (${data.expired} expired removed)` : ''}`;
        loadSubscriberCount();
      } else {
        resultEl.className = 'result-box error';
        resultEl.textContent = data.error || 'Failed to send notification.';
      }
    } catch {
      resultEl.style.display = 'block';
      resultEl.className = 'result-box error';
      resultEl.textContent = 'Network error. Please try again.';
    }
    sendBtn.disabled = false;
    updateSendLabel();
  });

  updateSendLabel();
</script>
