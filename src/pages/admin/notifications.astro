    gap: 0.65rem;
  }

  .manage-groups-list :global(.group-card-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .manage-groups-list :global(.group-card-title) {
    font-size: 1rem;
