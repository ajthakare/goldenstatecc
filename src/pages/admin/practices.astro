---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';

// Check authentication
const cookieHeader = Astro.request.headers.get('cookie');
let authenticated = false;
let username = '';
let userRole = 'admin';
let isAdminUser = false;

if (cookieHeader) {
  try {
    const response = await fetch(
      `${Astro.url.origin}/.netlify/functions/auth-check`,
      {
        headers: {
          cookie: cookieHeader,
        },
      }
    );
    const data = await response.json();
    authenticated = data.authenticated;
    username = data.user?.firstName || data.user?.username || '';
    userRole = data.user?.role_auth || data.user?.role || 'admin';
    isAdminUser = userRole === 'admin' || userRole === 'super_admin';
  } catch (error) {
    authenticated = false;
  }
}

// Redirect to login if not authenticated
if (!authenticated) {
  return Astro.redirect('/admin/login');
}

// Redirect to homepage if authenticated but not admin/super_admin
if (!isAdminUser) {
  return Astro.redirect('/');
}
---

<AdminLayout title="Practice Sessions - GSCC Admin" username={username} userRole={userRole} activePage="practices">
  <div class="practices-page">
    <!-- Page Header -->
    <div class="page-header">
      <h1 class="page-title">Practice Sessions</h1>
      <p class="page-description">Manage net and field practice sessions</p>
      <p id="season-info" class="season-info" style="margin-top: 0.5rem; font-size: 0.9rem; color: #6b7280;">
        <span id="season-name"></span>
      </p>
    </div>

    <!-- Practice settings: what the Saturday job creates for the next week -->
    <details id="practice-settings" class="card ps-card">
      <summary class="ps-summary">
        <span class="ps-summary-title">⚙️ Weekly practice settings</span>
        <span id="settings-summary-text" class="ps-summary-text">Loading…</span>
      </summary>
      <form id="practice-settings-form" class="ps-form">
        <div class="ps-row">
          <span class="ps-label">Wednesday nets</span>
          <div class="ps-choice">
            <label><input type="radio" name="wednesdayNets" value="single" /> One session</label>
            <label><input type="radio" name="wednesdayNets" value="split" /> Two slots</label>
          </div>
        </div>
        <div data-format="single">
          <div class="ps-row">
            <span class="ps-label">Time</span>
            <div class="ps-times">
              <input type="time" name="singleStart" class="form-input" required aria-label="Time start" />
              <span class="ps-dash">–</span>
              <input type="time" name="singleEnd" class="form-input" required aria-label="Time end" />
            </div>
          </div>
        </div>
        <div data-format="split">
          <div class="ps-row">
            <span class="ps-label">Slot 1</span>
            <div class="ps-times">
              <input type="time" name="slot1Start" class="form-input" required aria-label="Slot 1 start" />
              <span class="ps-dash">–</span>
              <input type="time" name="slot1End" class="form-input" required aria-label="Slot 1 end" />
            </div>
          </div>
          <div class="ps-row">
            <span class="ps-label">Slot 2</span>
            <div class="ps-times">
              <input type="time" name="slot2Start" class="form-input" required aria-label="Slot 2 start" />
              <span class="ps-dash">–</span>
              <input type="time" name="slot2End" class="form-input" required aria-label="Slot 2 end" />
            </div>
          </div>
          <div class="ps-row">
            <label class="ps-label" for="slot-capacity">Batting places</label>
            <div class="ps-inline">
              <input type="number" id="slot-capacity" name="slotCapacity" class="form-input ps-number" min="1" max="50" step="1" required />
              <span class="ps-hint">per slot</span>
            </div>
          </div>
        </div>
        <div class="ps-row ps-row-switch">
          <label class="ps-label" for="friday-field">Friday field practice</label>
          <label class="ps-switch">
            <input type="checkbox" id="friday-field" name="fridayField" role="switch" />
            <span class="ps-switch-track" aria-hidden="true"></span>
          </label>
        </div>
        <div class="ps-actions">
          <button type="submit" id="save-settings-btn" class="btn-primary">Save settings</button>
          <span id="settings-updated" class="ps-hint"></span>
        </div>
      </form>
    </details>

    <!-- Create / edit practice form (hidden initially). Net sessions follow the weekly settings -->
    <div id="create-form-container" style="display: none; margin-bottom: 2rem;">
      <div class="card ps-card">
        <div class="ps-form-header">
          <h2 id="create-form-title" class="ps-form-title">Create Practice</h2>
          <button id="cancel-create-btn" class="btn-text">Cancel</button>
        </div>
        <form id="create-practice-form" class="ps-form">
          <div class="ps-row">
            <span class="ps-label">Type</span>
            <div class="ps-choice">
              <label><input type="radio" name="type" value="net" checked /> Net session</label>
              <label><input type="radio" name="type" value="field" /> Field practice</label>
            </div>
          </div>
          <div class="ps-row">
            <label class="ps-label" for="date">Date</label>
            <input type="date" id="date" name="date" class="form-input ps-date" required />
          </div>
          <div class="ps-row" id="create-format-row">
            <span class="ps-label">Format</span>
            <div class="ps-choice">
              <label><input type="radio" name="format" value="single" /> One session</label>
              <label><input type="radio" name="format" value="split" /> Two slots</label>
            </div>
          </div>
          <div data-format="single">
            <div class="ps-row">
            <span class="ps-label">Time</span>
            <div class="ps-times">
              <input type="time" id="time" name="time" class="form-input" required aria-label="Time start" />
              <span class="ps-dash">–</span>
              <input type="time" id="end-time" name="endTime" class="form-input" aria-label="Time end" />
            </div>
          </div>
          </div>
          <div data-format="split">
            <div class="ps-row">
            <span class="ps-label">Slot 1</span>
            <div class="ps-times">
              <input type="time" name="slot1Start" class="form-input" required aria-label="Slot 1 start" />
              <span class="ps-dash">–</span>
              <input type="time" name="slot1End" class="form-input" required aria-label="Slot 1 end" />
            </div>
          </div>
            <div class="ps-row">
            <span class="ps-label">Slot 2</span>
            <div class="ps-times">
              <input type="time" name="slot2Start" class="form-input" required aria-label="Slot 2 start" />
              <span class="ps-dash">–</span>
              <input type="time" name="slot2End" class="form-input" required aria-label="Slot 2 end" />
            </div>
          </div>
            <div class="ps-row">
              <label class="ps-label" for="create-capacity">Batting places</label>
              <div class="ps-inline">
                <input type="number" id="create-capacity" name="slotCapacity" class="form-input ps-number" min="1" max="50" step="1" required />
                <span class="ps-hint">per slot</span>
              </div>
            </div>
          </div>
          <div class="ps-row ps-row-wide">
            <label class="ps-label" for="location">Location</label>
            <input type="text" id="location" name="location" class="form-input" required minlength="5" maxlength="500" />
          </div>
          <div class="ps-row ps-row-wide">
            <label class="ps-label" for="description">Notes</label>
            <textarea id="description" name="description" class="form-input" rows="2" placeholder="Optional"></textarea>
          </div>
          <div class="ps-actions">
            <button type="submit" class="btn-primary">
              <span id="submit-text">Create Practice</span>
              <span id="submit-spinner" style="display: none;" class="spinner-sm"></span>
            </button>
            <button type="button" id="cancel-form-btn" class="btn-secondary">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Actions -->
    <div class="actions-bar" style="margin-bottom: 1.5rem;">
      <button id="show-create-form-btn" class="btn-primary">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="9" y1="4" x2="9" y2="14"/>
          <line x1="4" y1="9" x2="14" y2="9"/>
        </svg>
        Create Practice
      </button>
    </div>

    <!-- Loading State -->
    <div id="loading-state" class="state-container">
      <div class="spinner"></div>
      <p class="state-text">Loading practices...</p>
    </div>

    <!-- Error State -->
    <div id="error-state" class="alert alert-error" style="display: none;">
      <p id="error-text"></p>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="state-container" style="display: none;">
      <div class="empty-icon">🏏</div>
      <p class="state-title">No practice sessions yet</p>
      <p class="state-text">Create your first practice session to get started</p>
      <button class="btn-primary" onclick="document.getElementById('show-create-form-btn').click()">Create Practice</button>
    </div>

    <!-- Practices List -->
    <div id="practices-container" style="display: none;">
      <div id="practices-list"></div>
    </div>
  </div>

  <!-- Poll Modal -->
  <div id="poll-modal" class="modal" style="display: none;">
    <div class="modal-overlay"></div>
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h2 class="modal-title" id="modal-title">Practice Availability</h2>
        <button class="modal-close" id="close-modal-btn">&times;</button>
      </div>
      <div class="modal-body">
        <div id="modal-practice-info" class="practice-info-header"></div>
        <div id="modal-stats" class="stats-summary"></div>

        <!-- Add Player Section -->
        <div class="add-player-section">
          <h4 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem;">Add Player</h4>
          <div style="display: grid; grid-template-columns: 1fr auto auto; gap: 0.75rem; align-items: flex-end;">
            <div style="position: relative;">
              <label for="player-search-input" style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">Search and Select Player</label>
              <input
                type="text"
                id="player-search-input"
                class="form-input"
                placeholder="Type to search players..."
                style="width: 100%;"
                autocomplete="off"
                oninput="filterPlayers()"
                onfocus="filterPlayers()"
                onblur="hideDropdownDelayed()"
              />
              <div id="player-dropdown" class="player-dropdown" style="display: none;"></div>
            </div>
            <div id="player-status-select-container" style="display: none;">
              <label for="player-status-select" style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">Initial Status</label>
              <select id="player-status-select" class="form-input" style="min-width: 150px;">
                <option value="yes">✓ Yes</option>
                <option value="bowling-only">Bowling Only</option>
              </select>
            </div>
            <button id="add-player-btn" class="btn-primary" onclick="addPlayerToPractice()" disabled>Add Player</button>
          </div>
        </div>

        <div id="modal-players-list" class="players-table-container"></div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="document.getElementById('close-modal-btn').click()">Close</button>
      </div>
    </div>
  </div>

  <!-- Announcement Modal -->
  <div id="announcement-modal" class="modal" style="display: none;">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <div>
          <h2 class="modal-title">Practice Announcement</h2>
          <p class="modal-subtitle">Copy this message to share on WhatsApp</p>
        </div>
        <button class="modal-close" onclick="closeAnnouncementModal()">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div style="padding: 1.5rem;">
        <textarea
          id="announcement-text"
          readonly
          style="width: 100%; min-height: 500px; padding: 1rem; border: 2px solid #d1d5db; border-radius: 8px; font-family: monospace; font-size: 0.875rem; line-height: 1.6; resize: vertical;"
        ></textarea>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-secondary" onclick="closeAnnouncementModal()">Close</button>
        <button id="copy-announcement-btn" class="btn-primary" onclick="copyAnnouncement()">
          📋 Copy to Clipboard
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Notifications -->
  <div id="toast-container" class="toast-container"></div>

  <style>
    /* Compact form rows shared by Weekly practice settings and Create Practice */
    .ps-card { padding: 0; }
    .ps-summary {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.875rem 2.5rem 0.875rem 1rem;
      cursor: pointer;
      list-style: none;
      position: relative;
    }
    .ps-summary::-webkit-details-marker { display: none; }
    .ps-summary::after { content: '▾'; position: absolute; right: 1rem; top: 0.875rem; color: var(--color-text-muted, #6b7280); }
    .ps-card[open] .ps-summary::after { content: '▴'; }
    .ps-summary-title { font-weight: 700; font-size: 0.95rem; }
    .ps-summary-text { font-size: 0.8rem; color: var(--color-text-muted, #6b7280); }
    .ps-form { padding: 0 1rem 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
    .ps-form-header { display: flex; align-items: center; justify-content: space-between; padding: 0.875rem 1rem; }
    .ps-form-title { font-size: 1rem; font-weight: 700; margin: 0; }
    .ps-row { display: flex; align-items: center; gap: 0.75rem; }
    .ps-label { flex: 0 0 8.5rem; font-size: 0.85rem; font-weight: 600; margin: 0; }
    .ps-choice { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: 0.9rem; }
    .ps-choice label { display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; white-space: nowrap; }
    .ps-choice input { width: 1rem; height: 1rem; margin: 0; accent-color: var(--color-primary, #8C1D18); }
    .ps-times { display: flex; align-items: center; gap: 0.5rem; flex: 1; max-width: 22rem; }
    .ps-times .form-input { flex: 1; min-width: 0; width: auto; min-height: 40px; padding: 0.45rem 0.6rem; }
    .ps-dash { color: var(--color-text-muted, #6b7280); }
    .ps-inline { display: flex; align-items: center; gap: 0.5rem; }
    .ps-number { width: 4.5rem !important; min-height: 40px; padding: 0.45rem 0.6rem; }
    .ps-date { max-width: 12rem; min-height: 40px; padding: 0.45rem 0.6rem; }
    /* Boxes stay visible when empty and stay inside the card (iPhone date and time inputs) */
    .ps-form .form-input {
      box-sizing: border-box;
      max-width: 100%;
      border: 1px solid #D6D3D1 !important;
      background-color: #fff;
    }
    .ps-form input[type="date"],
    .ps-form input[type="time"] {
      -webkit-appearance: none;
      appearance: none;
      display: block;
      min-width: 0;
      text-align: left;
    }
    .ps-form input[type="date"]::-webkit-date-and-time-value,
    .ps-form input[type="time"]::-webkit-date-and-time-value { text-align: left; }
    .ps-row-wide .form-input { flex: 1; min-height: 40px; padding: 0.45rem 0.6rem; }
    .ps-hint { font-size: 0.78rem; color: var(--color-text-muted, #6b7280); margin: 0; }
    .ps-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 0.25rem; }
    [data-format] { display: flex; flex-direction: column; gap: 0.75rem; }

    /* On/off switch */
    .ps-switch { position: relative; display: inline-flex; cursor: pointer; }
    .ps-switch input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
    .ps-switch-track {
      width: 2.75rem; height: 1.5rem; border-radius: 999px; background: #D1D5DB;
      position: relative; transition: background 0.2s;
    }
    .ps-switch-track::after {
      content: ''; position: absolute; top: 0.1875rem; left: 0.1875rem;
      width: 1.125rem; height: 1.125rem; border-radius: 50%; background: #fff;
      box-shadow: 0 1px 2px rgba(0,0,0,0.25); transition: transform 0.2s;
    }
    .ps-switch input:checked + .ps-switch-track { background: #10B981; }
    .ps-switch input:checked + .ps-switch-track::after { transform: translateX(1.25rem); }
    .ps-switch input:focus-visible + .ps-switch-track { outline: 2px solid var(--color-primary, #8C1D18); outline-offset: 2px; }

    @media (max-width: 640px) {
      .ps-row { flex-direction: column; align-items: stretch; gap: 0.35rem; }
      .ps-row-switch { flex-direction: row; align-items: center; justify-content: space-between; }
      .ps-label { flex: none; }
      .ps-times { max-width: none; }
      .ps-date { max-width: none; }
      .ps-actions .btn-primary, .ps-actions .btn-secondary { width: 100%; justify-content: center; }
    }
  </style>

  <style is:global>
    /* Practice cards are built in the browser, so these can't be scoped */
    .practice-type-badge.slot-badge { background: #EEF2FF; color: #3730A3; }
    .batting-full { color: #B91C1C !important; }
    /* Badges wrap under the title on phones instead of squeezing beside it */
    .practice-title-row { flex-wrap: wrap; row-gap: 0.4rem; }
    .practice-title-row .practice-type-badge { white-space: nowrap; }
    @media (max-width: 640px) {
      .practice-title-row .practice-title { flex-basis: 100%; }
    }

    /* Mobile-specific fixes */
    @media (max-width: 768px) {
      html,
      body,
      .main-content {
        overflow-y: auto !important;
        overflow-x: hidden !important;
        height: auto !important;
        min-height: 100vh;
      }

      #practices-list,
      #practices-container,
      .practices-page,
      .practice-card {
        overflow: visible !important;
        height: auto !important;
        min-height: 0 !important;
      }

      /* Ensure all practice action buttons are visible */
      .practice-actions {
        margin-bottom: 1.5rem !important;
        padding-bottom: 1rem !important;
      }

      .practice-card {
        margin-bottom: 3rem !important;
        padding-bottom: 2rem !important;
      }

      /* Modal fixes for mobile */
      #poll-modal.modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        overflow-y: visible;
      }

      #poll-modal.modal[style*="display: flex"] {
        display: flex !important;
        align-items: flex-start;
        justify-content: center;
        padding: 0;
      }

      #poll-modal .modal-content.modal-lg {
        width: 100%;
        max-width: 100%;
        height: 100vh;
        max-height: 100vh;
        margin: 0;
        border-radius: 0;
      }

      #poll-modal .modal-body {
        padding: 1rem;
      }

      #poll-modal .modal-header {
        padding: 1rem;
        flex-shrink: 0;
      }

      #poll-modal .modal-footer {
        padding: 1rem;
        flex-shrink: 0;
      }
    }

    /* Form Grid Layout */
    .form-grid {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    /* Announcement Modal Overlay */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.5);
    }

    /* Modal base */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 9999;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .modal[style*="display: flex"] {
      display: flex !important;
      align-items: center;
      justify-content: center;
    }

    /* Large Modal Variant */
    .modal-content.modal-lg {
      position: relative;
      background: white;
      border-radius: 12px;
      max-width: 800px;
      width: 90%;
      max-height: 90vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .modal-header {
      flex-shrink: 0;
      padding: 1.5rem;
      border-bottom: 1px solid #e5e7eb;
    }

    .modal-body {
      padding: 1.5rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      flex: 1;
    }

    .modal-footer {
      flex-shrink: 0;
      padding: 1rem 1.5rem;
      border-top: 1px solid #e5e7eb;
      display: flex;
      gap: 1rem;
      justify-content: flex-end;
      background: white;
    }

    /* Extra Players Dropdown Styling */
    .extras-dropdown {
      padding: 0.25rem 0.5rem;
      font-size: 0.875rem;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      background-color: white;
      color: #111827;
      cursor: pointer;
      transition: all 0.2s;
      min-width: 60px;
    }

    .extras-dropdown:hover {
      border-color: #A82B24;
    }

    .extras-dropdown:focus {
      outline: none;
      border-color: #A82B24;
      box-shadow: 0 0 0 3px rgba(246, 114, 128, 0.1);
    }

    /* Announcement Modal Specific Styles */
    #announcement-modal.modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      align-items: center;
      justify-content: center;
      z-index: 9999;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    #announcement-modal.modal[style*="display: flex"] {
      display: flex !important;
    }

    #announcement-modal .modal-content {
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }
  </style>

  <script>
    import { practiceHeading } from '../../utils/practiceSlots';
    let currentSeasonId = '';
    let currentPractice = null;
    let editingPracticeId = null;

    // Utility functions for date and time
    function parseLocalDate(dateString: string): Date {
      const parts = dateString.split('-');
      return new Date(
        parseInt(parts[0]),
        parseInt(parts[1]) - 1,
        parseInt(parts[2])
      );
    }

    function formatDateDisplay(dateString: string): string {
      const date = parseLocalDate(dateString);
      return date.toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });
    }

    function formatTime12Hour(time24: string): string {
      const [hoursStr, minutes] = time24.split(':');
      const hours = parseInt(hoursStr);
      const ampm = hours >= 12 ? 'PM' : 'AM';
      const displayHour = hours === 0 ? 12 : hours > 12 ? hours - 12 : hours;
      return `${displayHour}:${minutes} ${ampm}`;
    }

    function formatTimeForInput(time12: string): string {
      const timeMatch = time12.match(/(\d+):(\d+)\s*(AM|PM)/i);
      if (!timeMatch) return '';

      let hours = parseInt(timeMatch[1]);
      const minutes = timeMatch[2];
      const period = timeMatch[3].toUpperCase();

      if (period === 'PM' && hours !== 12) {
        hours += 12;
      } else if (period === 'AM' && hours === 12) {
        hours = 0;
      }

      return `${String(hours).padStart(2, '0')}:${minutes}`;
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      loadSeasons();
      setupEventListeners();
      loadPracticeSettings();
    });

    // ---- Weekly practice settings (read by the Saturday job) ----
    const NET_LOCATION = 'NACL Sports Center, 1111 Felipe Ave, San Jose, CA 95122';
    const FIELD_LOCATION = 'Ortega Park, 636 Harrow Way, Sunnyvale, CA 94087';
    let practiceSettings = {
      wednesdayNets: 'split',
      singleSession: { start: '19:00', end: '21:30' },
      slots: [{ start: '19:00', end: '20:30' }, { start: '20:00', end: '21:30' }],
      slotCapacity: 14,
      fridayField: false,
    };
    let loadedPractices = [];

    // Show the rows for one format ("single" / "split") in a form; hidden rows mustn't block submitting
    function showFormat(form, format) {
      form.querySelectorAll('[data-format]').forEach((el) => {
        const on = el.dataset.format === format;
        el.style.display = on ? 'flex' : 'none';
        el.querySelectorAll('input').forEach((input) => {
          if (input.dataset.req === undefined) input.dataset.req = input.required ? '1' : '0';
          input.required = on && input.dataset.req === '1';
        });
      });
    }

    function fillSlotFields(form, s) {
      form.slot1Start.value = s.slots[0].start;
      form.slot1End.value = s.slots[0].end;
      form.slot2Start.value = s.slots[1].start;
      form.slot2End.value = s.slots[1].end;
      form.slotCapacity.value = s.slotCapacity;
    }

    function settingsSummary(s) {
      const short = (t) => formatTime12Hour(t).replace(':00', '').replace(' ', '');
      const range = (r) => `${short(r.start)}–${short(r.end)}`;
      const wed = s.wednesdayNets === 'split'
        ? `Wed: 2 slots · ${range(s.slots[0])}, ${range(s.slots[1])} · ${s.slotCapacity} batting`
        : `Wed: 1 session · ${range(s.singleSession)}`;
      return `${wed} · Fri field: ${s.fridayField ? 'on' : 'off'}`;
    }

    function fillSettingsForm(s, saved) {
      practiceSettings = s;
      const form = document.getElementById('practice-settings-form');
      form.querySelector(`input[name="wednesdayNets"][value="${s.wednesdayNets}"]`).checked = true;
      form.singleStart.value = s.singleSession.start;
      form.singleEnd.value = s.singleSession.end;
      fillSlotFields(form, s);
      form.fridayField.checked = s.fridayField;
      document.getElementById('settings-summary-text').textContent = settingsSummary(s);
      document.getElementById('settings-updated').textContent = saved && s.updatedAt
        ? `Saved ${new Date(s.updatedAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}`
        : 'Defaults (not saved yet)';
      showFormat(form, s.wednesdayNets);
    }

    async function loadPracticeSettings() {
      const form = document.getElementById('practice-settings-form');
      form.querySelectorAll('input[name="wednesdayNets"]').forEach((el) =>
        el.addEventListener('change', () => showFormat(form, el.value))
      );
      form.addEventListener('submit', savePracticeSettings);
      try {
        const res = await fetch('/.netlify/functions/practice-settings', { credentials: 'same-origin' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load settings');
        fillSettingsForm(data.data, data.saved);
      } catch (error) {
        document.getElementById('settings-summary-text').textContent = 'Could not load settings';
        console.error('Error loading practice settings:', error);
      }
    }

    async function savePracticeSettings(e) {
      e.preventDefault();
      const form = e.target;
      const body = {
        wednesdayNets: form.querySelector('input[name="wednesdayNets"]:checked')?.value,
        singleSession: { start: form.singleStart.value, end: form.singleEnd.value },
        slots: [
          { start: form.slot1Start.value, end: form.slot1End.value },
          { start: form.slot2Start.value, end: form.slot2End.value },
        ],
        slotCapacity: parseInt(form.slotCapacity.value, 10),
        fridayField: form.fridayField.checked,
      };
      const btn = document.getElementById('save-settings-btn');
      btn.disabled = true;
      try {
        const res = await fetch('/.netlify/functions/practice-settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to save settings');
        fillSettingsForm(data.data, true);
        showToast('Practice settings saved', 'success');
      } catch (error) {
        showToast(error instanceof Error ? error.message : 'Failed to save settings', 'error');
      } finally {
        btn.disabled = false;
      }
    }

    // ---- Create / edit form ----
    function createFormType() {
      return document.querySelector('#create-practice-form input[name="type"]:checked')?.value || 'net';
    }

    // Net sessions can be one session or two slots (new ones only); field practice is one session
    function updateCreateForm() {
      const form = document.getElementById('create-practice-form');
      const isNet = createFormType() === 'net';
      const canSplit = isNet && !editingPracticeId;
      document.getElementById('create-format-row').style.display = canSplit ? 'flex' : 'none';
      const format = canSplit ? (form.querySelector('input[name="format"]:checked')?.value || 'single') : 'single';
      showFormat(form, format);
      document.getElementById('submit-text').textContent = editingPracticeId
        ? 'Update Practice'
        : format === 'split' ? 'Create Both Slots' : 'Create Practice';
    }

    function setupEventListeners() {
      // Create form toggle
      document.getElementById('show-create-form-btn')?.addEventListener('click', () => {
        openCreateForm();
      });

      document.getElementById('cancel-create-btn')?.addEventListener('click', hideCreateForm);
      document.getElementById('cancel-form-btn')?.addEventListener('click', hideCreateForm);

      // Form submission
      document.getElementById('create-practice-form')?.addEventListener('submit', handleCreatePractice);

      // Poll Modal
      document.getElementById('close-modal-btn')?.addEventListener('click', closeModal);
      document.querySelector('.modal-overlay')?.addEventListener('click', closeModal);

      // Announcement Modal - close on outside click
      const announcementModal = document.getElementById('announcement-modal');
      announcementModal?.addEventListener('click', (e) => {
        if (e.target === announcementModal) {
          closeAnnouncementModal();
        }
      });

      // Type or format change: defaults and which time rows show
      document.querySelectorAll('#create-practice-form input[name="type"]').forEach((radio) => {
        radio.addEventListener('change', () => { setPracticeDefaults(); updateCreateForm(); });
      });
      document.querySelectorAll('#create-practice-form input[name="format"]').forEach((radio) => {
        radio.addEventListener('change', updateCreateForm);
      });
    }

    // A new practice starts from the weekly settings: net format, slot times, batting places
    function openCreateForm() {
      const form = document.getElementById('create-practice-form');
      form.reset();
      editingPracticeId = null;
      form.querySelectorAll('input[name="type"]').forEach((el) => { el.disabled = false; });
      form.querySelector('input[name="type"][value="net"]').checked = true;
      form.querySelector(`input[name="format"][value="${practiceSettings.wednesdayNets}"]`).checked = true;
      fillSlotFields(form, practiceSettings);
      form.location.value = '';
      setPracticeDefaults();
      document.getElementById('create-form-title').textContent = 'Create Practice';
      document.getElementById('create-form-container').style.display = 'block';
      document.getElementById('show-create-form-btn').style.display = 'none';
      updateCreateForm();
    }

    // Next Wednesday (nets) or Friday (field), today included, as YYYY-MM-DD
    let autoDate = '';
    function nextPracticeDate(isNet) {
      const d = new Date();
      d.setDate(d.getDate() + (((isNet ? 3 : 5) - d.getDay() + 7) % 7));
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    function setPracticeDefaults() {
      const form = document.getElementById('create-practice-form');
      const isNet = createFormType() === 'net';
      // Pre-fill the date (an empty date box shows nothing on iPhone); keep a date the admin picked
      if (!editingPracticeId && (!form.date.value || form.date.value === autoDate)) {
        autoDate = nextPracticeDate(isNet);
        form.date.value = autoDate;
      }
      const location = form.location;
      // Swap the default location and time with the type, but keep anything typed in
      if (!location.value || location.value === NET_LOCATION || location.value === FIELD_LOCATION) {
        location.value = isNet ? NET_LOCATION : FIELD_LOCATION;
      }
      form.time.value = isNet ? practiceSettings.singleSession.start : '17:00';
      form.endTime.value = isNet ? practiceSettings.singleSession.end : '';
    }

    function hideCreateForm() {
      document.getElementById('create-form-container').style.display = 'none';
      document.getElementById('show-create-form-btn').style.display = 'block';
      document.getElementById('create-practice-form').reset();
      editingPracticeId = null;
    }

    async function loadSeasons() {
      try {
        const response = await fetch('/.netlify/functions/seasons-list');

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const seasons = await response.json();
        console.log('Seasons response:', seasons);

        // seasons-list returns an array directly
        if (!Array.isArray(seasons) || seasons.length === 0) {
          console.error('No seasons found');
          showError('No seasons found. Please create a season first.');
          document.getElementById('show-create-form-btn').style.display = 'none';
          return;
        }

        const activeSeason = seasons.find(s => s.isActive);

        if (activeSeason) {
          currentSeasonId = activeSeason.id;
          console.log('Active season loaded:', activeSeason.name, 'ID:', currentSeasonId);

          // Update season display
          const seasonNameEl = document.getElementById('season-name');
          if (seasonNameEl) {
            seasonNameEl.textContent = `Active Season: ${activeSeason.name}`;
            seasonNameEl.style.fontWeight = '600';
            seasonNameEl.style.color = '#10B981';
          }

          // Load practices
          loadPractices();
        } else {
          console.error('No active season found in:', seasons);
          showError('No active season found. Please go to Seasons page and click "Set Active" on a season.');
          // Hide the create button if no active season
          document.getElementById('show-create-form-btn').style.display = 'none';
        }
      } catch (error) {
        console.error('Error loading seasons:', error);
        showError('Failed to load season data: ' + (error instanceof Error ? error.message : 'Unknown error'));
      }
    }

    async function loadPractices() {
      try {
        document.getElementById('loading-state').style.display = 'flex';
        document.getElementById('error-state').style.display = 'none';
        document.getElementById('empty-state').style.display = 'none';
        document.getElementById('practices-container').style.display = 'none';

        const response = await fetch(`/.netlify/functions/practice-admin-list?seasonId=${currentSeasonId}&inPlay=1`);
        const data = await response.json();

        document.getElementById('loading-state').style.display = 'none';

        if (!data.success || !data.data || data.data.length === 0) {
          document.getElementById('empty-state').style.display = 'flex';
          return;
        }

        const practices = data.data;
        renderPractices(practices);

        document.getElementById('practices-container').style.display = 'block';
      } catch (error) {
        console.error('Error loading practices:', error);
        document.getElementById('loading-state').style.display = 'none';
        showError('Failed to load practice sessions');
      }
    }

    function renderPractices(practices) {
      loadedPractices = practices;
      const container = document.getElementById('practices-list');
      container.innerHTML = '';

      // Separate upcoming and past practices
      const today = new Date().toISOString().split('T')[0];
      const upcoming = practices.filter(p => p.date >= today && p.status === 'active');
      const past = practices.filter(p => p.date < today || p.status !== 'active');

      // Render upcoming
      if (upcoming.length > 0) {
        const upcomingSection = document.createElement('div');
        upcomingSection.innerHTML = '<h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">Upcoming Practices</h2>';
        upcoming.forEach(practice => {
          upcomingSection.appendChild(createPracticeCard(practice));
        });
        container.appendChild(upcomingSection);
      }

      // Render past
      if (past.length > 0) {
        const pastSection = document.createElement('div');
        pastSection.style.marginTop = '2rem';
        pastSection.innerHTML = '<h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">Past Practices</h2>';
        past.forEach(practice => {
          pastSection.appendChild(createPracticeCard(practice));
        });
        container.appendChild(pastSection);
      }
    }

    function createPracticeCard(practice) {
      const card = document.createElement('div');
      card.className = 'practice-card';

      const typeEmoji = practice.type === 'net' ? '🎾' : '🏟️';
      const typeName = practice.type === 'net' ? 'Net Session' : 'Field Practice';
      const typeBadgeClass = practice.type === 'net' ? 'badge-net' : 'badge-field';

      // Calculate stats based on practice type
      let statsHTML = '';
      if (practice.type === 'net') {
        const battingStat = practice.capacity ? `
          <div class="stat-item">
            <span class="stat-label">Batting places</span>
            <span class="stat-value ${practice.stats.battingCount >= practice.capacity ? 'batting-full' : ''}">${practice.stats.battingCount}/${practice.capacity}${practice.stats.battingCount >= practice.capacity ? ' · Full' : ''}</span>
          </div>` : '';
        statsHTML = `
          ${battingStat}
          <div class="stat-item">
            <span class="stat-label">Yes</span>
            <span class="stat-value">${practice.stats.yesCount}</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Bowling Only</span>
            <span class="stat-value">${practice.stats.bowlingOnlyCount}</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Not Available</span>
            <span class="stat-value">${practice.stats.notAvailableCount}</span>
          </div>
        `;
      } else {
        statsHTML = `
          <div class="stat-item">
            <span class="stat-label">Yes</span>
            <span class="stat-value">${practice.stats.yesCount}</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Not Available</span>
            <span class="stat-value">${practice.stats.notAvailableCount}</span>
          </div>
        `;
      }

      card.innerHTML = `
        <div class="practice-header">
          <div>
            <div class="practice-title-row">
              <h3 class="practice-title">${practiceHeading(practice.title)}</h3>
              <span class="practice-type-badge ${typeBadgeClass}">${typeEmoji} ${typeName}</span>
              ${practice.slotNumber ? `<span class="practice-type-badge slot-badge">Slot ${practice.slotNumber}</span>` : ''}
            </div>
            <div class="practice-details">
              <div class="practice-detail">
                📅 ${formatDateDisplay(practice.date)}
              </div>
              <div class="practice-detail">
                🕐 ${practice.time}
              </div>
              <div class="practice-detail">
                📍 ${practice.location}
              </div>
            </div>
          </div>
        </div>

        ${practice.description ? `<p style="color: var(--color-text-body); margin-bottom: 1rem;">${practice.description}</p>` : ''}

        <div class="practice-stats">
          <div class="stat-item">
            <span class="stat-label">Responses</span>
            <span class="stat-value">${practice.stats.respondedCount}/${practice.stats.totalPlayers} (${practice.stats.responseRate}%)</span>
          </div>
          ${statsHTML}
        </div>

        ${practice.locked ? '<div class="lock-notice">🔒 This practice session is locked. Members cannot vote or change their votes.</div>' : ''}

        <div class="practice-actions">
          <button class="btn-primary btn-sm" onclick="viewPoll('${practice.id}')">View Poll</button>
          <button class="btn-secondary btn-sm" onclick="generatePracticeAnnouncement('${practice.id}')" title="Generate WhatsApp announcement">📱 Generate Announcement</button>
          <button class="btn-secondary btn-sm" onclick="toggleLock('${practice.id}', ${practice.locked})" title="${practice.locked ? 'Unlock voting' : 'Lock voting'}">
            ${practice.locked ? '🔓 Unlock' : '🔒 Lock'}
          </button>
          <button class="btn-secondary btn-sm" onclick="editPractice('${practice.id}')">Edit</button>
          <button class="btn-secondary btn-sm" onclick="deletePractice('${practice.id}', '${practice.title}')">Delete</button>
        </div>
      `;

      return card;
    }

    async function handleCreatePractice(e) {
      e.preventDefault();

      const form = e.target;
      const formData = new FormData(form);

      const type = formData.get('type');
      const date = formData.get('date');
      const split = type === 'net' && !editingPracticeId && formData.get('format') === 'split';
      const data = {
        type,
        date,
        location: formData.get('location'),
        description: formData.get('description') || '',
        seasonId: currentSeasonId,
      };

      if (split) {
        const slots = [
          { start: formData.get('slot1Start'), end: formData.get('slot1End') },
          { start: formData.get('slot2Start'), end: formData.get('slot2End') },
        ];
        if (slots.some((r) => !r.start || !r.end || r.end <= r.start)) {
          showToast('Each slot needs an end time after its start time', 'error');
          return;
        }
        data.format = 'split';
        data.slots = slots;
        data.slotCapacity = parseInt(formData.get('slotCapacity'), 10);
      } else {
        const timeValue = formData.get('time');
        if (!timeValue) {
          showToast('Please select a time', 'error');
          return;
        }
        const endValue = formData.get('endTime');
        if (endValue && endValue <= timeValue) {
          showToast('End time must be after the start time', 'error');
          return;
        }
        data.time = endValue
          ? `${formatTime12Hour(timeValue)} - ${formatTime12Hour(endValue)}`
          : formatTime12Hour(timeValue);
      }

      // Warn before a second net session on the same date
      if (!editingPracticeId && type === 'net') {
        const sameDay = loadedPractices.filter((p) => p.date === date && p.type === 'net' && p.status === 'active');
        if (sameDay.length > 0 && !confirm(`There's already a net session on ${formatDateDisplay(date)} (${sameDay.map((p) => p.title).join(', ')}). Create another anyway?`)) {
          return;
        }
      }

      // Add practiceId if editing
      if (editingPracticeId) {
        data.practiceId = editingPracticeId;
      }

      // Validate we have a season ID
      if (!currentSeasonId) {
        showToast('No active season found. Please create a season first.', 'error');
        return;
      }

      console.log(editingPracticeId ? 'Updating practice with data:' : 'Creating practice with data:', data);

      // Show loading state
      document.getElementById('submit-text').style.display = 'none';
      document.getElementById('submit-spinner').style.display = 'inline-block';

      try {
        const endpoint = editingPracticeId ? 'practice-update' : 'practice-create';
        const response = await fetch(`/.netlify/functions/${endpoint}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();
        console.log(editingPracticeId ? 'Update' : 'Create', 'practice response:', result);

        if (result.success) {
          showToast(editingPracticeId ? 'Practice session updated successfully' : 'Practice session created successfully', 'success');
          hideCreateForm();
          loadPractices();
        } else {
          console.error(editingPracticeId ? 'Update' : 'Create', 'practice error:', result);
          showToast(result.error || (editingPracticeId ? 'Failed to update practice' : 'Failed to create practice'), 'error');
        }
      } catch (error) {
        console.error('Error', editingPracticeId ? 'updating' : 'creating', 'practice:', error);
        showToast(editingPracticeId ? 'Failed to update practice session' : 'Failed to create practice session', 'error');
      } finally {
        document.getElementById('submit-text').style.display = 'inline';
        document.getElementById('submit-spinner').style.display = 'none';
      }
    }

    async function viewPoll(practiceId) {
      try {
        const response = await fetch(`/.netlify/functions/practice-get?practiceId=${practiceId}`);
        const data = await response.json();

        if (!data.success || !data.data) {
          showToast('Failed to load practice details', 'error');
          return;
        }

        currentPractice = data.data;
        renderPollModal(currentPractice);
        document.getElementById('poll-modal').style.display = 'flex';
      } catch (error) {
        console.error('Error loading practice:', error);
        showToast('Failed to load practice details', 'error');
      }
    }

    function renderPollModal(practice) {
      const typeEmoji = practice.type === 'net' ? '🎾' : '🏟️';
      const typeName = practice.type === 'net' ? 'Net Session' : 'Field Practice';

      // Practice info
      document.getElementById('modal-practice-info').innerHTML = `
        <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">${practice.title}</h3>
        <p style="color: var(--color-text-muted);">
          ${formatDateDisplay(practice.date)} at ${practice.time} &nbsp;•&nbsp; <span class="practice-type-badge ${practice.type === 'net' ? 'badge-net' : 'badge-field'}">${typeEmoji} ${typeName}</span>
        </p>
      `;

      // Calculate total extras
      const totalExtras = practice.playerAvailability.reduce((sum, player) => sum + (player.extraPlayers || 0), 0);
      const totalExpected = practice.stats.yesCount + practice.stats.bowlingOnlyCount + totalExtras;

      // Stats
      let statsHTML = `
        <div class="stat-item">
          <span class="stat-label">Responses</span>
          <span class="stat-value">${practice.stats.respondedCount}/${practice.stats.totalPlayers} (${practice.stats.responseRate}%)</span>
        </div>
      `;

      if (practice.capacity) {
        const batting = practice.playerAvailability.reduce((sum, p) =>
          sum + (p.response === 'yes' ? 1 + (p.extraPlayers || 0) : p.response === 'bowling-only' ? (p.extraPlayers || 0) : 0), 0);
        statsHTML += `
          <div class="stat-item">
            <span class="stat-label">🏏 Batting places</span>
            <span class="stat-value ${batting >= practice.capacity ? 'batting-full' : ''}">${batting}/${practice.capacity}</span>
          </div>
        `;
      }

      if (practice.type === 'net') {
        statsHTML += `
          <div class="stat-item">
            <span class="stat-label">✓ Yes</span>
            <span class="stat-value">${practice.stats.yesCount}</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Bowling Only</span>
            <span class="stat-value">${practice.stats.bowlingOnlyCount}</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">✗ Not Available</span>
            <span class="stat-value">${practice.stats.notAvailableCount}</span>
          </div>
        `;
      } else {
        statsHTML += `
          <div class="stat-item">
            <span class="stat-label">✓ Yes</span>
            <span class="stat-value">${practice.stats.yesCount}</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">✗ Not Available</span>
            <span class="stat-value">${practice.stats.notAvailableCount}</span>
          </div>
        `;
      }

      // Add total extras and total expected
      statsHTML += `
        <div class="stat-item">
          <span class="stat-label">👥 Extras</span>
          <span class="stat-value">${totalExtras}</span>
        </div>
        <div class="stat-item" style="background: #f0fdf4; border: 1px solid #86efac;">
          <span class="stat-label"><strong>Total Expected</strong></span>
          <span class="stat-value" style="color: #166534; font-weight: 700;">${totalExpected}</span>
        </div>
      `;

      document.getElementById('modal-stats').innerHTML = statsHTML;

      // Players table
      const playersHTML = `
        <table class="players-table">
          <thead>
            <tr>
              <th>Player</th>
              <th>Status</th>
              <th style="width: 100px; text-align: center;">Extras</th>
              <th>Submitted</th>
              <th style="width: 120px; text-align: center;">Actions</th>
            </tr>
          </thead>
          <tbody>
            ${practice.playerAvailability.map(player => {
              let badge = '';
              if (player.response === 'yes') {
                badge = '<span class="response-badge response-yes">✓ Yes</span>';
              } else if (player.response === 'bowling-only') {
                badge = '<span class="response-badge response-bowling">Bowling Only</span>';
              } else if (player.response === 'not-available') {
                badge = '<span class="response-badge response-no">✗ Not Available</span>';
              } else {
                badge = '<span class="response-badge response-none">- No Response</span>';
              }

              const submitted = player.submittedAt ? new Date(player.submittedAt).toLocaleString() : '-';
              const extraPlayers = player.extraPlayers || 0;

              return `
                <tr>
                  <td>${player.playerName}</td>
                  <td>${badge}</td>
                  <td style="text-align: center;">
                    <select
                      class="extras-dropdown"
                      data-player-id="${player.playerId}"
                      onchange="updatePlayerExtras('${player.playerId}', this.value)"
                    >
                      <option value="0" ${extraPlayers === 0 ? 'selected' : ''}>0</option>
                      <option value="1" ${extraPlayers === 1 ? 'selected' : ''}>1</option>
                      <option value="2" ${extraPlayers === 2 ? 'selected' : ''}>2</option>
                      <option value="3" ${extraPlayers === 3 ? 'selected' : ''}>3</option>
                      <option value="4" ${extraPlayers === 4 ? 'selected' : ''}>4</option>
                      <option value="5" ${extraPlayers === 5 ? 'selected' : ''}>5</option>
                      <option value="6" ${extraPlayers === 6 ? 'selected' : ''}>6</option>
                      <option value="7" ${extraPlayers === 7 ? 'selected' : ''}>7</option>
                      <option value="8" ${extraPlayers === 8 ? 'selected' : ''}>8</option>
                      <option value="9" ${extraPlayers === 9 ? 'selected' : ''}>9</option>
                      <option value="10" ${extraPlayers === 10 ? 'selected' : ''}>10</option>
                    </select>
                  </td>
                  <td>${submitted}</td>
                  <td style="text-align: center;">
                    <button class="btn-remove" onclick="removePlayerFromPractice('${player.playerId}', '${player.playerName}')">Remove</button>
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      `;

      document.getElementById('modal-players-list').innerHTML = playersHTML;

      // Show/hide status dropdown based on practice type
      const statusContainer = document.getElementById('player-status-select-container');
      if (practice.type === 'net') {
        statusContainer.style.display = 'block';
      } else {
        statusContainer.style.display = 'none';
      }

      // Load available players for dropdown
      loadAvailablePlayers();
    }

    function closeModal() {
      document.getElementById('poll-modal').style.display = 'none';
      currentPractice = null;
    }

    async function generatePracticeAnnouncement(practiceId) {
      try {
        // Fetch the practice details
        const response = await fetch(`/.netlify/functions/practice-get?practiceId=${practiceId}`);

        if (!response.ok) {
          showToast('Failed to load practice details', 'error');
          return;
        }

        const result = await response.json();
        const practice = result.data;

        if (!practice) {
          showToast('Practice not found', 'error');
          return;
        }

        const typeEmoji = practice.type === 'net' ? '🎾' : '🏟️';
        const typeName = practice.type === 'net' ? 'Net Session' : 'Field Practice';

        const byName = (a, b) => a.playerName.localeCompare(b.playerName);

        // Players who said yes
        const yesPlayers = practice.playerAvailability
          .filter(p => p.response === 'yes')
          .sort(byName);

        // Players who said bowling-only (only for net sessions)
        const bowlingOnlyPlayers = practice.type === 'net'
          ? practice.playerAvailability.filter(p => p.response === 'bowling-only').sort(byName)
          : [];

        // Guests (net and field): "Name +1", "Name +2"… for each guest a coming
        // player said they're bringing
        const guests = [...yesPlayers, ...bowlingOnlyPlayers]
          .sort(byName)
          .flatMap(p => Array.from({ length: p.extraPlayers || 0 }, (_, i) => `${p.playerName} +${i + 1}`));

        // Plain names, no @mentions: the practice channel doesn't tag people
        // (team selection announcements do)
        const numbered = (names) =>
          names.map((name, idx) => `${String(idx + 1).padStart(2, ' ')}. ${name}`).join('\n') + '\n\n';

        let announcement = `${typeEmoji} ${typeName}\n`;
        announcement += `${formatDateDisplay(practice.date)} at ${practice.time}\n`;
        announcement += `${practice.location}\n\n`;

        if (yesPlayers.length > 0) {
          announcement += numbered(yesPlayers.map(p => p.playerName));
        }

        if (bowlingOnlyPlayers.length > 0) {
          announcement += 'Bowling only:\n';
          announcement += numbered(bowlingOnlyPlayers.map(p => p.playerName));
        }

        if (guests.length > 0) {
          announcement += 'Guests:\n';
          announcement += numbered(guests);
        }

        announcement += 'Please be on time to ensure we all get max time to practice!';

        // Show modal with generated message
        document.getElementById('announcement-text').value = announcement;
        document.getElementById('announcement-modal').style.display = 'flex';
      } catch (error) {
        console.error('Error generating announcement:', error);
        showToast('Failed to generate announcement', 'error');
      }
    }

    function closeAnnouncementModal() {
      document.getElementById('announcement-modal').style.display = 'none';
    }

    async function copyAnnouncement() {
      const textarea = document.getElementById('announcement-text');
      const text = textarea.value;

      try {
        await navigator.clipboard.writeText(text);
        showToast('✓ Copied to clipboard!', 'success');

        // Change button text temporarily
        const btn = document.getElementById('copy-announcement-btn');
        const originalText = btn.innerHTML;
        btn.innerHTML = '✓ Copied!';
        btn.style.background = '#10b981';

        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.style.background = '';
        }, 2000);
      } catch (error) {
        // Fallback for older browsers
        textarea.select();
        document.execCommand('copy');
        showToast('✓ Copied to clipboard!', 'success');
      }
    }

    async function editPractice(practiceId) {
      try {
        // Fetch the practice details
        const response = await fetch(`/.netlify/functions/practice-get?practiceId=${practiceId}`);
        const result = await response.json();

        if (!result.success || !result.data) {
          showToast('Failed to load practice details', 'error');
          return;
        }

        const practice = result.data;

        // Set editing mode
        editingPracticeId = practiceId;

        // Show the form
        document.getElementById('create-form-container').style.display = 'block';
        document.getElementById('show-create-form-btn').style.display = 'none';

        // Update form title and button
        document.getElementById('create-form-title').textContent = practice.slotNumber
          ? `Edit Slot ${practice.slotNumber} (a date change moves both slots)`
          : 'Edit Practice';
        document.getElementById('submit-text').textContent = 'Update Practice';

        // Populate form fields
        const form = document.getElementById('create-practice-form');

        // Set practice type (a slot stays a net session)
        const typeRadio = form.querySelector(`input[name="type"][value="${practice.type}"]`);
        if (typeRadio) typeRadio.checked = true;
        form.querySelectorAll('input[name="type"]').forEach((el) => { el.disabled = !!practice.slotNumber; });
        updateCreateForm();

        // Set date
        form.querySelector('#date').value = practice.date;

        // Convert time from "2:30 PM" to "14:30" format for time input using utility function
        const [startPart, endPart] = String(practice.time || '').split(/\s+-\s+/);
        const timeForInput = formatTimeForInput(startPart || '') || (/^\d{2}:\d{2}$/.test(startPart) ? startPart : '');
        if (timeForInput) {
          form.querySelector('#time').value = timeForInput;
        }
        form.querySelector('#end-time').value = endPart ? formatTimeForInput(endPart) : '';

        // Set location
        form.querySelector('#location').value = practice.location;

        // Set description
        form.querySelector('#description').value = practice.description || '';

        // Scroll to form
        document.getElementById('create-form-container').scrollIntoView({ behavior: 'smooth', block: 'start' });

      } catch (error) {
        console.error('Error loading practice for edit:', error);
        showToast('Failed to load practice details', 'error');
      }
    }

    async function toggleLock(practiceId, currentlyLocked) {
      const action = currentlyLocked ? 'unlock' : 'lock';
      const confirmMsg = currentlyLocked
        ? 'Unlock this practice session? Members will be able to vote and change their votes.'
        : 'Lock this practice session? Members will not be able to vote or change their votes.';

      if (!confirm(confirmMsg)) {
        return;
      }

      try {
        const response = await fetch('/.netlify/functions/practice-lock', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            practiceId,
            locked: !currentlyLocked,
          }),
        });

        const result = await response.json();

        if (result.success) {
          showToast(`Practice ${action}ed successfully`, 'success');
          loadPractices();
        } else {
          showToast(result.error || `Failed to ${action} practice`, 'error');
        }
      } catch (error) {
        console.error(`Error ${action}ing practice:`, error);
        showToast(`Failed to ${action} practice`, 'error');
      }
    }

    async function deletePractice(practiceId, title) {
      if (!confirm(`Are you sure you want to delete "${title}"? This will remove all availability responses.`)) {
        return;
      }

      try {
        const response = await fetch('/.netlify/functions/practice-delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ practiceId }),
        });

        const result = await response.json();

        if (result.success) {
          showToast('Practice deleted successfully', 'success');
          loadPractices();
        } else {
          showToast(result.error || 'Failed to delete practice', 'error');
        }
      } catch (error) {
        console.error('Error deleting practice:', error);
        showToast('Failed to delete practice', 'error');
      }
    }

    function showError(message) {
      document.getElementById('error-text').textContent = message;
      document.getElementById('error-state').style.display = 'block';
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.textContent = message;

      container.appendChild(toast);

      setTimeout(() => {
        toast.remove();
      }, 3000);
    }

    // Player management functions
    let allPlayers = [];
    let availablePlayersForPractice = [];
    let selectedPlayer = null;
    let hideDropdownTimeout = null;

    async function loadAvailablePlayers() {
      try {
        const response = await fetch('/.netlify/functions/players-list?status=active');
        const players = await response.json();

        console.log('Loaded players:', players);

        if (Array.isArray(players) && players.length > 0) {
          // Filter to active players only (query already does this, but double-check)
          allPlayers = players.filter(p => p.isActive);

          // Get players already in practice
          const existingPlayerIds = currentPractice.playerAvailability.map(pa => pa.playerId);

          // Filter out players already in the practice
          availablePlayersForPractice = allPlayers.filter(p => !existingPlayerIds.includes(p.id));

          console.log('Available players to add:', availablePlayersForPractice.length);

          // Clear search input and selection
          document.getElementById('player-search-input').value = '';
          selectedPlayer = null;
          document.getElementById('add-player-btn').disabled = true;
        } else {
          console.log('No players available or empty array');
        }
      } catch (error) {
        console.error('Error loading players:', error);
      }
    }

    function filterPlayers() {
      const searchInput = document.getElementById('player-search-input');
      const dropdown = document.getElementById('player-dropdown');
      const searchQuery = searchInput.value.toLowerCase().trim();

      // Clear selection if user is typing
      if (selectedPlayer && searchInput.value !== `${selectedPlayer.firstName} ${selectedPlayer.lastName}`) {
        selectedPlayer = null;
        document.getElementById('add-player-btn').disabled = true;
      }

      // Filter players based on search query
      let filteredPlayers = availablePlayersForPractice;
      if (searchQuery) {
        filteredPlayers = availablePlayersForPractice.filter(p => {
          const fullName = `${p.firstName} ${p.lastName}`.toLowerCase();
          return fullName.includes(searchQuery);
        });
      }

      // Sort alphabetically
      filteredPlayers.sort((a, b) =>
        `${a.firstName} ${a.lastName}`.localeCompare(`${b.firstName} ${b.lastName}`)
      );

      // Populate dropdown
      if (filteredPlayers.length === 0) {
        dropdown.innerHTML = '<div class="player-dropdown-empty">No players found</div>';
      } else {
        dropdown.innerHTML = filteredPlayers
          .map(p => `
            <div class="player-dropdown-item" onclick="selectPlayer('${p.id}', '${p.firstName}', '${p.lastName}')">
              ${p.firstName} ${p.lastName}
            </div>
          `)
          .join('');
      }

      // Show dropdown
      dropdown.style.display = 'block';
    }

    function selectPlayer(playerId, firstName, lastName) {
      const fullName = `${firstName} ${lastName}`;
      const player = availablePlayersForPractice.find(p => p.id === playerId);

      if (player) {
        selectedPlayer = player;
        document.getElementById('player-search-input').value = fullName;
        document.getElementById('add-player-btn').disabled = false;
        hideDropdown();
      }
    }

    function hideDropdown() {
      document.getElementById('player-dropdown').style.display = 'none';
    }

    function hideDropdownDelayed() {
      // Delay hiding to allow click events on dropdown items to fire
      hideDropdownTimeout = setTimeout(() => {
        hideDropdown();
      }, 200);
    }

    async function addPlayerToPractice() {
      if (!selectedPlayer) {
        showToast('Please select a player', 'error');
        return;
      }

      const playerId = selectedPlayer.id;
      const playerName = `${selectedPlayer.firstName} ${selectedPlayer.lastName}`;

      // Get initial status based on practice type
      let initialResponse = null;
      if (currentPractice.type === 'net') {
        // For net practices, get selected status from dropdown
        const statusSelect = document.getElementById('player-status-select');
        initialResponse = statusSelect.value;
      } else {
        // For field practices, always set to 'yes'
        initialResponse = 'yes';
      }

      try {
        const response = await fetch('/.netlify/functions/practice-player-manage', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            practiceId: currentPractice.id,
            playerId,
            playerName,
            action: 'add',
            initialResponse: initialResponse,
          }),
        });

        const result = await response.json();

        if (result.success) {
          showToast(result.message, 'success');
          // Reload the poll modal
          viewPoll(currentPractice.id);
        } else {
          showToast(result.error || 'Failed to add player', 'error');
        }
      } catch (error) {
        console.error('Error adding player:', error);
        showToast('Failed to add player', 'error');
      }
    }

    async function removePlayerFromPractice(playerId, playerName) {
      if (!confirm(`Remove ${playerName} from this practice session?`)) {
        return;
      }

      try {
        const response = await fetch('/.netlify/functions/practice-player-manage', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            practiceId: currentPractice.id,
            playerId,
            action: 'remove',
          }),
        });

        const result = await response.json();

        if (result.success) {
          showToast(result.message, 'success');
          // Reload the poll modal
          viewPoll(currentPractice.id);
        } else {
          showToast(result.error || 'Failed to remove player', 'error');
        }
      } catch (error) {
        console.error('Error removing player:', error);
        showToast('Failed to remove player', 'error');
      }
    }

    async function updatePlayerExtras(playerId, extraPlayers) {
      if (!currentPractice) return;

      try {
        // Update via practice-player-manage endpoint
        const response = await fetch('/.netlify/functions/practice-player-manage', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            practiceId: currentPractice.id,
            playerId,
            action: 'update-extras',
            extraPlayers: parseInt(extraPlayers),
          }),
        });

        const result = await response.json();

        if (result.success) {
          showToast('Extra players updated', 'success');
          // Reload the poll modal to refresh counts
          viewPoll(currentPractice.id);
        } else {
          showToast(result.error || 'Failed to update extra players', 'error');
          // Reload to reset dropdown
          viewPoll(currentPractice.id);
        }
      } catch (error) {
        console.error('Error updating extra players:', error);
        showToast('Failed to update extra players', 'error');
        // Reload to reset dropdown
        viewPoll(currentPractice.id);
      }
    }

    // Expose functions globally
    window.viewPoll = viewPoll;
    window.editPractice = editPractice;
    window.deletePractice = deletePractice;
    window.toggleLock = toggleLock;
    window.generatePracticeAnnouncement = generatePracticeAnnouncement;
    window.closeAnnouncementModal = closeAnnouncementModal;
    window.copyAnnouncement = copyAnnouncement;
    window.addPlayerToPractice = addPlayerToPractice;
    window.removePlayerFromPractice = removePlayerFromPractice;
    window.updatePlayerExtras = updatePlayerExtras;
    window.filterPlayers = filterPlayers;
    window.selectPlayer = selectPlayer;
    window.hideDropdownDelayed = hideDropdownDelayed;
  </script>
</AdminLayout>
