---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { SITE_CONFIG, isWinterCheckInAdminRestricted } from '../../config';

const cookieHeader = Astro.request.headers.get('cookie');
let authenticated = false;
let username = '';
let userRole = 'admin';
let isAdminUser = false;
let userEmail = '';

if (cookieHeader) {
  try {
    const response = await fetch(`${Astro.url.origin}/.netlify/functions/auth-check`, {
      headers: { cookie: cookieHeader },
    });
    const data = await response.json();
    authenticated = data.authenticated;
    username = data.user?.firstName || data.user?.username || '';
    userRole = data.user?.role_auth || data.user?.role || 'admin';
    userEmail = data.user?.email || '';
    isAdminUser = userRole === 'admin' || userRole === 'super_admin';
  } catch (error) {
    authenticated = false;
  }
}

if (!authenticated) return Astro.redirect('/admin/login');
if (!isAdminUser) return Astro.redirect('/');
if (isWinterCheckInAdminRestricted(userEmail)) return Astro.redirect('/admin');

const seasonLabel = SITE_CONFIG.winterCheckIn.summerFeedback?.seasonLabel ?? 'Summer';
---

<AdminLayout
  title="Summer '26 Feedback - GSCC Admin"
  username={username}
  userRole={userRole}
  activePage="summer-feedback"
>
  <div class="dashboard">
    <div class="page-header">
      <h1 class="page-title">Summer '26 Feedback</h1>
      <p class="page-description">
        Player feedback on the {seasonLabel} season — collected on the winter check-in form.
      </p>
    </div>

    <div class="toolbar sf-toolbar">
      <input type="text" id="sf-search" class="search-input" placeholder="Search name or email…" />
      <select id="sf-filter-team" class="sf-select"><option value="">All teams</option></select>
      <span class="sf-toolbar-spacer"></span>
      <button id="sf-refresh" class="btn-secondary" type="button">Refresh</button>
      <a href="/.netlify/functions/winter-checkin-summer-export" class="btn-secondary" id="sf-export">Export CSV</a>
    </div>

    <div class="stats-grid" id="sf-stats" hidden></div>

    <div id="sf-loading" class="state-container">
      <div class="spinner"></div>
      <p class="state-text">Loading feedback…</p>
    </div>

    <div id="sf-error" class="state-container" hidden>
      <div class="error-icon">⚠️</div>
      <p class="state-title">Couldn’t load feedback</p>
      <p class="state-text" id="sf-error-text"></p>
      <button id="sf-retry" class="btn-secondary" type="button">Try again</button>
    </div>

    <div id="sf-empty" class="state-container" hidden>
      <div class="empty-icon">🗒️</div>
      <p class="state-title">No summer feedback yet</p>
      <p class="state-text">It shows up here once members submit the winter check-in.</p>
    </div>

    <div class="table-container sf-table-wrap" id="sf-table-wrap" hidden>
      <table class="data-table sf-table">
        <thead>
          <tr>
            <th>Name</th><th>Teams</th><th>Felt included</th><th>Notified before XI</th><th>Updated</th>
          </tr>
        </thead>
        <tbody id="sf-tbody"></tbody>
      </table>
    </div>
    <p class="sf-count" id="sf-count" hidden></p>
  </div>

  <div id="sf-modal" class="sf-modal" hidden>
    <div class="sf-modal-card" role="dialog" aria-modal="true" aria-labelledby="sf-modal-title">
      <div class="sf-modal-head">
        <h2 id="sf-modal-title">Feedback</h2>
        <button id="sf-modal-close" class="sf-modal-close" type="button" aria-label="Close">&times;</button>
      </div>
      <dl class="sf-modal-body" id="sf-modal-body"></dl>
    </div>
  </div>
</AdminLayout>

<style>
  .sf-toolbar { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin-bottom: 1.5rem; }
  .sf-toolbar-spacer { flex: 1; }
  .sf-select {
    padding: 0.6rem 0.75rem; border-radius: 8px;
    border: 1px solid var(--color-border-strong, #d1d5db);
    background: var(--color-bg-card, #fff); color: inherit; font: inherit;
  }
  #sf-search { max-width: 260px; }

  .sf-table-wrap { overflow-x: auto; }
  .sf-table { min-width: 720px; }
  .sf-table th { white-space: nowrap; }
  .sf-table td { vertical-align: top; }
  .sf-table tbody tr { cursor: pointer; }
  .sf-table td.sf-wrap { white-space: normal; min-width: 180px; max-width: 280px; }

  .sf-count { font-size: 0.8rem; color: var(--color-text-muted, #64748b); margin: 0.75rem 0 0; }

  .sf-modal {
    position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5);
    display: flex; align-items: center; justify-content: center; padding: 1rem; z-index: 1000;
  }
  .sf-modal-card {
    background: var(--color-bg-card, #fff); color: var(--color-text-body, #111827);
    border-radius: 12px; width: 100%; max-width: 640px; max-height: 85vh;
    display: flex; flex-direction: column; box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.35);
  }
  .sf-modal-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem 1.25rem; border-bottom: 1px solid var(--color-border, #e5e7eb);
  }
  .sf-modal-head h2 { margin: 0; font-size: 1.1rem; }
  .sf-modal-close {
    background: none; border: none; font-size: 1.6rem; line-height: 1; cursor: pointer; color: inherit;
  }
  .sf-modal-body {
    padding: 1.25rem; overflow-y: auto; margin: 0;
    display: grid; grid-template-columns: 38% 62%; gap: 0.5rem 1rem; font-size: 0.875rem;
  }
  .sf-modal-body dt { font-weight: 700; color: var(--color-text-muted, #64748b); }
  .sf-modal-body dd { margin: 0; word-break: break-word; white-space: pre-wrap; }

  @media (max-width: 560px) {
    .sf-toolbar > * { flex: 1 1 100%; }
    #sf-search { max-width: none; }
    .sf-toolbar-spacer { display: none; }
    #sf-export { text-align: center; }
    .sf-modal-body { grid-template-columns: 1fr; gap: 0.15rem 0; }
    .sf-modal-body dd { margin-bottom: 0.6rem; }
  }
</style>

<script>
  import { SUMMER_FEEDBACK_COLUMNS } from '../../types/winter';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const loading = $('sf-loading');
  const errorBox = $('sf-error');
  const errorText = $('sf-error-text');
  const emptyBox = $('sf-empty');
  const tableWrap = $('sf-table-wrap');
  const tbody = $('sf-tbody');
  const statsGrid = $('sf-stats');
  const countLine = $('sf-count');
  const searchInput = $<HTMLInputElement>('sf-search');
  const filterTeam = $<HTMLSelectElement>('sf-filter-team');
  const modal = $('sf-modal');
  const modalTitle = $('sf-modal-title');
  const modalBody = $('sf-modal-body');

  const FELT = { yes: 'Yes', no: 'No', 'at-times': 'At times' } as Record<string, string>;
  const NOTIFIED = { yes: 'Yes', no: 'No', na: 'N/A' } as Record<string, string>;
  const YESNO = { yes: 'Yes', no: 'No' } as Record<string, string>;

  type Row = Record<string, unknown> & { id: string };
  let rows: Row[] = [];

  const show = (el: HTMLElement, on: boolean) => { el.hidden = !on; };
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string)
    );

  function fmt(key: string, value: unknown): string {
    if (value == null || value === '') return '—';
    if (Array.isArray(value)) return value.length ? value.join(', ') : '—';
    if (key === 'summerFeltIncluded') return FELT[String(value)] || String(value);
    if (key === 'summerNotifiedBeforeXI') return NOTIFIED[String(value)] || String(value);
    if (key === 'summerUmpired') return YESNO[String(value)] || String(value);
    if (key === 'updatedAt') return new Date(String(value)).toLocaleString();
    if (key === 'summerLeadershipFeedback' && typeof value === 'object') {
      const parts = Object.entries(value as Record<string, any>).map(
        ([team, fb]) =>
          `${team} — captain: ${fb?.captain || '—'} · vice-captain: ${fb?.viceCaptain || '—'}`
      );
      return parts.length ? parts.join('\n') : '—';
    }
    return String(value);
  }

  function renderStats(s: any, teams: string[]) {
    const tiles: Array<[string, string | number]> = [
      ['Responses', s.total],
      ['Felt included', `${s.feltIncluded.yes} yes / ${s.feltIncluded['at-times']} at times / ${s.feltIncluded.no} no`],
      ['Notified before XI', `${s.notifiedBeforeXI.yes} yes / ${s.notifiedBeforeXI.no} no / ${s.notifiedBeforeXI.na} n/a`],
      ['Umpired this season', `${s.umpired?.yes ?? 0} yes / ${s.umpired?.no ?? 0} no`],
      ...teams.map((t) => [t, s.byTeam?.[t] ?? 0] as [string, number]),
    ];
    statsGrid.innerHTML = tiles
      .map(
        ([label, value]) =>
          `<div class="stat-card"><div class="stat-label">${label}</div><div class="stat-value">${value}</div></div>`
      )
      .join('');
    show(statsGrid, true);
  }

  function currentRows(): Row[] {
    const q = searchInput.value.trim().toLowerCase();
    const team = filterTeam.value;
    return rows.filter((r) => {
      if (team && !((r.summerTeamsPlayedFor as string[] | undefined) ?? []).includes(team)) return false;
      if (q) {
        const hay = `${r.firstName} ${r.lastName} ${r.email}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
  }

  function renderTable() {
    const list = currentRows();
    tbody.innerHTML = list
      .map((r) => {
        const name = `${r.firstName ?? ''} ${r.lastName ?? ''}`.trim();
        const teams = ((r.summerTeamsPlayedFor as string[] | undefined) ?? []).join(', ') || '—';
        return `<tr data-id="${r.id}">
          <td>${esc(name)}</td>
          <td class="sf-wrap">${esc(teams)}</td>
          <td>${esc(fmt('summerFeltIncluded', r.summerFeltIncluded))}</td>
          <td>${esc(fmt('summerNotifiedBeforeXI', r.summerNotifiedBeforeXI))}</td>
          <td>${esc(new Date(String(r.updatedAt)).toLocaleDateString())}</td>
        </tr>`;
      })
      .join('');
    show(tableWrap, list.length > 0);
    show(emptyBox, rows.length === 0);
    countLine.hidden = rows.length === 0;
    countLine.textContent = `Showing ${list.length} of ${rows.length}`;
  }

  function openModal(id: string) {
    const r = rows.find((x) => x.id === id);
    if (!r) return;
    modalTitle.textContent = `${r.firstName ?? ''} ${r.lastName ?? ''}`.trim() || 'Feedback';
    const rows2 = SUMMER_FEEDBACK_COLUMNS.map(
      ({ key, label }) => `<dt>${label}</dt><dd>${esc(fmt(key as string, (r as any)[key]))}</dd>`
    );
    rows2.push(
      `<dt>Captain / vice-captain feedback</dt><dd>${esc(
        fmt('summerLeadershipFeedback', (r as any).summerLeadershipFeedback)
      )}</dd>`
    );
    modalBody.innerHTML = rows2.join('');
    show(modal, true);
  }
  const closeModal = () => show(modal, false);

  async function load() {
    show(loading, true);
    show(errorBox, false);
    show(tableWrap, false);
    show(emptyBox, false);
    try {
      const res = await fetch('/.netlify/functions/winter-checkin-summer-list', {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || `HTTP ${res.status}`);
      const data = await res.json();
      rows = data.rows || [];
      const teams: string[] = data.teams || [];
      filterTeam.innerHTML =
        '<option value="">All teams</option>' + teams.map((t) => `<option>${esc(t)}</option>`).join('');
      renderStats(data.summary, teams);
      renderTable();
      show(loading, false);
    } catch (err) {
      show(loading, false);
      show(errorBox, true);
      errorText.textContent = err instanceof Error ? err.message : 'Unknown error';
    }
  }

  tbody.addEventListener('click', (e) => {
    const tr = (e.target as HTMLElement).closest('tr');
    if (tr?.dataset.id) openModal(tr.dataset.id);
  });
  [searchInput, filterTeam].forEach((el) => el.addEventListener('input', renderTable));
  $('sf-refresh').addEventListener('click', load);
  $('sf-retry').addEventListener('click', load);
  $('sf-modal-close').addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

  load();
</script>
