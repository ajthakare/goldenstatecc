    box-shadow: 0 0 0 3px rgba(246, 114, 128, 0.1);
  }

  .form-label {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: #374151;
    margin-bottom: 6px;
  }

  .form-group {
    margin-bottom: 0;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .phone-input-container {
    display: flex;
    gap: 8px;
  }

  .phone-country-select {
    width: 110px;
    padding: 10px 8px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 14px;
    background: white;
    cursor: pointer;
    transition: all 0.2s;
  }

  .phone-country-select:focus {
    outline: none;
    border-color: #A82B24;
    box-shadow: 0 0 0 3px rgba(246, 114, 128, 0.1);
  }

  .phone-number-input {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
