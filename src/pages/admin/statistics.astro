</style>

<script>
  import { escapeHtml, populateTeamFilter as _populateTeamFilter } from '../../utils/admin-ui';
  let seasons = [];
  let currentViewMode = 'season'; // 'season' or 'career'
  let currentSeasonId = '';
  let currentTeamName = '';
  let statisticsData = [];
  let totalFixturesForDisplay = 0;
  let plainStatsRaw = null;
  let plainSortColumn = 'playerName';
  let plainSortDirection = 'asc';
  let sortColumn = 'playerName';
  let sortDirection = 'asc';

  // DOM elements
  const loadingState = document.getElementById('loading-state');
  const errorState = document.getElementById('error-state');
  const errorText = document.getElementById('error-text');
  const emptyState = document.getElementById('empty-state');
  const tableContainer = document.getElementById('table-container');
  const statsTbody = document.getElementById('stats-tbody');
  const statsGrid = document.getElementById('stats-grid');
  const seasonFilter = document.getElementById('season-filter');
  const teamFilter = document.getElementById('team-filter');
  const seasonViewBtn = document.getElementById('season-view-btn');
  const careerViewBtn = document.getElementById('career-view-btn');
  const recalculateBtn = document.getElementById('recalculate-btn');
  const exportBtn = document.getElementById('export-btn');

  // Initialize tabs
  initializeTabs();

  // Load seasons on page load
  loadSeasons();

  // View mode toggle
  seasonViewBtn.addEventListener('click', () => {
    currentViewMode = 'season';
    seasonViewBtn.classList.add('active');
    careerViewBtn.classList.remove('active');
    seasonFilter.disabled = false;
    teamFilter.disabled = false;

    // Re-enable advanced/financial tabs in season view
    document.querySelectorAll('[data-tab="advanced"], [data-tab="financial"]').forEach(btn => {
      btn.style.opacity = '1';
      btn.style.pointerEvents = 'auto';
    });

    loadStatistics();
  });

  careerViewBtn.addEventListener('click', () => {
    currentViewMode = 'career';
    careerViewBtn.classList.add('active');
    seasonViewBtn.classList.remove('active');
    seasonFilter.disabled = true;
    teamFilter.disabled = true;

    // Switch to overview tab for career view
    const overviewBtn = document.querySelector('[data-tab="overview"]');
    if (overviewBtn && !overviewBtn.classList.contains('active')) {
      overviewBtn.click();
    }

    // Disable advanced/financial tabs in career view
    document.querySelectorAll('[data-tab="advanced"], [data-tab="financial"]').forEach(btn => {
      btn.style.opacity = '0.5';
      btn.style.pointerEvents = 'none';
    });

    loadStatistics();
  });

  // Filters
  seasonFilter.addEventListener('change', () => {
    currentSeasonId = seasonFilter.value;
    populateTeamFilter();
    loadStatistics();
  });

  teamFilter.addEventListener('change', () => {
    currentTeamName = teamFilter.value;
    loadStatistics();
  });

  // Recalculate
  recalculateBtn.addEventListener('click', async () => {
    if (!confirm('Recalculate all statistics? This may take a moment.')) return;

    try {
      recalculateBtn.disabled = true;
      recalculateBtn.textContent = 'Calculating...';

      const response = await fetch('/.netlify/functions/statistics-calculate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ seasonId: currentSeasonId || undefined }),
      });

      if (!response.ok) throw new Error('Failed to calculate statistics');

      const result = await response.json();
      toast.success(
        `Statistics calculated successfully! Players updated: ${result.playersUpdated}, Seasons updated: ${result.seasonsUpdated}`
      );

      await loadStatistics();
    } catch (error) {
      toast.error('Error: ' + error.message);
    } finally {
      recalculateBtn.disabled = false;
      recalculateBtn.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2a1 1 0 0 1 1 1v4h-4M4 16a1 1 0 0 1-1-1v-4h4"/>
          <path d="M15 7A7 7 0 0 0 4 9m-1 4a7 7 0 0 0 11-2"/>
        </svg>
        Recalculate
      `;
    }
  });

  // Export
  exportBtn.addEventListener('click', async () => {
    try {
      const params = new URLSearchParams();
      if (currentSeasonId) params.append('seasonId', currentSeasonId);
      if (currentTeamName) params.append('teamName', currentTeamName);

      const response = await fetch(`/.netlify/functions/statistics-export?${params}`);
      if (!response.ok) throw new Error('Failed to export statistics');

      const blob = await response.blob();
      const contentDisposition = response.headers.get('Content-Disposition');
      const filename = contentDisposition
        ? contentDisposition.split('filename=')[1]?.replace(/"/g, '')
        : 'statistics-export.csv';

      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      window.URL.revokeObjectURL(url);
      document.body.removeChild(a);
      toast.success('Statistics exported successfully');
    } catch (error) {
      toast.error('Error: ' + error.message);
    }
  });

  // Tab switching functionality
  function initializeTabs() {
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const targetTab = button.dataset.tab;

        // Remove active class from all buttons and panels
        tabButtons.forEach(btn => btn.classList.remove('active'));
        tabPanels.forEach(panel => panel.classList.remove('active'));

        // Add active class to clicked button and corresponding panel
        button.classList.add('active');
        document.getElementById(`tab-${targetTab}`).classList.add('active');

        // Save active tab to localStorage
        localStorage.setItem('statsActiveTab', targetTab);
      });
    });

    // Restore last active tab from localStorage
    const savedTab = localStorage.getItem('statsActiveTab') || 'overview';
    const savedButton = document.querySelector(`[data-tab="${savedTab}"]`);
    if (savedButton) {
      savedButton.click();
    }
  }

  // Populate Advanced tab with pre-loaded data
  function populateAdvancedTab(advancedStats) {
    const container = document.getElementById('advanced-stats-content');

    try {
      // Store data globally for rendering functions
      window.advancedStatsData = {
        playerOfMatchLeaderboard: advancedStats.playerOfMatchLeaderboard || [],
        winLossAnalysis: advancedStats.winLossAnalysis || {},
        venuePerformance: advancedStats.venuePerformance || [],
        playingTimeReport: advancedStats.playingTimeReport || [],
        umpireFees: window.consolidatedStats?.financialStats?.umpireFees || { totalPaid: 0, players: [] },
        dutyAnalysis: window.consolidatedStats?.financialStats?.dutyAnalysis || []
      };


      // Create DOM structure directly in the tab
      container.innerHTML = `
        <div class="stats-column">
          <div class="stats-section">
            <div class="stats-section-header">
              <div class="stats-section-icon">🏆</div>
              <h3 class="stats-section-title">Player of Match Leaderboard</h3>
            </div>
            <div id="player-of-match-content">
              <canvas id="player-of-match-chart" style="max-height: 400px;"></canvas>
            </div>
          </div>

          <div class="stats-section">
            <div class="stats-section-header">
              <div class="stats-section-icon">📊</div>
              <h3 class="stats-section-title">Win/Loss Analysis</h3>
            </div>
            <div id="win-loss-content"></div>
          </div>

          <div class="stats-section">
            <div class="stats-section-header">
              <div class="stats-section-icon">🏟️</div>
              <h3 class="stats-section-title">Venue Performance</h3>
            </div>
            <div id="venue-performance-content"></div>
          </div>

          <div class="stats-section">
            <div class="stats-section-header">
              <div class="stats-section-icon">⏱️</div>
              <h3 class="stats-section-title">Playing Time Report</h3>
            </div>
            <div id="playing-time-content"></div>
          </div>
        </div>
      `;

      // Now render data into the newly created containers
      // Use setTimeout to ensure DOM is fully ready for chart rendering
      setTimeout(() => {
        renderPlayerOfMatchLeaderboard();
        renderWinLossAnalysis();
        renderVenuePerformance();
        renderPlayingTimeReport();
      }, 100);
    } catch (error) {
      console.error('Error populating advanced tab:', error);
      container.innerHTML = '<div class="alert alert-error"><p>Error loading advanced statistics</p></div>';
    }
  }

  // Populate Financial tab with pre-loaded data
  function populateFinancialTab(financialStats) {
    const container = document.getElementById('financial-stats-content');

    try {
      // Ensure data has correct structure with defaults
      const safeUmpireFees = {
        totalPaid: financialStats.umpireFees?.totalPaid || 0,
        players: financialStats.umpireFees?.players || []
      };
      const safeDutyAnalysis = financialStats.dutyAnalysis || [];

      // Update global stats object with safe data
      if (!window.advancedStatsData) window.advancedStatsData = {};
      window.advancedStatsData.umpireFees = safeUmpireFees;
      window.advancedStatsData.dutyAnalysis = safeDutyAnalysis;

      // Create DOM structure directly in the tab
      container.innerHTML = `
        <div class="stats-column">
          <div class="stats-section">
            <div class="stats-section-header">
              <div class="stats-section-icon">💰</div>
              <h3 class="stats-section-title">Umpire Fees Tracking</h3>
            </div>
            <div id="umpire-fees-content"></div>
          </div>

          <div class="stats-section">
            <div class="stats-section-header">
              <div class="stats-section-icon">👔</div>
              <h3 class="stats-section-title">Duty Analysis</h3>
            </div>
            <div id="duty-analysis-content">
              <canvas id="duty-chart" style="max-height: 400px;"></canvas>
            </div>
          </div>
        </div>
      `;

      // Now render data into the newly created containers
      // Use setTimeout to ensure DOM is fully ready for chart rendering
      setTimeout(() => {
        renderUmpireFees();
        renderDutyAnalysis();
      }, 100);
    } catch (error) {
      console.error('Error populating financial tab:', error);
      container.innerHTML = '<div class="alert alert-error"><p>Error loading financial statistics</p></div>';
    }
  }


  function populateTeamFilter() {
    _populateTeamFilter(seasons, seasonFilter, teamFilter, currentSeasonId, () => {
      currentTeamName = '';
    });
  }

  async function loadSeasons() {
    try {
      const response = await fetch('/.netlify/functions/seasons-list');
      if (!response.ok) throw new Error('Failed to load seasons');

      seasons = await response.json();

      // Update season filter
      seasonFilter.innerHTML = seasons
        .map(
          (s) =>
            `<option value="${s.id}" ${s.isActive ? 'selected' : ''}>${escapeHtml(s.name)}${s.isActive ? ' (Active)' : ''}</option>`
        )
        .join('');

      // Set current season
      const activeSeason = seasons.find((s) => s.isActive);
      currentSeasonId = activeSeason ? activeSeason.id : seasons[0]?.id || '';

      // Populate team filter for initial season
      populateTeamFilter();

      // Load statistics
      if (currentSeasonId) {
        await loadStatistics();
      }
    } catch (error) {
      console.error('Error loading seasons:', error);
      errorState.style.display = 'flex';
      errorText.textContent = 'Failed to load seasons: ' + error.message;
    }
  }

  async function loadStatistics() {
    try {
      loadingState.style.display = 'flex';
      errorState.style.display = 'none';
      emptyState.style.display = 'none';
      tableContainer.style.display = 'none';
      statsGrid.style.display = 'none';

      if (currentViewMode === 'season') {
        await loadSeasonStats();
      } else {
        await loadCareerStats();
      }

      loadingState.style.display = 'none';

      if (statisticsData.length === 0) {
        emptyState.style.display = 'flex';
      } else {
        updateStatsCards();
        renderStatistics();
        statsGrid.style.display = 'grid';
        tableContainer.style.display = 'block';
      }
    } catch (error) {
      console.error('Error loading statistics:', error);
      loadingState.style.display = 'none';
      errorState.style.display = 'flex';
      errorText.textContent = error.message;
    }
  }

  async function loadSeasonStats() {
    if (!currentSeasonId) {
      throw new Error('No season selected');
    }

    totalFixturesForDisplay = 0;

    if (currentTeamName) {
      // Load team stats + season-wide stats in parallel (the latter keeps Plain Stats populated)
      const [teamResponse, allResponse] = await Promise.all([
        fetch(`/.netlify/functions/statistics-team-get?seasonId=${currentSeasonId}&teamName=${encodeURIComponent(currentTeamName)}`),
        fetch(`/.netlify/functions/statistics-all?seasonId=${currentSeasonId}`),
      ]);

      if (teamResponse.status === 404) {
        statisticsData = [];
        return;
      }

      if (!teamResponse.ok) throw new Error('Failed to load team statistics');

      const teamStats = await teamResponse.json();
      totalFixturesForDisplay = teamStats.totalFixtures || 0;
      statisticsData = teamStats.playerStats.map((p) => ({
        playerId: p.playerId,
        playerName: p.playerName,
        team: currentTeamName,
        totalFixtures: p.stats.totalFixtures,
        timesAvailable: p.stats.timesAvailable,
        gamesPlayed: p.stats.gamesPlayed,
        availabilityRate: p.stats.availabilityRate,
        selectionRate: p.stats.selectionRate,
      }));

      if (allResponse.ok) {
        const allStats = await allResponse.json();
        window.consolidatedStats = allStats;
        populateAdvancedTab(allStats.advancedStats);
        populateFinancialTab(allStats.financialStats);
        populatePlainStatsTab(allStats.plainStats);
      }
    } else {
      // CONSOLIDATED LOAD: Get ALL statistics in ONE call
      const response = await fetch(
        `/.netlify/functions/statistics-all?seasonId=${currentSeasonId}`
      );

      if (response.status === 404) {
        statisticsData = [];
        return;
      }

      if (!response.ok) {
        throw new Error('Failed to load statistics');
      }

      const allStats = await response.json();

      // Update last calculated timestamp
      if (allStats.calculatedAt) {
        displayLastCalculated(allStats.calculatedAt);
      }

      totalFixturesForDisplay = allStats.basicStats?.summary?.totalFixtures || 0;

      // Transform basic stats data to table format (Overview tab)
      statisticsData = allStats.basicStats.playerStats.map((p) => ({
        playerId: p.playerId,
        playerName: p.playerName,
        team: p.teams.join(', '),
        totalFixtures: p.clubStats.totalFixtures,
        timesAvailable: p.clubStats.timesAvailable,
        gamesPlayed: p.clubStats.gamesPlayed,
        availabilityRate: p.clubStats.availabilityRate,
        selectionRate: p.clubStats.selectionRate,
      }));

      // Store consolidated stats globally for tab access
      window.consolidatedStats = allStats;

      // Populate Advanced and Financial tabs immediately (no lazy loading!)
      populateAdvancedTab(allStats.advancedStats);
      populateFinancialTab(allStats.financialStats);
      populatePlainStatsTab(allStats.plainStats);
    }
  }

  function displayLastCalculated(timestamp) {
    try {
      const lastUpdatedDate = new Date(timestamp);
      const now = new Date();
      const diffMs = now - lastUpdatedDate;
      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
      const diffMinutes = Math.floor(diffMs / (1000 * 60));

      let timeAgo = '';
      if (diffDays > 0) {
        timeAgo = `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
      } else if (diffHours > 0) {
        timeAgo = `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
      } else if (diffMinutes > 0) {
        timeAgo = `${diffMinutes} minute${diffMinutes > 1 ? 's' : ''} ago`;
      } else {
        timeAgo = 'Just now';
      }

      const formattedDate = lastUpdatedDate.toLocaleString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true
      });

      document.getElementById('last-calculated-time').textContent = `${formattedDate} (${timeAgo})`;
      document.getElementById('last-calculated').style.display = 'block';

      // Add visual indicator if data is stale (> 7 days)
      const lastCalcElement = document.getElementById('last-calculated');
      if (diffDays > 7) {
        lastCalcElement.style.color = '#dc2626'; // Red for stale data
        lastCalcElement.title = 'Statistics are stale. Consider recalculating.';
      } else {
        lastCalcElement.style.color = '#6b7280'; // Normal gray
        lastCalcElement.title = '';
      }
    } catch (error) {
      console.error('Error displaying last calculated time:', error);
    }
  }

  async function loadCareerStats() {
    // PERFORMANCE OPTIMIZATION: Use bulk endpoint instead of 50+ individual calls
    const response = await fetch(
      '/.netlify/functions/statistics-career-bulk?includeInactive=false'
    );

    if (!response.ok) {
      throw new Error('Failed to load career statistics');
    }

    const careerData = await response.json();

    // Transform to existing data structure
    statisticsData = careerData.playerStats.map((p) => ({
      playerId: p.playerId,
      playerName: p.playerName,
      team: p.teams.join(', '),
      totalFixtures: p.careerStats.totalFixtures,
      timesAvailable: Math.round(
        (p.careerStats.careerAvailabilityRate / 100) *
        p.careerStats.totalFixtures
      ),
      gamesPlayed: p.careerStats.totalGamesPlayed,
      availabilityRate: p.careerStats.careerAvailabilityRate,
      selectionRate: p.careerStats.careerSelectionRate,
    }));

    // Plain Stats career rows — built from careerStats.activity, no core-gating
    const careerPlain = {
      playerStats: careerData.playerStats
        .filter((p) => p.careerStats?.activity)
        .map((p) => ({
          playerId: p.playerId,
          playerName: p.playerName,
          teams: p.teams,
          activityStats: p.careerStats.activity,
        })),
      summary: {
        totalPastFixtures: careerData.playerStats.reduce(
          (max, p) => Math.max(max, p.careerStats?.totalFixtures || 0),
          0
        ),
        totalPlayersWithActivity: careerData.playerStats.filter(
          (p) => (p.careerStats?.activity?.timesAvailable || 0) > 0
            || (p.careerStats?.activity?.timesSelected || 0) > 0
        ).length,
        totalAvailabilityRecords: careerData.playerStats.reduce(
          (sum, p) => sum + (p.careerStats?.activity?.timesAvailable || 0),
          0
        ),
        totalSelectionRecords: careerData.playerStats.reduce(
          (sum, p) => sum + (p.careerStats?.activity?.timesSelected || 0),
          0
        ),
      },
    };
    populatePlainStatsTab(careerPlain);
  }

  function updateStatsCards() {
    const totalPlayers = new Set(statisticsData.map((s) => s.playerId)).size;
    const totalFixtures = currentViewMode === 'season'
      ? totalFixturesForDisplay
      : Math.max(...statisticsData.map((s) => s.totalFixtures), 0);
    const avgAvailability = statisticsData.length > 0
      ? Math.round(
          statisticsData.reduce((sum, s) => sum + s.availabilityRate, 0) / statisticsData.length
        )
      : 0;
    const avgSelection = statisticsData.length > 0
      ? Math.round(
          statisticsData.reduce((sum, s) => sum + s.selectionRate, 0) / statisticsData.length
        )
      : 0;

    document.getElementById('stat-total-players').textContent = totalPlayers;
    document.getElementById('stat-total-fixtures').textContent = totalFixtures;
    document.getElementById('stat-avg-availability').textContent = avgAvailability + '%';
    document.getElementById('stat-avg-selection').textContent = avgSelection + '%';
  }

  function renderStatistics() {
    if (statisticsData.length === 0) {
      statsTbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 2rem; color: #6b7280;">No statistics found</td></tr>';
      return;
    }

    // Sort data
    const sorted = [...statisticsData].sort((a, b) => {
      const aVal = a[sortColumn];
      const bVal = b[sortColumn];

      if (typeof aVal === 'string') {
        return sortDirection === 'asc'
          ? aVal.localeCompare(bVal)
          : bVal.localeCompare(aVal);
      }

      return sortDirection === 'asc' ? aVal - bVal : bVal - aVal;
    });

    statsTbody.innerHTML = sorted
      .map(
        (stat) => {
          // Handle multiple teams - split by comma and create multiple badges
          const teams = stat.team.split(',').map(t => t.trim());
          const teamBadges = teams.map(team =>
            `<span class="team-badge">${escapeHtml(team)}</span>`
          ).join(' ');

          return `
      <tr>
        <td><strong>${escapeHtml(stat.playerName)}</strong></td>
        <td>${teamBadges}</td>
        <td style="text-align: center;">${stat.totalFixtures}</td>
        <td style="text-align: center;">${stat.timesAvailable}</td>
        <td style="text-align: center;">${stat.gamesPlayed}</td>
        <td style="text-align: center;">
          <span class="rate-badge ${getRateClass(stat.availabilityRate)}">
            ${stat.availabilityRate}%
          </span>
        </td>
        <td style="text-align: center;">
          <span class="rate-badge ${getRateClass(stat.selectionRate)}">
            ${stat.selectionRate}%
          </span>
        </td>
      </tr>
    `;
        }
      )
      .join('');

    // Update sort indicators
    document.querySelectorAll('.sortable').forEach((th) => {
      th.classList.remove('sorted');
      if (th.dataset.sort === sortColumn) {
        th.classList.add('sorted');
      }
    });
  }

  function getRateClass(rate) {
    if (rate >= 80) return 'rate-high';
    if (rate >= 50) return 'rate-medium';
    return 'rate-low';
  }

  // Sort functionality
  document.querySelectorAll('.sortable').forEach((th) => {
    th.addEventListener('click', () => {
      const column = th.dataset.sort;
      if (!column) return;
      if (sortColumn === column) {
        sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
      } else {
        sortColumn = column;
        sortDirection = 'asc';
      }
      renderStatistics();
    });
  });

  // Plain Stats tab
  function populatePlainStatsTab(plainStats) {
    const empty = document.getElementById('plain-empty');
    const content = document.getElementById('plain-content');
    const summary = plainStats?.summary;
    const hasData = summary
      && ((summary.totalAvailabilityRecords || 0) > 0
        || (summary.totalSelectionRecords || 0) > 0
        || (summary.totalPlayersWithActivity || 0) > 0);

    if (!plainStats || !Array.isArray(plainStats.playerStats) || !hasData) {
      plainStatsRaw = null;
      content.style.display = 'none';
      empty.style.display = 'flex';
      return;
    }
    plainStatsRaw = plainStats;
    empty.style.display = 'none';
    content.style.display = 'block';
    renderPlainStats();
  }

  function renderPlainStats() {
    if (!plainStatsRaw) return;

    const teamFilter = currentTeamName;
    const allPlayers = plainStatsRaw.playerStats || [];
    const teamPastFixtures = plainStatsRaw.summary?.teamPastFixtures || {};

    // Build rendering rows. When team filter is active, use per-team breakdown
    // so counts and rates reflect only that team's activity.
    const rows = allPlayers
      .map((p) => {
        if (teamFilter) {
          const tStats = p.teamActivityStats?.[teamFilter];
          if (!tStats) return null;
          return {
            playerId: p.playerId,
            playerName: p.playerName,
            teams: [teamFilter],
            activityStats: tStats,
          };
        }
        return {
          playerId: p.playerId,
          playerName: p.playerName,
          teams: p.teams || [],
          activityStats: p.activityStats || {},
        };
      })
      .filter((p) => p !== null)
      .filter(
        (p) => (p.activityStats.timesAvailable || 0) > 0
          || (p.activityStats.timesSelected || 0) > 0
      );

    const pastFixtures = teamFilter
      ? (teamPastFixtures[teamFilter] || 0)
      : (plainStatsRaw.summary?.totalPastFixtures || 0);
    document.getElementById('plain-players-with-activity').textContent = rows.length;
    document.getElementById('plain-past-fixtures').textContent = pastFixtures;

    const sorted = [...rows].sort((a, b) => {
      const av = plainSortValue(a, plainSortColumn);
      const bv = plainSortValue(b, plainSortColumn);
      const cmp = typeof av === 'number' && typeof bv === 'number'
        ? av - bv
        : String(av).localeCompare(String(bv));
      return plainSortDirection === 'asc' ? cmp : -cmp;
    });

    const tbody = document.getElementById('plain-tbody');
    tbody.innerHTML = sorted.map((p) => {
      const teamBadges = (p.teams || [])
        .map((t) => `<span class="team-badge">${escapeHtml(t)}</span>`)
        .join(' ');
      const a = p.activityStats || {};
      return `
        <tr>
          <td><strong>${escapeHtml(p.playerName)}</strong></td>
          <td>${teamBadges}</td>
          <td style="text-align: center;">${a.timesAvailable || 0}</td>
          <td style="text-align: center;">${a.timesSelected || 0}</td>
          <td style="text-align: center;">
            <span class="rate-badge ${getRateClass(a.availabilityRate || 0)}">${a.availabilityRate || 0}%</span>
          </td>
          <td style="text-align: center;">
            <span class="rate-badge ${getRateClass(a.selectionRate || 0)}">${a.selectionRate || 0}%</span>
          </td>
        </tr>
      `;
    }).join('');

    document.querySelectorAll('[data-plain-sort]').forEach((th) => {
      th.classList.remove('sorted');
      if (th.dataset.plainSort === plainSortColumn) th.classList.add('sorted');
    });
  }

  function plainSortValue(row, key) {
    if (key === 'playerName') return row.playerName || '';
    if (key === 'team') return (row.teams || []).join(', ');
    return row.activityStats?.[key] || 0;
  }

  document.querySelectorAll('[data-plain-sort]').forEach((th) => {
    th.addEventListener('click', () => {
      const column = th.dataset.plainSort;
      if (!column) return;
      if (plainSortColumn === column) {
        plainSortDirection = plainSortDirection === 'asc' ? 'desc' : 'asc';
      } else {
        plainSortColumn = column;
        plainSortDirection = 'asc';
      }
      renderPlainStats();
    });
  });

