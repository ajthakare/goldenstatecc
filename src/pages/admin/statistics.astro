                <td class="text-center">${p.attended}</td>
                <td class="text-center">${p.nccaSent}</td>
                <td class="text-center">${p.upcoming}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  }

  function renderFinancialTotals() {
    const fees = window.advancedStatsData?.umpireFees || { totalPaid: 0, players: [] };
    const club = window.advancedStatsData?.clubPaidUmpiring || { totalPaid: 0, paidSlots: 0 };
    const feeGames = fees.players.reduce((sum, p) => sum + (p.timesPaid || 0), 0);
    document.getElementById('financial-totals').innerHTML = miniCards([
      ['Match umpire fees', money(fees.totalPaid), `Paid by captains · ${feeGames} game${feeGames === 1 ? '' : 's'}`],
      ['Club-paid umpiring', money(club.totalPaid), `Paid by the club · ${club.paidSlots} duty slot${club.paidSlots === 1 ? '' : 's'}`],
    ]);
  }

  function renderUmpireFees() {
    const container = document.getElementById('umpire-fees-content');
    const data = window.advancedStatsData?.umpireFees;

    if (!data || !data.players || data.players.length === 0) {
      container.innerHTML = insufficient('💰', 'Umpire fees are recorded with each game\'s result. None recorded for these games.');
      return;
    }

    container.innerHTML = `
      <p class="section-description">Panel umpires at our own games, paid by the captain.</p>
      <div class="table-responsive">
        <table class="data-mini-table umpire-fees-table">
          <thead>
            <tr>
              <th>Paid by</th>
              <th class="text-center">Times Paid</th>
              <th class="text-right">Total Amount</th>
            </tr>
          </thead>
          <tbody>
            ${data.players.map(p => `
              <tr>
                <td><strong>${escapeHtml(p.name || '')}</strong></td>
                <td class="text-center">${p.timesPaid || 0}</td>
                <td class="text-right">${money(p.totalAmount)}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  }

  function renderClubPaidUmpiring() {
    const container = document.getElementById('club-paid-content');
    const data = window.advancedStatsData?.clubPaidUmpiring;
    const c = data?.coverage;

    if (!data || !c || c.totalDuties === 0) {
      container.innerHTML = insufficient('🧾', 'No umpiring duties this season. They\'re imported in Umpiring.');
      return;
    }

    const coverageRows = [
      ['Our players went', c.ourPlayers],
      ['Club paid someone to go', c.paidCover],
      ['Someone else went, unpaid', c.othersUnpaid],
      ['NCCA sent their own umpire', c.nccaSent],
      ['Attendance not confirmed', c.notConfirmed],
      ['Nobody assigned (duties)', c.unassigned],
    ];

    const teamsWithPayments = (data.byTeam || []).filter(t => t.paidSlots > 0);

    container.innerHTML = `
      <p class="section-description">What the club paid whoever covered an umpiring duty, our own players included.</p>
      ${miniCards([
        ['Total paid', money(data.totalPaid)],
        ['Paid slots', data.paidSlots],
        ['Average per slot', data.paidSlots ? money(data.averagePerSlot) : '–'],
      ])}

      <h4 class="subsection-heading">How duties were covered</h4>
      <p class="section-description">
        ${c.totalDuties} dut${c.totalDuties === 1 ? 'y' : 'ies'}: ${c.pastDuties} played, ${c.upcomingDuties} upcoming, ${c.cancelled} cancelled.
        Counted per umpire slot for duties already played.
      </p>
      <div class="table-responsive">
        <table class="data-mini-table">
          <tbody>
            ${coverageRows.map(([label, n]) => `
              <tr><td>${label}</td><td class="text-right"><strong>${n}</strong></td></tr>
            `).join('')}
          </tbody>
        </table>
      </div>

      ${teamsWithPayments.length > 1 ? `
        <h4 class="subsection-heading">By umpiring team</h4>
        <div class="table-responsive">
          <table class="data-mini-table">
            <thead><tr><th>Team</th><th class="text-center">Paid slots</th><th class="text-right">Total</th></tr></thead>
            <tbody>
              ${teamsWithPayments.map(t => `
                <tr><td><strong>${escapeHtml(t.team)}</strong></td><td class="text-center">${t.paidSlots}</td><td class="text-right">${money(t.totalPaid)}</td></tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      ` : ''}

      <h4 class="subsection-heading">Paid to</h4>
      ${data.recipients.length === 0 ? '<p class="empty-text">No club payments recorded yet.</p>' : `
        <div class="table-responsive">
          <table class="data-mini-table">
            <thead><tr><th>Name</th><th class="text-center">Times</th><th class="text-right">Total</th></tr></thead>
            <tbody>
              ${data.recipients.map(r => `
                <tr>
                  <td>
                    <strong>${escapeHtml(r.name)}</strong>
                    <span class="kind-tag ${r.kind}">${r.kind === 'player' ? 'GSCC player' : 'External'}</span>
                    ${r.club ? `<div class="mini-card-note">${escapeHtml(r.club)}</div>` : ''}
                  </td>
                  <td class="text-center">${r.timesPaid}</td>
                  <td class="text-right">${money(r.totalAmount)}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `}
    `;
  }
</script>
