---
export const prerender = false;

import { logoutCookies } from '../../middleware/auth';

// Clear the session cookie (shared and host-only) and go to the login page
const headers = new Headers({ Location: '/admin/login' });
for (const cookie of logoutCookies(import.meta.env.PROD, Astro.url.host)) {
  headers.append('Set-Cookie', cookie);
}
return new Response(null, { status: 302, headers });
---
