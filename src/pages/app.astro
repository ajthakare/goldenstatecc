---
export const prerender = false;

// PWA entry point — routes based on auth status
// start_url in manifest.json points here
import { validateAdminSession, isMember } from '../middleware/auth';

const cookieHeader = Astro.request.headers.get('cookie');
const session = cookieHeader ? validateAdminSession(cookieHeader) : null;

// The Club Feed is the app's home screen
if (session && isMember(session)) {
  return Astro.redirect('/feed');
} else {
  return Astro.redirect('/login');
}
---
