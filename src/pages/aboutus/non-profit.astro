---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import MemberCard from '../../components/MemberCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import NonProfitBadge from '../../components/NonProfitBadge.astro';
import ZeffyDonation from '../../components/ZeffyDonation.astro';
import Icon from '../../components/Icon.astro';
import { SITE_CONFIG } from '../../config';

const boardMembers = [
    { name: 'Raiyan M', role: 'Board Member' },
    { name: 'Anirban Paul', role: 'Board Member' },
    { name: 'Razab Chowdhury', role: 'Board Member' }
];

const programs = [
    { icon: 'trophy', title: 'Competitive Cricket Teams', content: 'Competitive teams competing in NCCA and BACA leagues since 2018, representing Northern California.' },
    { icon: 'graduation-cap', title: 'Youth Cricket Development', content: 'Youth academy welcoming players ages 8-18, with free membership for students and youth. Focus on reaching underrepresented communities.' },
    { icon: 'star', title: 'Player Pathway Program', content: "Supporting members' participation in USA Masters League and USA Minor League, creating pathways for competitive cricket development." },
    { icon: 'users', title: 'Community Engagement', content: 'Building a diverse cricket community with 160+ members from 8 counties across the Bay Area, fostering inclusivity and sportsmanship.' },
    { icon: 'ticket', title: 'Inclusive Membership', content: "Free membership for youth (under 18) and full-time students, ensuring financial barriers don't prevent participation in cricket." },
    { icon: 'building', title: 'Northern California Cricket Association', content: 'Active participation in NCCA leagues (established 1892) with 2200+ members and 54+ clubs, promoting cricket across Northern California.' }
];

const story = [
    { k: 'Why', v: 'Bengals Inc. was established with a simple but powerful belief: sport is a universal language that builds community, character, and opportunity. Sports nurture physical health, mental resilience, discipline, teamwork, leadership, and respect.' },
    { k: 'What', v: 'At its core, Bengals Inc. promotes cricket across the Bay Area as both a competitive and community sport. Cricket is the foundation, but our vision goes further — toward a multi-sport community club embracing running, volleyball, badminton, soccer, baseball, and more.' },
    { k: 'How', v: 'We build organized teams and leagues, partner with schools and local districts, invest in youth development, and create safe, well-governed pathways for participation. GSCC is Step 1 in this journey.' }
];

const impactIcons: Record<string, string> = {
    'Active Members': 'users',
    'Youth & Students': 'graduation-cap',
    'Counties Represented': 'map-pin',
    'Years of Service': 'hourglass'
};

const pageTitle = 'Non-Profit Organization | Bengals Inc. - 501(c)(3)';
const pageDescription = "Golden State Cricket Club is a part of Bengals Inc. - a 501(c)(3) non-profit organization fostering community connection through cricket across Northern California's Bay Area.";
---

<Layout title={pageTitle}>
    <meta slot="head" name="description" content={pageDescription} />
    <meta slot="head" property="og:title" content={pageTitle} />
    <meta slot="head" property="og:description" content={pageDescription} />
    <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": ["NonprofitOrganization", "SportsOrganization"],
      "name": "Bengals Inc.",
      "legalName": "Bengals Inc.",
      "alternateName": "Golden State Cricket Club",
      "taxID": "30-13XXXXX",
      "nonprofitStatus": "Nonprofit501c3",
      "foundingDate": "2018",
      "mission": "To foster a vibrant, inclusive community through the power of sport.",
      "knowsAbout": ["Cricket", "Youth Development", "Community Building", "Sports Education"]
    }
    </script>

    <PageHeader kicker="501(c)(3) non-profit" title={SITE_CONFIG.nonProfit.name} subtitle="Empowering community and excellence through sport." />

    <div class="flex flex-wrap items-center gap-4 mb-10">
        <NonProfitBadge size="lg" showEIN={true} />
        <a href="#donation-section" class="btn btn-lg"><Icon name="heart" size={18} /> Make a donation</a>
    </div>

    <Section title="Our Mission" kicker="Purpose" align="left">
        <div class="accent-box">
            <h3 class="subsection-heading" style="color:var(--color-maroon-600);">"Empowering Community and Excellence Through Sport"</h3>
            <p class="text-body-lg measure mb-0">{SITE_CONFIG.nonProfit.mission}</p>
        </div>
    </Section>

    <Section title="Our Impact" kicker="By the numbers" variant="alternate">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            {SITE_CONFIG.nonProfit.impactStats.map(stat => (
                <div class="stat-box text-center">
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-[10px] mb-3" style="background:var(--color-gold-100);color:var(--color-gold-600);">
                        <Icon name={impactIcons[stat.label] ?? 'star'} size={20} />
                    </span>
                    <div class="text-4xl font-extrabold" style="color:var(--color-maroon-600);font-variant-numeric:tabular-nums;">{stat.value}</div>
                    <div class="text-sm text-muted font-semibold mt-1">{stat.label}</div>
                </div>
            ))}
        </div>
        <p class="text-center text-muted measure mx-auto" style="margin-inline:auto;">
            Since our founding in {SITE_CONFIG.nonProfit.founded}, we've been dedicated to making cricket
            accessible and fostering a love for the sport across Northern California.
        </p>
    </Section>

    <Section title="Our Story" kicker="Why we exist">
        <div class="grid md:grid-cols-3 gap-6">
            {story.map(s => (
                <div class="card card-static">
                    <h3 class="subsection-heading" style="color:var(--color-maroon-600);">{s.k}</h3>
                    <p class="text-body-base mb-0">{s.v}</p>
                </div>
            ))}
        </div>
    </Section>

    <Section title="Our Programs" kicker="What we do" variant="alternate">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {programs.map(program => (
                <div class="card card-static">
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-[10px] mb-3" style="background:var(--color-maroon-100);color:var(--color-maroon-600);">
                        <Icon name={program.icon} size={20} />
                    </span>
                    <h3 class="subsection-heading">{program.title}</h3>
                    <p class="text-body-base mb-0">{program.content}</p>
                </div>
            ))}
        </div>
    </Section>

    <Section title="Board of Directors" kicker="Governance">
        <p class="section-centered text-body-lg mb-8">
            Our foundation is governed by a dedicated board committed to transparency, accountability, and advancing our mission.
        </p>
        <div class="member-grid mx-auto">
            {boardMembers.map(member => <MemberCard name={member.name} role={member.role} />)}
        </div>
    </Section>

    <Section variant="alternate">
        <div id="donation-section" class="max-w-4xl mx-auto scroll-mt-24">
            <ZeffyDonation />
            <div class="card card-static mt-8">
                <h3 class="subsection-heading text-center">Tax deduction information</h3>
                <p class="text-sm text-muted text-center measure mx-auto mb-0" style="margin-inline:auto;">
                    <strong>{SITE_CONFIG.nonProfit.name}</strong> is a {SITE_CONFIG.nonProfit.status}. EIN: {SITE_CONFIG.nonProfit.ein}.
                    Donations are tax-deductible to the extent allowed by law. No goods or services were provided in
                    exchange for your donation. You'll receive an email receipt immediately after donating.
                </p>
            </div>
        </div>
    </Section>

    <Section title="Other Ways to Help" kicker="Get involved">
        <div class="accent-box text-center">
            <p class="text-body-lg mb-6">Can't donate right now? There are other ways to support our mission.</p>
            <div class="grid sm:grid-cols-3 gap-3">
                <a href="/members" class="btn btn-secondary">Volunteer</a>
                <a href="/contact" class="btn btn-secondary">Partner with us</a>
                <a href="/gallery" class="btn btn-secondary">Share our story</a>
            </div>
        </div>
    </Section>
</Layout>
