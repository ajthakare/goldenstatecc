---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import SponsorTierCard from '../../components/SponsorTierCard.astro';
import SponsorLogo from '../../components/SponsorLogo.astro';
import SponsorTimelineYear from '../../components/SponsorTimelineYear.astro';
import { SPONSORS } from '../../config';

const sponsorsByYear = [2025, 2024, 2023, 2022].map((year) => ({
    year,
    platinum: SPONSORS.past.filter((s) => s.years?.includes(year) && s.tier === 'platinum'),
    gold: SPONSORS.past.filter((s) => s.years?.includes(year) && s.tier === 'gold')
}));

const value = [
    { icon: 'target', title: 'Why sponsor?', points: ['Brand visibility supporting local community', 'Social media presence with active tagging', 'Reach across 8 Bay Area counties'] },
    { icon: 'briefcase', title: 'What you get', points: ['Promotional campaigns to exclusive members', 'Access to corporate & university connections', 'Support cross-community events'] },
    { icon: 'map-pin', title: "Where you're featured", points: ['Team jerseys', 'Social media & YouTube livestreams', 'Club events & hosting opportunities'] }
];

const notes = [
    'Sponsorship is for one full season and can be renewed at the end of each season.',
    'Jersey will carry the sponsor logo in compliance with league rules.',
    'Bengals Inc. is a 501(c)(3) non-profit. Sponsorships may be tax-deductible — consult your tax advisor.',
    'Sponsorship does not guarantee any direct revenue generation opportunity.',
    'All data shared is with the consent of club members. No PII is shared with potential sponsors.',
    'The club and its executives are not responsible for any financial obligations.'
];
---

<Layout title="Sponsorships - Golden State Cricket Club">
    <PageHeader
        kicker="Partner with us"
        title="Partner With Us"
        subtitle="Join leading Bay Area businesses in supporting local cricket while gaining visibility across our community of players and fans."
    />

    <Section title="Why sponsor Golden State Cricket Club?" kicker="The case" variant="alternate">
        <div class="grid md:grid-cols-3 gap-6">
            {value.map(v => (
                <div class="card card-static">
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-[10px] mb-3" style="background:var(--color-maroon-100);color:var(--color-maroon-600);">
                        <Icon name={v.icon} size={20} />
                    </span>
                    <h3 class="subsection-heading">{v.title}</h3>
                    <ul class="space-y-1.5 text-body-base">
                        {v.points.map(p => (
                            <li class="flex gap-2"><Icon name="check" size={16} class="mt-1 shrink-0" style="color:var(--color-gold-600);" />{p}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </Section>

    <Section title="Sponsorship Tiers" kicker="Options">
        <p class="section-centered text-body-lg mb-8" style="margin-inline:auto;">
            Choose the level that fits your goals. All sponsorships run for one full season and are renewable annually.
        </p>
        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            {SPONSORS.tiers.map((tier) => <SponsorTierCard tier={tier} />)}
        </div>
    </Section>

    <Section title="Our Current Sponsors" kicker="Thank you" variant="alternate">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {SPONSORS.current.map((sponsor) => <SponsorLogo sponsor={sponsor} showDescription={true} />)}
        </div>
    </Section>

    <Section title="How your brand is represented" kicker="Placement">
        <div class="grid md:grid-cols-2 gap-6">
            <div class="card card-static">
                <h3 class="subsection-heading">Jersey placement</h3>
                <ul class="space-y-3 text-body-base">
                    <li class="flex items-start gap-2"><Icon name="star" size={16} class="mt-1 shrink-0 text-muted" /><span><strong>Platinum:</strong> logo on front and back of jersey</span></li>
                    <li class="flex items-start gap-2"><Icon name="star" size={16} class="mt-1 shrink-0" style="color:var(--color-gold-600);" /><span><strong>Gold:</strong> logo on side sleeve (one sleeve)</span></li>
                </ul>
            </div>
            <div class="card card-static">
                <h3 class="subsection-heading">Media exposure</h3>
                <ul class="space-y-3 text-body-base">
                    <li class="flex items-start gap-2"><Icon name="instagram" size={16} class="mt-1 shrink-0 text-muted" />Instagram posts &amp; stories</li>
                    <li class="flex items-start gap-2"><Icon name="youtube" size={16} class="mt-1 shrink-0 text-muted" />YouTube match livestreams</li>
                    <li class="flex items-start gap-2"><Icon name="sparkles" size={16} class="mt-1 shrink-0 text-muted" />Club events &amp; gatherings</li>
                </ul>
            </div>
        </div>
    </Section>

    <Section title="Previous season sponsors" kicker="History" variant="alternate">
        <p class="section-centered text-body-lg mb-8" style="margin-inline:auto;">Thank you to all our past sponsors who have supported the club.</p>
        <div class="space-y-12 max-w-5xl mx-auto">
            {sponsorsByYear.map((yearData) => (
                <SponsorTimelineYear year={yearData.year} sponsors={{ platinum: yearData.platinum, gold: yearData.gold }} />
            ))}
        </div>
    </Section>

    <Section title="Ready to become a sponsor?" kicker="Next step" id="contact">
        <div class="accent-box text-center">
            <h3 class="subsection-heading">Let's talk partnership</h3>
            <p class="text-body-lg mb-6">Interested in supporting Golden State Cricket Club? Get in touch to discuss opportunities.</p>
            <a href="/contact" class="btn btn-lg">Contact us <Icon name="arrow-right" size={16} /></a>
        </div>
    </Section>

    <Section variant="alternate">
        <div class="card card-static max-w-3xl mx-auto">
            <h3 class="subsection-heading text-center">Important information</h3>
            <ul class="space-y-2 text-sm text-muted">
                {notes.map(n => (
                    <li class="flex items-start gap-2"><Icon name="check" size={15} class="mt-0.5 shrink-0" style="color:var(--color-gold-600);" />{n}</li>
                ))}
            </ul>
        </div>
    </Section>
</Layout>
