</style>

<script>
  const form = document.getElementById('wc-form') as HTMLFormElement | null;
  const result = document.getElementById('wc-result') as HTMLDivElement | null;
  const editNote = document.getElementById('wc-edit-note') as HTMLParagraphElement | null;
  const submitBtn = form?.querySelector('.wc-submit') as HTMLButtonElement | null;
  const jobEmployed = document.getElementById('wc-job-employed') as HTMLDivElement | null;
  const jobStudent = document.getElementById('wc-job-student') as HTMLDivElement | null;

  const ARRAY_FIELDS = new Set([
    'unavailableMonths',
    'jerseyNeeds',
    'volunteerRoles',
    'summerTeamsPlayedFor',
  ]);

  // Hide an element and take its controls out of the form (disabled fields are not
  // submitted and don't count towards validation).
  function setHidden(el: HTMLElement | null, hide: boolean) {
    if (!el) return;
    el.hidden = hide;
    el.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
      'input, select, textarea'
    ).forEach((c) => {
      c.disabled = hide;
    });
  }

  function setSec(name: string, show: boolean) {
    if (!form) return;
    form
      .querySelectorAll<HTMLElement>(`[data-sec="${name}"]`)
      .forEach((el) => setHidden(el, !show));
  }

  function participationValue() {
    return (
      form?.querySelector<HTMLInputElement>('input[name="participation"]:checked')?.value ?? ''
    );
  }

  const slugify = (s: string) => s.replace(/[^A-Za-z0-9]/g, '');

  function checkedSummerTeamSlugs(): Set<string> {
    return new Set(
      Array.from(
        form?.querySelectorAll<HTMLInputElement>(
          'input[name="summerTeamsPlayedFor"]:checked'
        ) ?? []
      ).map((cb) => slugify(cb.value))
    );
  }

  // Per-team captain/vice-captain feedback boxes: show only for ticked teams.
  function syncSummerTeams() {
    if (!form) return;
    const played =
      form.querySelector<HTMLInputElement>('input[name="summerPlayed"]:checked')?.value === 'yes';
    const chosen = checkedSummerTeamSlugs();
    form.querySelectorAll<HTMLElement>('[data-team-fb]').forEach((block) => {
      setHidden(block, !(played && chosen.has(block.dataset.teamFb || '')));
    });
  }

  // Show only the sections that make sense for this person + their answer.
  function applyVisibility() {
    if (!form) return;
    const loggedIn = form.dataset.loggedIn === 'true';
    const p = participationValue();
    const playing = p === 'in';
    const notPlaying = p === 'break' || p === 'out';
    const enquiring = p === 'enquiring';

    setSec('reason', notPlaying);
    setSec('emergency', playing || notPlaying);
    setSec('cricket-extra', playing);
    setSec('availability', playing);
    setSec('wants', playing);
    setSec('lookingFor', enquiring);
    setSec('jerseys', playing);
    setSec('chipping', playing);
    setSec('membership', playing && !loggedIn);
    setSec('liability', playing);

    // Summer feedback gate (members only).
    const playedSummer =
      form.querySelector<HTMLInputElement>('input[name="summerPlayed"]:checked')?.value === 'yes';
    setSec('summer-detail', playedSummer);
    syncSummerTeams();

    const emp = form.querySelector<HTMLInputElement>('input[name="employmentStatus"]:checked')?.value;
    setHidden(jobEmployed, emp !== 'employed');
    setHidden(jobStudent, emp !== 'student');
  }

  function requiredFields(): Record<string, string> {
    const loggedIn = form?.dataset.loggedIn === 'true';
    const p = participationValue();
    const req: Record<string, string> = {
      participation: 'Let us know whether you want to play this winter.',
    };
    if (!loggedIn) {
      req.firstName = 'First name is required.';
      req.lastName = 'Last name is required.';
      req.email = 'Email is required.';
      req.phone = 'Mobile number is required.';
    } else {
      req.summerPlayed = 'Let us know whether you played with us this summer.';
      const playedSummer =
        form?.querySelector<HTMLInputElement>('input[name="summerPlayed"]:checked')?.value === 'yes';
      if (playedSummer) {
        const S = 'Every field in the summer feedback section is required.';
        req.summerFeltIncluded = S;
        req.summerExperienceNotes = S;
        req.summerTeamsPlayedFor = 'Pick at least one team you played for this summer.';
        req.summerNotifiedBeforeXI = S;
        req.summerUmpired = S;
        req.summerTeamImprovement = S;
        req.summerTeamSuggestions = S;
        req.summerPracticeNotes = S;
        req.summerJerseyNotes = S;
        req.summerOther = S;
        Array.from(
          form?.querySelectorAll<HTMLInputElement>(
            'input[name="summerTeamsPlayedFor"]:checked'
          ) ?? []
        ).forEach((cb) => {
          const slug = slugify(cb.value);
          req[`slf_${slug}_captain`] = `Add feedback for the ${cb.value} captain.`;
          req[`slf_${slug}_viceCaptain`] = `Add feedback for the ${cb.value} vice-captain.`;
        });
      }
    }
    if (p === 'in') {
      req.emergencyContactName = 'Emergency contact name is required.';
      req.emergencyContactNumber = 'Emergency contact phone is required.';
      req.weekendFrequency = 'Tell us roughly how many weekends you can make.';
      req.availabilityCommitment = 'Let us know if you’re full-time or part-time.';
      req.nccaUmpireCertified = 'Let us know your NCCA umpiring status.';
      req.goals = 'Tell us what you want out of the season.';
      req.liabilityAccepted = 'Please tick the box to confirm you take part at your own risk.';
      if (!loggedIn) {
        req.membershipAcknowledged = 'Please confirm you understand what joining involves.';
      }
    }
    return req;
  }

  function setField(name: string, value: unknown) {
    if (!form) return;
    const nodes = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
      `[name="${name}"]`
    );
    if (nodes.length === 0) return;
    const first = nodes[0];

    if (first instanceof HTMLInputElement && (first.type === 'radio' || first.type === 'checkbox')) {
      let wanted: string[];
      if (Array.isArray(value)) wanted = value.map(String);
      else if (typeof value === 'boolean') wanted = value ? ['yes', 'true', 'on'] : ['no', 'false'];
      else wanted = [String(value)];
      nodes.forEach((node) => {
        const input = node as HTMLInputElement;
        input.checked = wanted.includes(input.value);
      });
      return;
    }
    (first as HTMLInputElement).value = value == null ? '' : String(value);
  }

  function fillForm(data: Record<string, unknown>) {
    for (const [key, value] of Object.entries(data)) {
      if (value == null || value === '') continue;
      if (key === 'summerLeadershipFeedback' && typeof value === 'object') {
        for (const [team, fb] of Object.entries(value as Record<string, any>)) {
          const slug = slugify(team);
          if (fb?.captain) setField(`slf_${slug}_captain`, fb.captain);
          if (fb?.viceCaptain) setField(`slf_${slug}_viceCaptain`, fb.viceCaptain);
        }
        continue;
      }
      setField(key, value);
    }
    applyVisibility();
  }

  if (form) {
    form
      .querySelectorAll<HTMLInputElement>(
        'input[name="participation"], input[name="employmentStatus"], input[name="summerPlayed"], input[name="summerTeamsPlayedFor"]'
      )
      .forEach((el) => el.addEventListener('change', applyVisibility));
    applyVisibility();

    // For logged-in members: load an existing response so they can update it.
    if (form.dataset.loggedIn === 'true') {
      fetch('/.netlify/functions/winter-checkin-mine', { headers: { Accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : null))
        .then((payload) => {
          const existing = payload?.response;
          if (!existing) return;
          fillForm(existing);
          if (submitBtn) submitBtn.textContent = 'Update my response';
          if (editNote) {
            const when = new Date(existing.updatedAt || existing.submittedAt).toLocaleDateString(
              undefined,
              { year: 'numeric', month: 'short', day: 'numeric' }
            );
            editNote.textContent = `You submitted this on ${when}. Change anything below and re-submit to update it.`;
            editNote.hidden = false;
          }
        })
        .catch(() => {});
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!result || !submitBtn) return;

      const data = new FormData(form);
      const missing: string[] = [];
      for (const [field, message] of Object.entries(requiredFields())) {
        const value = data.get(field);
        if (!value || (typeof value === 'string' && value.trim() === '')) missing.push(message);
      }
      const uniqueMissing = Array.from(new Set(missing));
      if (uniqueMissing.length > 0) {
        result.hidden = false;
        result.dataset.tone = 'error';
        result.innerHTML =
          'Please finish these first:<br>&bull; ' + uniqueMissing.join('<br>&bull; ');
        result.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const awayFrom = String(data.get('awayFrom') || '');
      const awayTo = String(data.get('awayTo') || '');
      if (awayFrom && awayTo && awayTo < awayFrom) {
        result.hidden = false;
        result.dataset.tone = 'error';
        result.textContent = '“Away until” can’t be before the “away from” date.';
        result.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const payload: Record<string, unknown> = {};
      const leadership: Record<string, { captain?: string; viceCaptain?: string }> = {};
      for (const key of new Set(Array.from(data.keys()))) {
        const slfMatch = key.match(/^slf_(.+)_(captain|viceCaptain)$/);
        if (slfMatch) {
          const [, slug, role] = slfMatch;
          (leadership[slug] ||= {})[role as 'captain' | 'viceCaptain'] =
            String(data.get(key) || '');
          continue;
        }
        payload[key] = ARRAY_FIELDS.has(key) ? data.getAll(key) : data.get(key);
      }
      if (Object.keys(leadership).length > 0) payload.summerLeadershipFeedback = leadership;

      const label = submitBtn.textContent || 'Send my response';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving…';
      try {
        const res = await fetch('/.netlify/functions/winter-checkin-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) {
          result.hidden = false;
          result.dataset.tone = 'error';
          result.textContent = out.error || 'Something went wrong. Please try again.';
          result.scrollIntoView({ behavior: 'smooth', block: 'center' });
          submitBtn.disabled = false;
          submitBtn.textContent = label;
          return;
        }
        result.hidden = false;
        result.dataset.tone = 'info';
        result.textContent = out.updated
          ? 'Your response has been updated. Thanks!'
          : 'Thanks — your response is in. You can come back and update it any time before the season starts.';
        result.scrollIntoView({ behavior: 'smooth', block: 'center' });
        submitBtn.textContent = 'Update my response';
        submitBtn.disabled = false;
        if (editNote) editNote.hidden = true;
      } catch {
        result.hidden = false;
        result.dataset.tone = 'error';
        result.textContent = 'Network error. Please try again.';
        submitBtn.disabled = false;
        submitBtn.textContent = label;
      }
    });
  }
</script>
