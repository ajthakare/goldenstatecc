---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';
import { validateAdminSession, isMember } from '../middleware/auth';

const wc = SITE_CONFIG.winterCheckIn;

// ---------------------------------------------------------------------------
// Auth: pull the logged-in member's details so we can pre-fill what we know.
// ---------------------------------------------------------------------------
const cookieHeader = Astro.request.headers.get('cookie') || '';
const session = validateAdminSession(cookieHeader);

interface MemberInfo {
  firstName: string;
  lastName: string;
  email: string;
  phone: string;
  usacId: string;
  role: string;
  emergencyContactName: string;
  emergencyContactNumber: string;
  jobCompany: string;
  jobTitle: string;
  isFullTimeMember: boolean;
}

let member: MemberInfo | null = null;

if (session && isMember(session)) {
  try {
    const res = await fetch(`${Astro.url.origin}/.netlify/functions/auth-check`, {
      headers: { cookie: cookieHeader },
    });
    if (res.ok) {
      const data = await res.json();
      if (data.authenticated && data.user) {
        member = {
          firstName: data.user.firstName || '',
          lastName: data.user.lastName || '',
          email: data.user.email || '',
          phone: data.user.phone || '',
          usacId: data.user.usacId || '',
          role: data.user.role || '',
          emergencyContactName: data.user.emergencyContactName || '',
          emergencyContactNumber: data.user.emergencyContactNumber || '',
          jobCompany: data.user.jobCompany || '',
          jobTitle: data.user.jobTitle || '',
          isFullTimeMember: !!data.user.isFullTimeMember,
        };
      }
    }
  } catch (e) {
    member = null;
  }
}

const isLoggedIn = member !== null;
const isGuest = !isLoggedIn;
const memberName = isLoggedIn
  ? `${member!.firstName} ${member!.lastName}`.trim()
  : '';
const loginHref = '/login?redirect=/winter-checkin';
const startEmployed = isLoggedIn && !!(member!.jobCompany || member!.jobTitle);

const PLAYER_ROLES = ['Batsman', 'Bowler', 'All-rounder', 'Wicket-keeper'];
const EXPERIENCE_LEVELS = [
  'New to cricket',
  'Social / tapeball',
  'Club level',
  'League level',
  'Representative / semi-pro',
];
const HOW_HEARD = [
  'Instagram',
  'A friend or current player',
  'CricClubs',
  'Google / web search',
  'Saw us at a ground or event',
  'Other',
];
const BOWLING_STYLES = [
  'Right-arm pace / medium',
  'Left-arm pace / medium',
  'Off-spin',
  'Leg-spin',
  'Slow left-arm',
  "Doesn't bowl",
];
const MONTHS = ['October', 'November', 'December', 'January', 'February', 'March'];
const VOLUNTEER_ROLES = [
  'Live streaming games',
  'Practice help',
  'Photos / social media',
  'Helping newer players',
];
const JERSEY_OPTIONS = [
  'Coloured jersey (white-ball)',
  'Coloured jersey + pants',
  'Whites (pink-ball)',
  'Whites + pants',
  'Cap',
  'Hat',
];
const JERSEY_SIZES: Array<{ value: string; label: string }> = [
  { value: 'S', label: 'Small (S)' },
  { value: 'M', label: 'Medium (M)' },
  { value: 'L', label: 'Large (L)' },
  { value: 'XL', label: 'Extra Large (XL)' },
  { value: 'XXL', label: 'Double XL (XXL)' },
];

// Summer '26 season feedback (members only)
const sf = wc.summerFeedback;
const summerSlug = (team: string) => team.replace(/[^A-Za-z0-9]/g, '');
---

<Layout title={`Winter Check-In (${wc.seasonLabel}) - Golden State Cricket Club`}>
  <div class="wc-page max-w-3xl mx-auto px-4 py-8 sm:py-12">

    <header class="wc-head">
      <p class="wc-eyebrow">Golden State Cricket Club</p>
      <h1 class="page-title mb-3">Winter Season Check-In</h1>
      <p class="text-intro mb-0">
        We're planning teams for <strong>{wc.seasonLabel}</strong> and want to build them
        around the players who want to be out there. Five minutes now saves a lot of
        chasing later.
      </p>
    </header>

    <!-- Season facts -->
    <div class="wc-facts card">
      <dl>
        <div><dt>Season</dt><dd>{wc.seasonWindow}</dd></div>
        <div><dt>Fee</dt><dd>{wc.feeNote}</dd></div>
        <div><dt>Breaks</dt><dd>{wc.blackoutNote}</dd></div>
      </dl>
    </div>

    {isLoggedIn ? (
      <div class="wc-identity card">
        <div>
          <p class="wc-identity-label">Filling this in as</p>
          <p class="wc-identity-name">{memberName}</p>
          <p class="wc-identity-meta">
            {member!.email}
            {member!.phone ? ` · ${member!.phone}` : ''}
          </p>
        </div>
        <a href="/logout" class="wc-identity-switch">Not you? Log out</a>
      </div>
    ) : (
      <div class="wc-login card">
        <div>
          <p class="wc-login-title">Already a GSCC member? Please log in first.</p>
          <p class="wc-login-text">
            We already have your contact details, playing profile and history on file.
            Logging in pre-fills the form, keeps your answers linked to your record, and
            leaves you only the new bits to fill in.
          </p>
        </div>
        <a href={loginHref} class="btn">Log in &amp; continue</a>
      </div>
    )}

    {!isLoggedIn && (
      <p class="wc-guest-note">
        New to the club or just weighing it up? Carry on below &mdash; we'll take your
        details here.
      </p>
    )}

    <p id="wc-edit-note" class="wc-edit-note" hidden></p>

    <form id="wc-form" class="wc-form" data-logged-in={String(isLoggedIn)} novalidate>

      <div class="wc-hp" aria-hidden="true">
        <label>Company website
          <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <!-- Participation -->
      <section class="wc-section">
        <h2 class="wc-section-title">{isGuest ? 'Do you want to play this winter?' : 'Are you playing this winter?'}</h2>
        <div class="wc-group" role="radiogroup" aria-label="Winter participation">
          {isGuest ? (
            <>
              <label class="wc-opt"><input type="radio" name="participation" value="in" required /> Yes, I'd like to play this winter</label>
              <label class="wc-opt"><input type="radio" name="participation" value="enquiring" /> Just enquiring for now</label>
            </>
          ) : (
            <>
              <label class="wc-opt"><input type="radio" name="participation" value="in" required /> Yes &mdash; count me in</label>
              <label class="wc-opt"><input type="radio" name="participation" value="break" /> Taking a break this winter</label>
              <label class="wc-opt"><input type="radio" name="participation" value="out" /> No &mdash; sitting this one out</label>
            </>
          )}
        </div>
        <div class="wc-field" id="wc-reason-wrap" data-sec="reason" hidden>
          <label for="wc-reason">What's the main reason you're not playing? <span class="wc-opt-tag">optional</span></label>
          <p class="wc-hint">Travel, cost, time, fitness, form &mdash; it just helps us plan and follow up.</p>
          <textarea id="wc-reason" name="notPlayingReason" class="input w-full" rows="2"></textarea>
        </div>
        <div data-sec="liability" hidden>
          <label class="wc-opt wc-opt-block">
            <input type="checkbox" name="liabilityAccepted" value="yes" />
            <span>{wc.liabilityText} <span class="wc-req">*</span></span>
          </label>
        </div>
      </section>

      {!isLoggedIn && (
        <!-- Your details (guests only — members come from the identity card above) -->
        <section class="wc-section">
          <h2 class="wc-section-title">Your details</h2>
          <div class="wc-grid-2">
            <div class="wc-field">
              <label for="wc-first">First name <span class="wc-req">*</span></label>
              <input type="text" id="wc-first" name="firstName" class="input w-full" maxlength="100" required />
            </div>
            <div class="wc-field">
              <label for="wc-last">Last name <span class="wc-req">*</span></label>
              <input type="text" id="wc-last" name="lastName" class="input w-full" maxlength="100" required />
            </div>
          </div>
          <div class="wc-grid-2">
            <div class="wc-field">
              <label for="wc-email">Email <span class="wc-req">*</span></label>
              <input type="email" id="wc-email" name="email" class="input w-full" required />
            </div>
            <div class="wc-field">
              <label for="wc-phone">Mobile / WhatsApp <span class="wc-req">*</span></label>
              <input type="tel" id="wc-phone" name="phone" class="input w-full" placeholder="+1 5551234567" required />
            </div>
          </div>
        </section>
      )}

      <!-- Emergency contact -->
      <section class="wc-section" data-sec="emergency">
        <h2 class="wc-section-title">
          Emergency contact
          <span class="wc-section-sub">Required by NCCA</span>
        </h2>
        {isLoggedIn && (member!.emergencyContactName || member!.emergencyContactNumber) && (
          <p class="wc-hint">Pulled from your profile &mdash; edit here if it's changed.</p>
        )}
        <div class="wc-grid-2">
          <div class="wc-field">
            <label for="wc-ec-name">Contact name <span class="wc-req">*</span></label>
            <input
              type="text"
              id="wc-ec-name"
              name="emergencyContactName"
              class="input w-full"
              maxlength="100"
              value={member?.emergencyContactName ?? ''}
              required
            />
          </div>
          <div class="wc-field">
            <label for="wc-ec-phone">Contact phone <span class="wc-req">*</span></label>
            <input
              type="tel"
              id="wc-ec-phone"
              name="emergencyContactNumber"
              class="input w-full"
              placeholder="+1 5551234567"
              value={member?.emergencyContactNumber ?? ''}
              required
            />
          </div>
        </div>
      </section>

      <!-- Your cricket (shown to everyone; pre-filled for members) -->
      <section class="wc-section">
        <h2 class="wc-section-title">Your cricket</h2>
        {isLoggedIn && (
          <p class="wc-hint">
            This is what we have on file. Add anything that's missing or update it if
            it's changed &mdash; sometimes IDs or roles need a refresh.
          </p>
        )}

        {isGuest && (
          <div class="wc-guest-bg">
            <div class="wc-grid-2">
              <div class="wc-field">
                <label for="wc-exp">Cricket experience</label>
                <select id="wc-exp" name="experienceLevel" class="input w-full">
                  <option value="">Select&hellip;</option>
                  {EXPERIENCE_LEVELS.map((e) => <option>{e}</option>)}
                </select>
              </div>
              <div class="wc-field">
                <label for="wc-heard">How did you hear about us?</label>
                <select id="wc-heard" name="howHeard" class="input w-full">
                  <option value="">Select&hellip;</option>
                  {HOW_HEARD.map((h) => <option>{h}</option>)}
                </select>
              </div>
            </div>
            <div class="wc-field">
              <label for="wc-played">Where have you played before? <span class="wc-opt-tag">optional</span></label>
              <p class="wc-hint">Clubs, leagues, country &mdash; or just say "new to cricket".</p>
              <input type="text" id="wc-played" name="playedBefore" class="input w-full" maxlength="300" />
            </div>
          </div>
        )}

        <div class="wc-grid-2">
          <div class="wc-field">
            <label for="wc-usac">USA Cricket (USAC) ID</label>
            <p class="wc-hint">Leave blank if you don't have one yet.</p>
            <input type="text" id="wc-usac" name="usacId" class="input w-full" value={member?.usacId ?? ''} />
          </div>
          <div class="wc-field">
            <label for="wc-cricclubs">CricClubs ID</label>
            <p class="wc-hint">Your CricClubs profile / player ID, if you know it.</p>
            <input type="text" id="wc-cricclubs" name="cricclubsId" class="input w-full" />
          </div>
        </div>
        <div class="wc-field">
          <span class="wc-label">Primary role</span>
          <div class="wc-group wc-group-inline" role="radiogroup" aria-label="Primary role">
            {PLAYER_ROLES.map((r) => (
              <label class="wc-opt">
                <input type="radio" name="role" value={r} checked={member?.role === r} /> {r}
              </label>
            ))}
          </div>
        </div>
        <div class="wc-grid-2" data-sec="cricket-extra">
          <div class="wc-field">
            <label for="wc-batpos">Batting position preference</label>
            <select id="wc-batpos" name="battingPreference" class="input w-full">
              <option value="">No preference / flexible</option>
              <option>Top order (1&ndash;3)</option>
              <option>Middle order (4&ndash;6)</option>
              <option>Lower order (7+)</option>
            </select>
          </div>
          <div class="wc-field">
            <label for="wc-bowl">Bowling style</label>
            <select id="wc-bowl" name="bowlingStyle" class="input w-full">
              <option value="">Select&hellip;</option>
              {BOWLING_STYLES.map((b) => <option>{b}</option>)}
            </select>
          </div>
        </div>
      </section>

      <!-- Availability -->
      <section class="wc-section" data-sec="availability">
        <h2 class="wc-section-title">Availability</h2>
        <div class="wc-field">
          <span class="wc-label">Months you expect to be away / travelling</span>
          <p class="wc-hint">An approximate guess is fine &mdash; helps us request the right fixtures.</p>
          <div class="wc-group wc-group-inline">
            {MONTHS.map((m) => (
              <label class="wc-opt"><input type="checkbox" name="unavailableMonths" value={m} /> {m}</label>
            ))}
          </div>
        </div>
        <div class="wc-field">
          <span class="wc-label">How many weekends can you usually make? <span class="wc-req">*</span></span>
          <div class="wc-group" role="radiogroup" aria-label="Weekend availability">
            <label class="wc-opt"><input type="radio" name="weekendFrequency" value="most" /> Most weekends</label>
            <label class="wc-opt"><input type="radio" name="weekendFrequency" value="half" /> About half</label>
            <label class="wc-opt"><input type="radio" name="weekendFrequency" value="occasional" /> Occasionally / when you're short</label>
          </div>
        </div>
        <div class="wc-field">
          <span class="wc-label">Are you committing full-time or part-time this winter? <span class="wc-req">*</span></span>
          <div class="wc-group" role="radiogroup" aria-label="Availability commitment">
            <label class="wc-opt">
              <input type="radio" name="availabilityCommitment" value="full-time" checked={member?.isFullTimeMember === true} /> Full-time
            </label>
            <label class="wc-opt">
              <input type="radio" name="availabilityCommitment" value="part-time" /> Part-time
            </label>
          </div>
        </div>
        <div class="wc-field">
          <span class="wc-label">Dates you already know you're away <span class="wc-opt-tag">optional</span></span>
          <p class="wc-hint">One trip you're already sure about &mdash; mention any others in the notes at the end.</p>
          <div class="wc-grid-2">
            <div class="wc-field">
              <label for="wc-away-from">Away from</label>
              <input type="date" id="wc-away-from" name="awayFrom" class="input w-full" min={wc.seasonStart} max={wc.seasonEnd} />
            </div>
            <div class="wc-field">
              <label for="wc-away-to">Away until</label>
              <input type="date" id="wc-away-to" name="awayTo" class="input w-full" min={wc.seasonStart} max={wc.seasonEnd} />
            </div>
          </div>
        </div>
      </section>

      <!-- What are you looking for? (guests just enquiring) -->
      <section class="wc-section wc-section-accent" data-sec="lookingFor" hidden>
        <h2 class="wc-section-title">What are you looking for?</h2>
        <div class="wc-field">
          <label for="wc-lookingfor">What are you hoping to find in a club? <span class="wc-opt-tag">optional</span></label>
          <p class="wc-hint">Competitive cricket, regular game time, getting back into it, meeting people &mdash; whatever it is.</p>
          <textarea id="wc-lookingfor" name="goals" class="input w-full" rows="3"></textarea>
        </div>
      </section>

      <!-- What you want from the season -->
      <section class="wc-section wc-section-accent" data-sec="wants">
        <h2 class="wc-section-title">What you want from the season</h2>
        <p class="wc-hint">This is the part that actually shapes how we run the squads &mdash; be honest.</p>
        <div class="wc-field">
          <label for="wc-goals">What are you hoping to get out of winter? <span class="wc-req">*</span></label>
          <p class="wc-hint">Win a title, lock down a spot, more batting time, learn a new role, get fit, just enjoy playing &mdash; whatever it is.</p>
          <textarea id="wc-goals" name="goals" class="input w-full" rows="3"></textarea>
        </div>
        <div class="wc-field">
          <span class="wc-label">Interested in a leadership role?</span>
          <div class="wc-group wc-group-inline" role="radiogroup" aria-label="Leadership interest">
            <label class="wc-opt"><input type="radio" name="leadershipInterest" value="captain" /> Captain</label>
            <label class="wc-opt"><input type="radio" name="leadershipInterest" value="vice-captain" /> Vice-captain</label>
            <label class="wc-opt"><input type="radio" name="leadershipInterest" value="none" /> Not this season</label>
          </div>
        </div>
        <div class="wc-field">
          <label for="wc-good-season">What would make this a good season for you? <span class="wc-opt-tag">optional</span></label>
          <textarea id="wc-good-season" name="goodSeasonLooksLike" class="input w-full" rows="2"></textarea>
        </div>
      </section>

      <!-- Jerseys -->
      <section class="wc-section" data-sec="jerseys">
        <h2 class="wc-section-title">Jerseys</h2>
        <p class="wc-hint">
          GSCC players need coloured kit (white-ball) and whites (pink-ball).
          We'll confirm prices later.
        </p>
        <div class="wc-group wc-group-inline">
          {JERSEY_OPTIONS.map((j) => (
            <label class="wc-opt"><input type="checkbox" name="jerseyNeeds" value={j} /> {j}</label>
          ))}
        </div>
        <div class="wc-field">
          <label for="wc-jersey-size">Jersey size <span class="wc-opt-tag">if ordering</span></label>
          <select id="wc-jersey-size" name="jerseySize" class="input w-full">
            <option value="">Select&hellip;</option>
            {JERSEY_SIZES.map((s) => <option value={s.value}>{s.label}</option>)}
          </select>
        </div>
        <div class="wc-grid-2">
          <div class="wc-field">
            <label for="wc-jersey-name">Name to print <span class="wc-opt-tag">if ordering</span></label>
            <input type="text" id="wc-jersey-name" name="jerseyName" class="input w-full" maxlength="20" placeholder="e.g. SHARMA" />
          </div>
          <div class="wc-field">
            <label for="wc-jersey-number">Number <span class="wc-opt-tag">if ordering</span></label>
            <input type="text" id="wc-jersey-number" name="jerseyNumber" class="input w-full" inputmode="numeric" maxlength="3" placeholder="e.g. 07" />
          </div>
        </div>
      </section>

      <!-- Chipping in -->
      <section class="wc-section" data-sec="chipping">
        <h2 class="wc-section-title">Chipping in</h2>
        <div class="wc-field">
          <span class="wc-label">Are you NCCA-certified for umpiring? <span class="wc-req">*</span></span>
          <div class="wc-group wc-group-inline" role="radiogroup" aria-label="NCCA umpire certification">
            <label class="wc-opt"><input type="radio" name="nccaUmpireCertified" value="yes" /> Yes</label>
            <label class="wc-opt"><input type="radio" name="nccaUmpireCertified" value="no" /> No</label>
          </div>
        </div>
        <div class="wc-field">
          <span class="wc-label">Happy to help with any of these? <span class="wc-opt-tag">optional</span></span>
          <div class="wc-group wc-group-inline">
            {VOLUNTEER_ROLES.map((v) => (
              <label class="wc-opt"><input type="checkbox" name="volunteerRoles" value={v} /> {v}</label>
            ))}
          </div>
        </div>
      </section>

      {isGuest && (
        <!-- Joining the club (guests who want to play) -->
        <section class="wc-section" data-sec="membership" hidden>
          <h2 class="wc-section-title">Joining the club</h2>
          <p class="wc-hint">
            Playing with GSCC this winter means registering with USA Cricket and paying
            club membership. {wc.feeNote}
          </p>
          <label class="wc-opt wc-opt-block">
            <input type="checkbox" name="membershipAcknowledged" value="yes" />
            <span>
              I understand that joining means registering with USA Cricket and paying club
              membership. <span class="wc-req">*</span>
            </span>
          </label>
        </section>
      )}

      {isLoggedIn && sf.enabled && (
        <!-- Summer '26 season feedback (members only) -->
        <section class="wc-section wc-section-accent">
          <h2 class="wc-section-title">How was your {sf.seasonLabel} season?</h2>
          <p class="wc-hint">A quick look back so the club and the captains can act on it.</p>

          <div class="wc-field">
            <span class="wc-label">Did you play any games with us this summer? <span class="wc-req">*</span></span>
            <div class="wc-group wc-group-inline" role="radiogroup" aria-label="Played this summer">
              <label class="wc-opt"><input type="radio" name="summerPlayed" value="yes" /> Yes</label>
              <label class="wc-opt"><input type="radio" name="summerPlayed" value="no" /> No</label>
            </div>
          </div>

          <div class="wc-summer-detail" data-sec="summer-detail" hidden>
            <p class="wc-hint">Once you tick "Yes" above, everything in this section is required.</p>
            <div class="wc-field">
              <span class="wc-label">Have you felt included in the club? <span class="wc-req">*</span></span>
              <div class="wc-group wc-group-inline" role="radiogroup" aria-label="Felt included">
                <label class="wc-opt"><input type="radio" name="summerFeltIncluded" value="yes" /> Yes</label>
                <label class="wc-opt"><input type="radio" name="summerFeltIncluded" value="no" /> No</label>
                <label class="wc-opt"><input type="radio" name="summerFeltIncluded" value="at-times" /> At times</label>
              </div>
            </div>
            <div class="wc-field">
              <label for="wc-sum-exp">How was your overall experience playing this summer? <span class="wc-req">*</span></label>
              <textarea id="wc-sum-exp" name="summerExperienceNotes" class="input w-full" rows="3"></textarea>
            </div>
            <div class="wc-field">
              <span class="wc-label">Which team(s) did you play for this summer? <span class="wc-req">*</span></span>
              <div class="wc-group wc-group-inline">
                {sf.teams.map((t) => (
                  <label class="wc-opt"><input type="checkbox" name="summerTeamsPlayedFor" value={t} /> {t}</label>
                ))}
              </div>
            </div>
            <div class="wc-field">
              <span class="wc-label">Were you told before the XI was announced if you didn't make it? <span class="wc-req">*</span></span>
              <div class="wc-group wc-group-inline" role="radiogroup" aria-label="Notified before XI">
                <label class="wc-opt"><input type="radio" name="summerNotifiedBeforeXI" value="yes" /> Yes</label>
                <label class="wc-opt"><input type="radio" name="summerNotifiedBeforeXI" value="no" /> No</label>
                <label class="wc-opt"><input type="radio" name="summerNotifiedBeforeXI" value="na" /> N/A &mdash; always made the XI</label>
              </div>
            </div>
            <div class="wc-field">
              <span class="wc-label">Did you go out to umpire this season? <span class="wc-req">*</span></span>
              <p class="wc-hint">Answer No if your umpiring slot was covered by a panel umpire.</p>
              <div class="wc-group wc-group-inline" role="radiogroup" aria-label="Umpired this season">
                <label class="wc-opt"><input type="radio" name="summerUmpired" value="yes" /> Yes</label>
                <label class="wc-opt"><input type="radio" name="summerUmpired" value="no" /> No</label>
              </div>
            </div>

            <div class="wc-field">
              <span class="wc-label">Feedback on your captain(s) &amp; vice-captain(s) <span class="wc-req">*</span></span>
              <p class="wc-hint">A box appears for each team you ticked above.</p>
            </div>
            {sf.teams.map((t) => {
              const slug = summerSlug(t);
              const l = sf.leadership[t] || { captain: '', viceCaptain: '' };
              return (
                <div class="wc-team-fb" data-team-fb={slug} hidden>
                  <p class="wc-team-fb-title">{t}</p>
                  <div class="wc-field">
                    <label for={`wc-slf-${slug}-c`}>
                      Captain{l.captain ? ` — ${l.captain}` : ''} <span class="wc-req">*</span>
                    </label>
                    <textarea id={`wc-slf-${slug}-c`} name={`slf_${slug}_captain`} class="input w-full" rows="2"></textarea>
                  </div>
                  <div class="wc-field">
                    <label for={`wc-slf-${slug}-vc`}>
                      Vice-captain{l.viceCaptain ? ` — ${l.viceCaptain}` : ''} <span class="wc-req">*</span>
                    </label>
                    <textarea id={`wc-slf-${slug}-vc`} name={`slf_${slug}_viceCaptain`} class="input w-full" rows="2"></textarea>
                  </div>
                </div>
              );
            })}

            <div class="wc-field">
              <label for="wc-sum-improve">Anything your summer team(s) should improve? <span class="wc-req">*</span></label>
              <textarea id="wc-sum-improve" name="summerTeamImprovement" class="input w-full" rows="2"></textarea>
            </div>
            <div class="wc-field">
              <label for="wc-sum-sugg">Suggestions on how the team can improve (team level) <span class="wc-req">*</span></label>
              <textarea id="wc-sum-sugg" name="summerTeamSuggestions" class="input w-full" rows="2"></textarea>
            </div>
            <div class="wc-field">
              <label for="wc-sum-practice">How did practice timings work for you this summer? <span class="wc-req">*</span></label>
              <textarea id="wc-sum-practice" name="summerPracticeNotes" class="input w-full" rows="2"></textarea>
            </div>
            <div class="wc-field">
              <label for="wc-sum-jersey">Thoughts on the team jersey? <span class="wc-req">*</span></label>
              <textarea id="wc-sum-jersey" name="summerJerseyNotes" class="input w-full" rows="2"></textarea>
            </div>
            <div class="wc-field">
              <label for="wc-sum-other">Any feedback for the club to improve on? <span class="wc-req">*</span></label>
              <textarea id="wc-sum-other" name="summerOther" class="input w-full" rows="2"></textarea>
            </div>
          </div>
        </section>
      )}

      <!-- Anything else -->
      <section class="wc-section">
        <h2 class="wc-section-title">Anything else</h2>
        {isLoggedIn && (
          <>
            <div class="wc-field">
              <span class="wc-label">Employment status <span class="wc-opt-tag">optional</span></span>
              <p class="wc-hint">Helps us connect members who are hiring or job-hunting.</p>
              <div class="wc-group wc-group-inline" role="radiogroup" aria-label="Employment status">
                <label class="wc-opt"><input type="radio" name="employmentStatus" value="employed" checked={startEmployed} /> Employed</label>
                <label class="wc-opt"><input type="radio" name="employmentStatus" value="student" /> Student</label>
              </div>
            </div>
            <div class="wc-grid-2" id="wc-job-employed" hidden={!startEmployed}>
              <div class="wc-field">
                <label for="wc-job-company">Company</label>
                <input type="text" id="wc-job-company" name="jobCompany" class="input w-full" maxlength="200" value={member?.jobCompany ?? ''} />
              </div>
              <div class="wc-field">
                <label for="wc-job-title">Job title</label>
                <input type="text" id="wc-job-title" name="jobTitle" class="input w-full" maxlength="200" value={member?.jobTitle ?? ''} />
              </div>
            </div>
            <div class="wc-field" id="wc-job-student" hidden>
              <label for="wc-college">College / university</label>
              <input type="text" id="wc-college" name="collegeName" class="input w-full" maxlength="200" />
            </div>
          </>
        )}
        <div class="wc-field">
          <label for="wc-injury">Injuries or fitness notes for management <span class="wc-opt-tag">optional</span></label>
          <textarea id="wc-injury" name="injuryNotes" class="input w-full" rows="2"></textarea>
        </div>
        <div class="wc-field">
          <label for="wc-else">Anything else for the winter planning group? <span class="wc-opt-tag">optional</span></label>
          <textarea id="wc-else" name="anythingElse" class="input w-full" rows="2"></textarea>
        </div>
      </section>

      <p class="wc-consent">
        We'll use your answers only for winter season planning and to contact you about
        selection, fixtures and fees. You can update your response any time before the
        season starts.
      </p>

      <button type="submit" class="btn btn-lg wc-submit">Send my response</button>

      <div id="wc-result" class="wc-result" hidden></div>
    </form>
  </div>
</Layout>

