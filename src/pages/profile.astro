---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProfileSummary from '../components/profile/ProfileSummary.astro';
import PlayerAvatar from '../components/profile/PlayerAvatar.astro';
import Icon from '../components/Icon.astro';
import { validateAdminSession, isMember } from '../middleware/auth';
import { BATTING_STYLES, BOWLING_STYLES, PLAYER_ROLES, PRIVACY_DEFAULTS } from '../types/player';
import type { Player } from '../types/player';
import type { PublicPlayerProfile } from '../types/profile';

// Check authentication
const cookieHeader = Astro.request.headers.get('cookie');
const session = validateAdminSession(cookieHeader || '');

// Redirect to login if not authenticated
if (!session || !isMember(session)) {
  return Astro.redirect('/login?redirect=/profile');
}

let player: Omit<Player, 'passwordHash'> | null = null;
let publicProfile: PublicPlayerProfile | null = null;
let error = null;
let isOldStyleAdmin = false;

try {
  const userId = session.userId;

  if (!userId) {
    error = 'No user ID in session';
  } else if (userId.startsWith('admin-')) {
    // Old-style admin without player record
    isOldStyleAdmin = true;
    error = 'This is an old-style admin account without a player profile. Please contact a super admin to link your account to a player record, or register as a new member.';
  } else {
    const response = await fetch(`${Astro.url.origin}/.netlify/functions/profile-get`, {
      headers: { cookie: cookieHeader || '' },
    });

    if (response.ok) {
      const data = await response.json();
      player = data.player;
      publicProfile = data.publicProfile;
    } else {
      const errorData = await response.json().catch(() => ({}));
      error = `Failed to load player profile: ${errorData.error || response.statusText}`;
      console.error('Profile page - error response:', errorData);
    }
  }
} catch (err) {
  error = 'Failed to load profile data';
  console.error('Profile fetch error:', err);
}

const privacy = { ...PRIVACY_DEFAULTS, ...(player?.privacy || {}) };
const missingEmergency = !!player && !(player.emergencyContactName && player.emergencyContactNumber);
const countryCodes = [
  ['+1', '🇺🇸 +1'], ['+91', '🇮🇳 +91'], ['+44', '🇬🇧 +44'], ['+61', '🇦🇺 +61'], ['+86', '🇨🇳 +86'],
  ['+81', '🇯🇵 +81'], ['+49', '🇩🇪 +49'], ['+33', '🇫🇷 +33'], ['+971', '🇦🇪 +971'], ['+65', '🇸🇬 +65'],
];
---

<Layout title="My Profile - Golden State Cricket Club">
  <PageHeader kicker="Your account" title="My Profile" subtitle="Your player card, achievements and account settings" />
  <div class="max-w-4xl mx-auto px-4 py-8 pt-0">

    {error && (
      <div class={isOldStyleAdmin ? "alert alert-warning mb-6" : "alert alert-error mb-6"}>
        <div>
          <p class="alert-title">{isOldStyleAdmin ? 'Old-Style Admin Account' : 'Profile Error'}</p>
          <p>{error}</p>
          {isOldStyleAdmin && (
            <div class="mt-4">
              <p class="text-body-base mb-2"><strong>Options:</strong></p>
              <ul class="list-disc list-inside space-y-1 text-body-base">
                <li>Register as a new member at <a href="/register" class="text-primary hover:underline">/register</a></li>
                <li>Contact a super admin to link your account to a player record</li>
              </ul>
            </div>
          )}
        </div>
      </div>
    )}

    {player && publicProfile && (
      <>
        <ProfileSummary profile={publicProfile} isOwn>
          <div class="own-actions">
            <a href={`/players/${player.id}`} class="own-action"><Icon name="users" size={14} /> View as others see it</a>
            <a href="/players" class="own-action"><Icon name="arrow-right" size={14} /> Browse players</a>
          </div>
        </ProfileSummary>

        <h2 class="settings-heading">Edit profile</h2>

        {/* Profile photo */}
        <details class="card settings" open={!player.photoUpdatedAt}>
          <summary class="settings-summary">
            <span><span class="settings-title">Profile Photo</span><span class="settings-sub">{player.photoUpdatedAt ? 'Change or remove your photo' : 'Add a photo so teammates recognise you'}</span></span>
            <Icon name="chevron-down" size={18} class="settings-chevron" />
          </summary>
          <div class="settings-body">
            <div class="photo-row">
              <div id="photo-preview-wrap">
                <PlayerAvatar firstName={player.firstName} lastName={player.lastName} photoUrl={publicProfile.photoUrl} size={96} />
              </div>
              <div class="photo-controls">
                <input type="file" id="photo-input" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" class="sr-only" />
                <label for="photo-input" class="btn btn-lg photo-btn">Choose photo</label>
                <button type="button" id="photo-save" class="btn btn-lg photo-btn" style="display: none;">Save photo</button>
                {player.photoUpdatedAt && (
                  <button type="button" id="photo-remove" class="link-danger">Remove photo</button>
                )}
                <p class="form-hint">Any photo works. You'll be able to drag and zoom to pick the exact square to use.</p>
              </div>
            </div>

            <div id="photo-cropper" class="cropper" hidden>
              <p class="cropper-hint">Drag to position and zoom to fit. The circle shows how it looks as your avatar; the whole square is used on player cards.</p>
              <div
                id="cropper-frame"
                class="cropper-frame"
                tabindex="0"
                role="application"
                aria-label="Photo crop area. Drag or use arrow keys to move; plus and minus to zoom."
              >
                <canvas id="cropper-canvas"></canvas>
                <div class="cropper-mask" aria-hidden="true"></div>
              </div>
              <div class="cropper-zoom">
                <button type="button" id="cropper-zoom-out" class="cropper-zoom-btn" aria-label="Zoom out">−</button>
                <input type="range" id="cropper-zoom" min="1" max="5" step="0.01" value="1" aria-label="Zoom" />
                <button type="button" id="cropper-zoom-in" class="cropper-zoom-btn" aria-label="Zoom in">+</button>
              </div>
              <div class="cropper-actions">
                <button type="button" id="cropper-cancel" class="cropper-cancel">Cancel</button>
                <button type="button" id="cropper-apply" class="btn btn-lg">Use this crop</button>
              </div>
            </div>
            <div id="photo-error" class="alert alert-error" style="display: none;"></div>
            <div id="photo-success" class="alert alert-success" style="display: none;"></div>
          </div>
        </details>

        {/* Cricket profile */}
        <details class="card settings">
          <summary class="settings-summary">
            <span><span class="settings-title">Cricket Profile</span><span class="settings-sub">Playing role, batting & bowling style, USAC ID, CricClubs</span></span>
            <Icon name="chevron-down" size={18} class="settings-chevron" />
          </summary>
          <form id="player-info-form" class="form settings-body" method="post" action="javascript:void(0);">
            <div class="form-row">
              <div class="form-group">
                <label for="player-role" class="form-label">Playing Role</label>
                <select id="player-role" name="playerRole" class="form-input">
                  <option value="">-- Select your role --</option>
                  {PLAYER_ROLES.map((r) => (
                    <option value={r} selected={player!.role === r}>{r}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="usac-id" class="form-label">USAC ID</label>
                <input type="text" id="usac-id" name="usacId" class="form-input" placeholder="Enter your USAC ID" value={player.usacId || ''} />
                <p class="form-hint">Private — only admins see this</p>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="batting-style" class="form-label">Batting Style</label>
                <select id="batting-style" name="battingStyle" class="form-input">
                  <option value="">-- Not set --</option>
                  {BATTING_STYLES.map((s) => <option value={s} selected={player!.battingStyle === s}>{s}</option>)}
                </select>
              </div>
              <div class="form-group">
                <label for="bowling-style" class="form-label">Bowling Style</label>
                <select id="bowling-style" name="bowlingStyle" class="form-input">
                  <option value="">-- Not set --</option>
                  {BOWLING_STYLES.map((s) => <option value={s} selected={player!.bowlingStyle === s}>{s}</option>)}
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="cricclubs-url" class="form-label">CricClubs Profile Link (Optional)</label>
              <input type="url" id="cricclubs-url" name="cricclubsUrl" class="form-input" placeholder="https://cricclubs.com/.../viewPlayer.do?playerId=..." value={player.cricclubsUrl || ''} />
              <p class="form-hint">Open your player page on CricClubs and paste the link here</p>
            </div>

            <div id="player-info-error" class="alert alert-error" style="display: none;"></div>
            <div id="player-info-success" class="alert alert-success" style="display: none;"></div>

            <button type="submit" id="player-info-button" class="btn btn-lg">Save Cricket Profile</button>
          </form>
        </details>

        {/* Privacy */}
        <details class="card settings">
          <summary class="settings-summary">
            <span><span class="settings-title">Privacy</span><span class="settings-sub">Choose what other members see on your profile</span></span>
            <Icon name="chevron-down" size={18} class="settings-chevron" />
          </summary>
          <form id="privacy-form" class="form settings-body" method="post" action="javascript:void(0);">
            <p class="form-hint" style="margin: 0;">
              Player profiles are only visible to signed-in club members. Your email, USAC ID and emergency contact are never shown.
            </p>
            <label class="toggle">
              <input type="checkbox" id="privacy-phone" checked={privacy.showPhone} />
              <span><strong>Show my phone number</strong><br /><span class="form-hint">{player.phone || 'No phone number saved'}</span></span>
            </label>
            <label class="toggle">
              <input type="checkbox" id="privacy-company" checked={privacy.showCompany} />
              <span><strong>Show my company & job title</strong><br /><span class="form-hint">Helps teammates with job referrals</span></span>
            </label>
            <div id="privacy-error" class="alert alert-error" style="display: none;"></div>
            <div id="privacy-success" class="alert alert-success" style="display: none;"></div>
            <button type="submit" id="privacy-button" class="btn btn-lg">Save Privacy Settings</button>
          </form>
        </details>

        {/* Phone */}
        <details class="card settings">
          <summary class="settings-summary">
            <span><span class="settings-title">Phone Number</span><span class="settings-sub">{player.phone || 'Not set'}</span></span>
            <Icon name="chevron-down" size={18} class="settings-chevron" />
          </summary>
          <form id="phone-form" class="form settings-body" method="post" action="javascript:void(0);">
            <div class="form-group">
              <label for="phone-number" class="form-label">Phone Number</label>
              <div class="flex gap-2">
                <select id="phone-country" name="phoneCountry" class="form-input country-select">
                  {countryCodes.map(([v, label]) => <option value={v}>{label}</option>)}
                </select>
                <input type="tel" id="phone-number" name="phoneNumber" class="form-input" placeholder="1234567890" pattern="[0-9]{7,15}" />
              </div>
              <p class="form-hint">Enter phone number without country code. Used for team communications.</p>
            </div>
            <div id="phone-error" class="alert alert-error" style="display: none;"></div>
            <div id="phone-success" class="alert alert-success" style="display: none;"></div>
            <button type="submit" id="phone-button" class="btn btn-lg">Update Phone</button>
          </form>
        </details>

        {/* Emergency contact */}
        <details class="card settings" id="emergency-section" open={missingEmergency}>
          <summary class="settings-summary">
            <span>
              <span class="settings-title">Emergency Contact {missingEmergency && <span class="required-pill">Required</span>}</span>
              <span class="settings-sub">{missingEmergency ? 'Required for all members' : `${player.emergencyContactName} · ${player.emergencyContactNumber}`}</span>
            </span>
            <Icon name="chevron-down" size={18} class="settings-chevron" />
          </summary>
          <form id="emergency-form" class="form settings-body" method="post" action="javascript:void(0);">
            <p class="form-hint" style="margin: 0;">This person will be contacted in case of emergency. Only admins can see it.</p>
            <div class="form-group">
              <label for="emergency-contact-name" class="form-label">
                Emergency Contact Name <span class="text-red-500">*</span>
              </label>
              <input type="text" id="emergency-contact-name" name="emergencyContactName" required maxlength="100" class="form-input" placeholder="Jane Doe" value={player.emergencyContactName || ''} />
            </div>
            <div class="form-group">
              <label for="emergency-number" class="form-label">
                Emergency Contact Number <span class="text-red-500">*</span>
              </label>
              <div class="flex gap-2">
                <select id="emergency-country" name="emergencyCountry" class="form-input country-select">
                  {countryCodes.map(([v, label]) => <option value={v}>{label}</option>)}
                </select>
                <input type="tel" id="emergency-number" name="emergencyNumber" required class="form-input" placeholder="1234567890" pattern="[0-9]{7,15}" />
              </div>
            </div>
            <div id="emergency-error" class="alert alert-error" style="display: none;"></div>
            <div id="emergency-success" class="alert alert-success" style="display: none;"></div>
            <button type="submit" id="emergency-button" class="btn btn-lg">Update Emergency Contact</button>
          </form>
        </details>

        {/* Job */}
        <details class="card settings">
          <summary class="settings-summary">
            <span><span class="settings-title">Job Information</span><span class="settings-sub">Optional · helps the community with job referrals</span></span>
            <Icon name="chevron-down" size={18} class="settings-chevron" />
          </summary>
          <form id="job-form" class="form settings-body" method="post" action="javascript:void(0);">
            <div class="form-row">
              <div class="form-group">
                <label for="job-company" class="form-label">Company</label>
                <input type="text" id="job-company" name="jobCompany" maxlength="200" class="form-input" placeholder="ABC Corp" value={player.jobCompany || ''} />
              </div>
              <div class="form-group">
                <label for="job-title" class="form-label">Job Title</label>
                <input type="text" id="job-title" name="jobTitle" maxlength="200" class="form-input" placeholder="Software Engineer" value={player.jobTitle || ''} />
              </div>
            </div>
            <div id="job-error" class="alert alert-error" style="display: none;"></div>
            <div id="job-success" class="alert alert-success" style="display: none;"></div>
            <button type="submit" id="job-button" class="btn btn-lg">Update Job Information</button>
          </form>
        </details>

        {/* Account */}
        <details class="card settings">
          <summary class="settings-summary">
            <span><span class="settings-title">Account & Password</span><span class="settings-sub">{player.email}</span></span>
            <Icon name="chevron-down" size={18} class="settings-chevron" />
          </summary>
          <form id="password-form" class="form settings-body" method="post" action="javascript:void(0);">
            <p class="form-hint" style="margin: 0;">Email cannot be changed after registration.</p>
            <div class="form-group">
              <label for="current-password" class="form-label">Current Password</label>
              <input type="password" id="current-password" name="currentPassword" required class="form-input" placeholder="Enter current password" autocomplete="current-password" />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="new-password" class="form-label">New Password</label>
                <input type="password" id="new-password" name="newPassword" required minlength="8" class="form-input" placeholder="Minimum 8 characters" autocomplete="new-password" />
              </div>
              <div class="form-group">
                <label for="confirm-password" class="form-label">Confirm New Password</label>
                <input type="password" id="confirm-password" name="confirmPassword" required minlength="8" class="form-input" placeholder="Re-enter new password" autocomplete="new-password" />
              </div>
            </div>
            <div id="password-error" class="alert alert-error" style="display: none;"></div>
            <div id="password-success" class="alert alert-success" style="display: none;"></div>
            <button type="submit" id="password-button" class="btn btn-lg">Change Password</button>
          </form>
        </details>
      </>
    )}
  </div>

  <script define:vars={{
    playerPhone: player?.phone,
    playerEmergencyContactNumber: player?.emergencyContactNumber,
    missingEmergency,
  }}>
    const $ = (id) => document.getElementById(id);

    function showMessage(prefix, kind, text) {
      $(`${prefix}-error`).style.display = 'none';
      $(`${prefix}-success`).style.display = 'none';
      if (!kind) return;
      const el = $(`${prefix}-${kind}`);
      el.textContent = text;
      el.style.display = 'block';
    }

    /**
     * POST to profile-update, show the result in the section's alert boxes,
     * then reload so the profile card reflects the change.
     */
    async function saveProfile(prefix, button, body, { idleText, busyText = 'Saving...', successText, reload = true }) {
      showMessage(prefix, null);
      button.disabled = true;
      button.textContent = busyText;
      try {
        const response = await fetch('/.netlify/functions/profile-update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(body),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Failed to save');
        // The header's "Hi, <name>" is cached for the visit; the name may have changed
        try { sessionStorage.removeItem('gscc-first-name'); } catch { /* storage blocked */ }
        showMessage(prefix, 'success', successText || data.message || 'Saved!');
        if (reload) setTimeout(() => window.location.reload(), 1000);
        return true;
      } catch (error) {
        showMessage(prefix, 'error', error.message || 'Unknown error');
        return false;
      } finally {
        button.disabled = false;
        button.textContent = idleText;
      }
    }

    // "+1 1234567890" -> fill a country select + number input
    function fillPhone(value, selectId, inputId) {
      if (!value) return;
      const select = $(selectId);
      const input = $(inputId);
      if (!select || !input) return;
      const match = value.match(/^(\+\d+)\s*(.+)$/);
      if (match) {
        if (Array.from(select.options).some((o) => o.value === match[1])) select.value = match[1];
        input.value = match[2];
      } else {
        input.value = value;
      }
    }
    fillPhone(playerPhone, 'phone-country', 'phone-number');
    fillPhone(playerEmergencyContactNumber, 'emergency-country', 'emergency-number');

    // ---------------------------------------------------------------------
    // Emergency contact is mandatory: warn and keep the user on the page
    // ---------------------------------------------------------------------
    const blockUnload = (e) => {
      e.preventDefault();
      e.returnValue = 'You must fill in emergency contact information before leaving this page.';
      return e.returnValue;
    };

    if (missingEmergency && $('emergency-form')) {
      setTimeout(() => {
        const modal = document.createElement('div');
        modal.style.cssText = 'position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;';
        modal.innerHTML = `
          <div style="background: white; padding: 32px; border-radius: 12px; max-width: 500px; margin: 20px;">
            <h2 style="font-size: 24px; font-weight: 700; color: #dc2626; margin-bottom: 16px;">⚠️ Emergency Contact Required</h2>
            <p style="font-size: 16px; color: #374151; margin-bottom: 24px;">
              Please fill in the "Emergency Contact" section before continuing.
            </p>
            <button id="close-warning-modal" style="width: 100%; padding: 12px 24px; background: #8C1D18; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;">
              I Understand
            </button>
          </div>
        `;
        document.body.appendChild(modal);
        $('close-warning-modal').addEventListener('click', () => {
          modal.remove();
          $('emergency-section').open = true;
          $('emergency-form').scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      }, 500);
      window.addEventListener('beforeunload', blockUnload);
    }

    $('emergency-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const ok = await saveProfile('emergency', $('emergency-button'), {
        emergencyContactName: formData.get('emergencyContactName'),
        emergencyContactNumber: `${formData.get('emergencyCountry')} ${formData.get('emergencyNumber')}`,
      }, { idleText: 'Update Emergency Contact', busyText: 'Updating...', reload: false });
      if (ok) {
        window.removeEventListener('beforeunload', blockUnload);
        setTimeout(() => window.location.reload(), 1000);
      }
    });

    // ---------------------------------------------------------------------
    // Other sections
    // ---------------------------------------------------------------------
    $('player-info-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      saveProfile('player-info', $('player-info-button'), {
        usacId: formData.get('usacId'),
        playerRole: formData.get('playerRole') || undefined,
        battingStyle: formData.get('battingStyle'),
        bowlingStyle: formData.get('bowlingStyle'),
        cricclubsUrl: formData.get('cricclubsUrl'),
      }, { idleText: 'Save Cricket Profile', successText: 'Cricket profile saved!' });
    });

    $('privacy-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      saveProfile('privacy', $('privacy-button'), {
        privacy: {
          showPhone: $('privacy-phone').checked,
          showCompany: $('privacy-company').checked,
        },
      }, { idleText: 'Save Privacy Settings', successText: 'Privacy settings saved!' });
    });

    $('job-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      saveProfile('job', $('job-button'), {
        jobCompany: formData.get('jobCompany'),
        jobTitle: formData.get('jobTitle'),
      }, { idleText: 'Update Job Information', busyText: 'Updating...' });
    });

    $('phone-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const phoneNumber = formData.get('phoneNumber');
      saveProfile('phone', $('phone-button'), {
        phone: phoneNumber ? `${formData.get('phoneCountry')} ${phoneNumber}` : '',
      }, { idleText: 'Update Phone', busyText: 'Updating...', successText: 'Phone number updated!' });
    });

    $('password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      if (formData.get('newPassword') !== formData.get('confirmPassword')) {
        showMessage('password', 'error', 'New passwords do not match');
        return;
      }
      const ok = await saveProfile('password', $('password-button'), {
        currentPassword: formData.get('currentPassword'),
        newPassword: formData.get('newPassword'),
      }, { idleText: 'Change Password', busyText: 'Changing...', successText: 'Password changed!' });
      if (ok) e.target.reset();
    });

    // ---------------------------------------------------------------------
    // Profile photo: the player drags/zooms to choose a square, then we save two
    // sizes as WebP (JPEG where the browser can't encode WebP): 400px for the
    // profile page and high-res screens (~25 KB), 240px for feed avatars and the
    // card grid (~10 KB). The original photo never leaves the device.
    // ---------------------------------------------------------------------
    const PHOTO_SIZE = 400;
    const SMALL_PHOTO_SIZE = 240;
    let pendingPhoto = null;
    let pendingSmallPhoto = null;

    function canvasToBlob(canvas, type, quality) {
      return new Promise((resolve) => canvas.toBlob(resolve, type, quality));
    }

    // crop = { sx, sy, side } in source-image pixels
    async function squareImage(bitmap, crop, size, quality) {
      const { sx, sy, side } = crop;
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(bitmap, sx, sy, side, side, 0, 0, size, size);

      let blob = await canvasToBlob(canvas, 'image/webp', quality);
      if (!blob || blob.type !== 'image/webp') blob = await canvasToBlob(canvas, 'image/jpeg', quality);
      if (!blob) throw new Error('Could not process that image.');
      return blob;
    }

    async function encodeCrop(bitmap, crop) {
      return {
        full: await squareImage(bitmap, crop, PHOTO_SIZE, 0.85),
        small: await squareImage(bitmap, crop, SMALL_PHOTO_SIZE, 0.8),
      };
    }

    // ---- Cropper: square frame, drag to pan, zoom with slider / wheel / pinch
    const cropper = {
      bitmap: null,
      view: 0,        // frame size in CSS px
      base: 1,        // scale where the image just covers the frame (zoom 1)
      zoom: 1,
      x: 0,           // image top-left inside the frame, CSS px
      y: 0,
      pointers: new Map(),
      pinch: null,
    };
    const frame = $('cropper-frame');
    const canvasEl = $('cropper-canvas');
    const zoomInput = $('cropper-zoom');

    const scale = () => cropper.base * cropper.zoom;

    function clampPosition() {
      const { bitmap, view } = cropper;
      const w = bitmap.width * scale();
      const h = bitmap.height * scale();
      cropper.x = Math.min(0, Math.max(view - w, cropper.x));
      cropper.y = Math.min(0, Math.max(view - h, cropper.y));
    }

    function drawCropper() {
      const { bitmap, view } = cropper;
      if (!bitmap) return;
      const dpr = window.devicePixelRatio || 1;
      if (canvasEl.width !== Math.round(view * dpr)) {
        canvasEl.width = Math.round(view * dpr);
        canvasEl.height = Math.round(view * dpr);
      }
      const ctx = canvasEl.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.imageSmoothingQuality = 'high';
      ctx.clearRect(0, 0, view, view);
      ctx.drawImage(bitmap, cropper.x, cropper.y, bitmap.width * scale(), bitmap.height * scale());
    }

    // Zoom keeping the point (fx, fy) of the frame fixed under the finger/cursor
    function setZoom(zoom, fx = cropper.view / 2, fy = cropper.view / 2) {
      const next = Math.min(Number(zoomInput.max), Math.max(1, zoom));
      const ix = (fx - cropper.x) / scale();
      const iy = (fy - cropper.y) / scale();
      cropper.zoom = next;
      cropper.x = fx - ix * scale();
      cropper.y = fy - iy * scale();
      clampPosition();
      zoomInput.value = String(next);
      drawCropper();
    }

    function openCropper(bitmap) {
      cropper.bitmap?.close?.();
      cropper.bitmap = bitmap;
      const box = $('photo-cropper');
      box.hidden = false;
      // Square frame: up to 280px, smaller on narrow phones
      const pad = parseFloat(getComputedStyle(box).paddingLeft) * 2;
      const size = Math.floor(Math.min(280, box.clientWidth - pad));
      frame.style.width = `${size}px`;
      frame.style.height = `${size}px`;
      cropper.view = size;
      cropper.base = cropper.view / Math.min(bitmap.width, bitmap.height);
      cropper.zoom = 1;
      zoomInput.value = '1';
      // Start centred, like the old automatic crop
      cropper.x = (cropper.view - bitmap.width * scale()) / 2;
      cropper.y = (cropper.view - bitmap.height * scale()) / 2;
      drawCropper();
      frame.focus({ preventScroll: true });
      frame.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function closeCropper() {
      $('photo-cropper').hidden = true;
      cropper.bitmap?.close?.();
      cropper.bitmap = null;
      cropper.pointers.clear();
      cropper.pinch = null;
      $('photo-input').value = '';
    }

    const framePoint = (e) => {
      const r = frame.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };

    frame?.addEventListener('pointerdown', (e) => {
      frame.setPointerCapture(e.pointerId);
      cropper.pointers.set(e.pointerId, framePoint(e));
      if (cropper.pointers.size === 2) {
        const [a, b] = [...cropper.pointers.values()];
        cropper.pinch = { dist: Math.hypot(a.x - b.x, a.y - b.y), zoom: cropper.zoom };
      }
    });
    frame?.addEventListener('pointermove', (e) => {
      if (!cropper.pointers.has(e.pointerId)) return;
      const prev = cropper.pointers.get(e.pointerId);
      const pt = framePoint(e);
      cropper.pointers.set(e.pointerId, pt);
      if (cropper.pointers.size === 2 && cropper.pinch) {
        const [a, b] = [...cropper.pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        setZoom(cropper.pinch.zoom * (dist / cropper.pinch.dist), (a.x + b.x) / 2, (a.y + b.y) / 2);
      } else if (cropper.pointers.size === 1) {
        cropper.x += pt.x - prev.x;
        cropper.y += pt.y - prev.y;
        clampPosition();
        drawCropper();
      }
    });
    const endPointer = (e) => {
      cropper.pointers.delete(e.pointerId);
      if (cropper.pointers.size < 2) cropper.pinch = null;
    };
    frame?.addEventListener('pointerup', endPointer);
    frame?.addEventListener('pointercancel', endPointer);
    frame?.addEventListener('wheel', (e) => {
      e.preventDefault();
      const pt = framePoint(e);
      setZoom(cropper.zoom * Math.exp(-e.deltaY * 0.0015), pt.x, pt.y);
    }, { passive: false });
    frame?.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 30 : 8;
      const moves = { ArrowLeft: [step, 0], ArrowRight: [-step, 0], ArrowUp: [0, step], ArrowDown: [0, -step] };
      if (moves[e.key]) {
        e.preventDefault();
        cropper.x += moves[e.key][0];
        cropper.y += moves[e.key][1];
        clampPosition();
        drawCropper();
      } else if (e.key === '+' || e.key === '=') {
        e.preventDefault();
        setZoom(cropper.zoom * 1.1);
      } else if (e.key === '-') {
        e.preventDefault();
        setZoom(cropper.zoom / 1.1);
      }
    });
    zoomInput?.addEventListener('input', () => setZoom(Number(zoomInput.value)));
    $('cropper-zoom-in')?.addEventListener('click', () => setZoom(cropper.zoom * 1.2));
    $('cropper-zoom-out')?.addEventListener('click', () => setZoom(cropper.zoom / 1.2));
    $('cropper-cancel')?.addEventListener('click', closeCropper);

    $('cropper-apply')?.addEventListener('click', async () => {
      if (!cropper.bitmap) return;
      const button = $('cropper-apply');
      button.disabled = true;
      try {
        const s = scale();
        const crop = { sx: -cropper.x / s, sy: -cropper.y / s, side: cropper.view / s };
        ({ full: pendingPhoto, small: pendingSmallPhoto } = await encodeCrop(cropper.bitmap, crop));
        const url = URL.createObjectURL(pendingPhoto);
        $('photo-preview-wrap').innerHTML =
          `<img src="${url}" alt="New profile photo preview" width="96" height="96" style="width: 96px; height: 96px; border-radius: 9999px; object-fit: cover; display: block; box-shadow: 0 0 0 3px #fff, 0 0 0 4px #E5C878;" />`;
        $('photo-save').style.display = '';
        closeCropper();
        showMessage('photo', 'success', 'Looks good? Click Save photo to use it.');
      } catch (error) {
        showMessage('photo', 'error', error.message);
      } finally {
        button.disabled = false;
      }
    });

    function uploadPhoto(blob, variant) {
      return fetch(`/.netlify/functions/profile-photo${variant ? `?variant=${variant}` : ''}`, {
        method: 'POST',
        headers: { 'Content-Type': blob.type },
        credentials: 'same-origin',
        body: blob,
      });
    }

    $('photo-input')?.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      showMessage('photo', null);
      pendingPhoto = null;
      pendingSmallPhoto = null;
      $('photo-save').style.display = 'none';
      try {
        let bitmap;
        try {
          bitmap = await createImageBitmap(file);
        } catch {
          throw new Error('Could not read that image. Please choose a JPEG or PNG.');
        }
        openCropper(bitmap);
      } catch (error) {
        showMessage('photo', 'error', error.message);
        $('photo-input').value = '';
      }
    });

    $('photo-save')?.addEventListener('click', async () => {
      if (!pendingPhoto) return;
      const button = $('photo-save');
      button.disabled = true;
      button.textContent = 'Uploading...';
      showMessage('photo', null);
      try {
        // Small first: the full upload switches everyone to the new version, and
        // a missing small copy only means the full one is used instead
        if (pendingSmallPhoto) await uploadPhoto(pendingSmallPhoto, 'small').catch(() => {});
        const response = await uploadPhoto(pendingPhoto);
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Upload failed');
        showMessage('photo', 'success', 'Photo saved!');
        setTimeout(() => window.location.reload(), 800);
      } catch (error) {
        showMessage('photo', 'error', error.message);
        button.disabled = false;
        button.textContent = 'Save photo';
      }
    });

    $('photo-remove')?.addEventListener('click', async () => {
      if (!confirm('Remove your profile photo?')) return;
      try {
        const response = await fetch('/.netlify/functions/profile-photo', {
          method: 'DELETE',
          credentials: 'same-origin',
        });
        if (!response.ok) throw new Error('Failed to remove photo');
        window.location.reload();
      } catch (error) {
        showMessage('photo', 'error', error.message);
      }
    });
  </script>

