---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import StatsGrid from '../components/StatsGrid.astro';
import Card from '../components/Card.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { validateAdminSession, isMember } from '../middleware/auth';

const signedInMember = (() => {
    const cookie = Astro.request.headers.get('cookie');
    const session = cookie ? validateAdminSession(cookie) : null;
    return !!(session && isMember(session));
})();

const membershipStats = [
    { label: 'Total Members', value: '160+' },
    { label: 'Youth & Students', value: '30+' },
    { label: 'Counties Covered', value: '8' }
];

const eligibleMembers = [
    { icon: 'users', title: 'Adult Players', content: 'All skill levels welcome, from beginners to experienced cricketers.' },
    { icon: 'graduation-cap', title: 'Youth & Students', content: 'Young cricketers looking to develop their skills in a competitive environment.' },
    { icon: 'activity', title: 'Competitive & Recreational', content: "Whether you play for competition or just for fun, there's a place for you." }
];

const joinSteps = [
    { number: '1', title: 'Complete the membership form', content: 'Fill out our application with your details and cricket experience.' },
    { number: '2', title: 'Register for the NCCA league', content: 'Register with the Northern California Cricket Association to be eligible for league play.' },
    { number: '3', title: 'Pay annual club dues', content: 'Complete payment of annual membership dues to activate your membership.' },
    { number: '4', title: 'Join communication channels', content: 'Get added to team WhatsApp groups and email lists to stay connected.' }
];
---

<Layout title="Membership - Golden State Cricket Club">
    <PageHeader kicker="Join us" title="Become a Member" subtitle="Join Bengals Inc. through GSCC — competitive cricket and a community mission." />

    <div class="flex flex-wrap gap-3 -mt-2 mb-2">
        {signedInMember ? (
            <a href="/myfixtures" class="btn btn-lg">Go to my fixtures <Icon name="arrow-right" size={16} /></a>
        ) : (
            <>
                <a href="/register" class="btn btn-lg">Register now <Icon name="arrow-right" size={16} /></a>
                <a href="/contact" class="btn btn-lg btn-secondary">Ask a question</a>
            </>
        )}
    </div>

    <Section align="left">
        <div class="accent-box">
            <h2 class="section-heading">Join Bengals Inc. through GSCC</h2>
            <p class="text-body-base measure">
                When you become a member of Golden State Cricket Club, you're joining <strong>Bengals Inc.</strong>,
                a 501(c)(3) non-profit. Your dues support not just competitive cricket, but also youth development,
                community programs, and cricket growth across Northern California.
            </p>
            <p class="text-body-base measure mt-3 mb-0">
                We currently have <strong>160+ active members</strong> including <strong>30+ youth and students</strong>
                from 8 counties across the Bay Area.
            </p>
        </div>
    </Section>

    <Section title="Who Can Join" kicker="Eligibility" variant="alternate">
        <div class="grid md:grid-cols-3 gap-6">
            {eligibleMembers.map(item => <Card title={item.title} content={item.content} icon={item.icon} />)}
        </div>
    </Section>

    <Section title="Membership Overview" kicker="Snapshot">
        <StatsGrid stats={membershipStats} />
    </Section>

    <Section title="How to Join" kicker="Four steps" variant="alternate">
        <div class="grid sm:grid-cols-2 gap-5 max-w-4xl mx-auto">
            {joinSteps.map(step => (
                <div class="card card-static">
                    <div class="flex items-start gap-4">
                        <span class="step-num">{step.number}</span>
                        <div>
                            <h3 class="subsection-heading heading-margin-sm">{step.title}</h3>
                            <p class="text-body-base mb-0">{step.content}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <div class="accent-box text-center mt-10">
            {signedInMember ? (
                <>
                    <h3 class="subsection-heading">You're already a member</h3>
                    <p class="text-body-lg mb-6">Head to your fixtures to mark availability for upcoming matches.</p>
                    <a href="/myfixtures" class="btn btn-lg">Go to my fixtures <Icon name="arrow-right" size={16} /></a>
                </>
            ) : (
                <>
                    <h3 class="subsection-heading">Ready to join?</h3>
                    <p class="text-body-lg mb-6">Start your membership today. Register online and an admin will review your application.</p>
                    <a href="/register" class="btn btn-lg">Register now <Icon name="arrow-right" size={16} /></a>
                </>
            )}
        </div>

        <div class="text-center mt-6">
            <p class="text-muted mb-3">Not sure where to start?</p>
            <a href="/contact" class="btn btn-secondary">Contact us</a>
        </div>
    </Section>
</Layout>

<style>
    .step-num {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 9999px;
        background: var(--color-maroon-600);
        color: #fff;
        font-weight: 800;
        font-size: 1.1rem;
    }
</style>
