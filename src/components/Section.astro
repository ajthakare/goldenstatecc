---
interface Props {
    title?: string;
    kicker?: string;
    variant?: 'default' | 'alternate';
    id?: string;
    align?: 'left' | 'center';
}

const { title, kicker, variant = 'default', id, align = 'center' } = Astro.props;
const isAlt = variant === 'alternate';
---

<section
    class="section-spacing"
    style={isAlt ? 'background-color: var(--color-surface-sunken);' : ''}
    id={id}
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {(title || kicker) && (
            <div class:list={["section-head", { "section-head--center": align === 'center' }]}>
                {kicker && <span class="kicker">{kicker}</span>}
                {title && <h2 class="section-heading">{title}</h2>}
                <div class="rule-gold section-head__rule"></div>
            </div>
        )}
        <slot />
    </div>
</section>

<style>
    .section-head { margin-bottom: 1.75rem; }
    .section-head--center { text-align: center; }
    .section-head .kicker { margin-bottom: 0.6rem; }
    .section-head .section-heading { margin-bottom: 0; }
    .section-head__rule { margin-top: 1rem; }
    .section-head--center .section-head__rule { margin-left: auto; margin-right: auto; }
</style>
