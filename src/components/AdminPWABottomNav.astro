---
// Admin PWA Bottom Nav — only visible in display-mode: standalone
// Active tab is set client-side based on current path
---

<nav class="admin-pwa-bottom-nav" id="admin-pwa-bottom-nav" aria-label="Admin app navigation">

  <!-- Availability -->
  <a href="/admin/availability" class="admin-pwa-tab" data-path="/admin/availability" aria-label="Availability">
    <span class="admin-pwa-tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
        <path d="M9 16l2 2 4-4"></path>
      </svg>
    </span>
    <span class="admin-pwa-tab-label">Availability</span>
  </a>

  <!-- Practice -->
  <a href="/admin/practices" class="admin-pwa-tab" data-path="/admin/practices" aria-label="Practice Sessions">
    <span class="admin-pwa-tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
    </span>
    <span class="admin-pwa-tab-label">Practice</span>
  </a>

  <!-- Notify -->
  <a href="/admin/notifications" class="admin-pwa-tab" data-path="/admin/notifications" aria-label="Send Notification">
    <span class="admin-pwa-tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
      </svg>
    </span>
    <span class="admin-pwa-tab-label">Notify</span>
  </a>

  <!-- Players -->
  <a href="/admin/players" class="admin-pwa-tab" data-path="/admin/players" aria-label="Players Info">
    <span class="admin-pwa-tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
    </span>
    <span class="admin-pwa-tab-label">Players</span>
  </a>

  <!-- Statistics -->
  <a href="/admin/statistics" class="admin-pwa-tab" data-path="/admin/statistics" aria-label="Statistics">
    <span class="admin-pwa-tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
    </span>
    <span class="admin-pwa-tab-label">Statistics</span>
  </a>

</nav>

<script>
  function setAdminActiveTab() {
    const path = window.location.pathname;
    const tabs = document.querySelectorAll('.admin-pwa-tab');

    tabs.forEach((tab) => {
      const tabPath = tab.getAttribute('data-path') || '';
      const isActive = path === tabPath || path.startsWith(tabPath + '/');
      tab.classList.toggle('active', isActive);
      tab.setAttribute('aria-current', isActive ? 'page' : 'false');
    });
  }

  setAdminActiveTab();
</script>

<style>
  .admin-pwa-bottom-nav {
    display: none; /* hidden in browser */
  }

  @media (display-mode: standalone) {
    .admin-pwa-bottom-nav {
      display: flex;
      align-items: stretch;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: var(--color-ink, #1A1614);
      border-top: 2px solid var(--color-gold-500, #C9A227);
      padding-bottom: env(safe-area-inset-bottom);
      padding-left: env(safe-area-inset-left);
      padding-right: env(safe-area-inset-right);
      box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.3);
    }
  }

  .admin-pwa-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 10px 4px;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s;
    -webkit-tap-highlight-color: transparent;
    min-height: 56px;
  }

  .admin-pwa-tab:active {
    color: #E9C86B;
    background: rgba(255, 255, 255, 0.05);
  }

  .admin-pwa-tab.active {
    color: #E9C86B;
  }

  .admin-pwa-tab-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s;
  }

  .admin-pwa-tab.active .admin-pwa-tab-icon {
    transform: translateY(-1px);
  }

  .admin-pwa-tab-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
