---
/**
 * UmpiringDutyCard — a game between two other teams that one of ours
 * officiates, on the public schedule (/fixtures). `umpires` is only present
 * for signed-in members; signed-out visitors just see the umpiring team.
 * `seasonName` labels the duty's season while two seasons are listed.
 */
import Icon from './Icon.astro';
import type { PublicUmpiringDuty } from '../types/umpiring';
import { teamPillStyle } from '../utils/teamColors';

interface Props {
    duty: PublicUmpiringDuty & { displayDate: string };
    isPast: boolean;
    compact?: boolean;
    seasonName?: string;
}

const { duty, isPast, compact = false, seasonName } = Astro.props;
const umpires = duty.umpires;
---
<div
    class={`fixture-card umpiring-card ${compact ? 'p-5' : 'p-6'}`}
    data-team={duty.umpiringTeam}
    data-kind="umpiring"
    data-is-past={isPast ? 'true' : 'false'}
>
    {/* Header: same layout as match cards — our team on the left, the kind of game on the right */}
    {compact ? (
        <div class="flex items-center justify-between gap-2 mb-3">
            <div>
                <span class="badge badge-neutral badge-team">{duty.umpiringTeam}</span>
                {seasonName && <div class="mt-1.5 pl-1 text-xs font-medium text-muted">{seasonName}</div>}
            </div>
            <span class="kicker umpiring-label shrink-0">Umpiring</span>
        </div>
    ) : (
        <div class="flex items-start justify-between gap-2 mb-4">
            {isPast ? (
                <span class="badge badge-neutral badge-team">{duty.umpiringTeam}</span>
            ) : (
            <div>
                <div class="px-4 py-2 rounded-full text-base font-bold" style={teamPillStyle(duty.umpiringTeam)}>
                    {duty.umpiringTeam}
                </div>
                {seasonName && <div class="mt-1.5 pl-1 text-xs font-medium text-muted">{seasonName}</div>}
            </div>
            )}
            <span class="umpiring-label text-sm font-semibold"><Icon name="field-rings" size={14} /> UMPIRING</span>
        </div>
    )}

    <div class={`${compact ? 'text-lg mb-3' : 'text-xl mb-2'} font-bold text-heading`}>
        {duty.homeTeam} <span class="text-muted font-semibold text-base">vs</span> {duty.visitorTeam}
    </div>
    {compact ? (
        <div class="flex items-center gap-2 text-muted mb-2 text-sm">
            <Icon name="calendar" size={15} />
            <span class="font-semibold">{duty.displayDate}</span>
            <span class="text-subtle">·</span>
            <span>{duty.time}</span>
        </div>
    ) : (
        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-600 mb-4">
            <span>{duty.displayDate}</span>
            <span>{duty.time}</span>
            <span class="px-2 py-0.5 bg-gray-100 rounded text-xs font-medium">{duty.division}</span>
        </div>
    )}

    {compact ? (
        <div class="rounded-lg p-3 mt-1" style="background:var(--color-surface-sunken);border:1px solid var(--color-hairline);">
            <div class="font-semibold text-heading text-sm mb-1 flex items-center gap-2">
                <Icon name="map-pin" size={14} />
                <span>{duty.venue}</span>
            </div>
            {duty.groundAddress && <div class="text-xs text-muted pl-6">{duty.groundAddress}</div>}
            <div class="text-xs text-subtle mt-2 pl-6">{duty.division}</div>
        </div>
    ) : (
        <div class="rounded-lg p-3" style="background:var(--color-surface-sunken);border:1px solid var(--color-hairline);">
            <div class="font-semibold text-gray-900 mb-1">{duty.venue}</div>
            {duty.groundAddress && <div class="text-sm text-gray-600">{duty.groundAddress}</div>}
        </div>
    )}

    {umpires && (
        <div class={`umpiring-names text-sm ${compact ? 'umpiring-names--compact mt-2' : 'mt-3'}`}>
            <Icon name="users" size={14} />
            {umpires.length > 0
                ? <span>{umpires.length > 1 ? 'Umpires' : 'Umpire'}: <strong class="font-bold">{umpires.join(', ')}</strong></span>
                : <span class="text-muted">Umpire: to be assigned</span>}
        </div>
    )}

    {!compact && (
        <div class="mt-4 pt-4 border-t border-gray-200 text-xs text-gray-500">
            <span>Game #{duty.gameNumber}</span>
        </div>
    )}
</div>

<style>
    /* Same layer as the theme's .fixture-card !important borders, so this one can win */
    @layer components {
        .fixture-card.umpiring-card[data-kind="umpiring"] { border-left-color: #1e4f86 !important; }
    }
    .umpiring-label {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #1e4f86;
        white-space: nowrap;
    }
    .umpiring-names {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 8px;
        background: #f5f8fc;
        color: #1f2937;
    }
    .umpiring-names--compact {
        padding: 0 4px;
        background: none;
    }
</style>
