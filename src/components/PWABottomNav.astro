---
// PWA Bottom Nav — only visible in display-mode: standalone
// Active tab is set client-side based on current path
---

<nav class="pwa-bottom-nav" id="pwa-bottom-nav" aria-label="App navigation">

  <!-- Schedule -->
  <a href="/fixtures" class="pwa-tab" data-path="/fixtures" aria-label="Schedule">
    <span class="pwa-tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
    </span>
    <span class="pwa-tab-label">Schedule</span>
  </a>

  <!-- My Fixtures -->
  <a href="/myfixtures" class="pwa-tab" data-path="/myfixtures" aria-label="My Fixtures">
    <span class="pwa-tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 11l3 3L22 4"></path>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
      </svg>
    </span>
    <span class="pwa-tab-label">My Fixtures</span>
  </a>

  <!-- Practice -->
  <a href="/mypractice" class="pwa-tab" data-path="/mypractice" aria-label="Practice Sessions">
    <span class="pwa-tab-icon">
      <!-- Cricket bat icon -->
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
    </span>
    <span class="pwa-tab-label">Practice</span>
  </a>

  <!-- Profile -->
  <a href="/profile" class="pwa-tab" data-path="/profile" aria-label="My Profile">
    <span class="pwa-tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    </span>
    <span class="pwa-tab-label">Profile</span>
  </a>

</nav>

<script>
  function setActiveTab() {
    const path = window.location.pathname;
    const tabs = document.querySelectorAll('.pwa-tab');

    tabs.forEach((tab) => {
      const tabPath = tab.getAttribute('data-path') || '';
      const isActive = path === tabPath || path.startsWith(tabPath + '/');
      tab.classList.toggle('active', isActive);
      tab.setAttribute('aria-current', isActive ? 'page' : 'false');
    });
  }

  setActiveTab();
</script>

<style>
  .pwa-bottom-nav {
    display: none; /* hidden in browser */
  }

  @media (display-mode: standalone) {
    .pwa-bottom-nav {
      display: flex;
      align-items: stretch;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: var(--color-ink, #1A1614);
      border-top: 2px solid var(--color-gold-500, #C9A227);
      padding-bottom: env(safe-area-inset-bottom);
      padding-left: env(safe-area-inset-left);
      padding-right: env(safe-area-inset-right);
      box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.3);
    }
  }

  .pwa-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 10px 4px;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s;
    -webkit-tap-highlight-color: transparent;
    min-height: 56px;
  }

  .pwa-tab:active {
    color: #E9C86B;
    background: rgba(255, 255, 255, 0.05);
  }

  .pwa-tab.active {
    color: #E9C86B;
  }

  .pwa-tab-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s;
  }

  .pwa-tab.active .pwa-tab-icon {
    transform: translateY(-1px);
  }

  .pwa-tab-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
