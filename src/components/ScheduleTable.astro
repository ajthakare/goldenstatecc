---
/**
 * ScheduleTable — the "View by: Grid" layout of /fixtures: one row per match
 * or umpiring duty, in the order given. Rows carry the same data-* attributes
 * as the cards, so the page's team / game type filters apply to both.
 * Kept to a few columns so it fits a phone: date over time, division under
 * the team, then the game type. Past matches show their result under the match; `showLinks` one for YouTube/scorecard.
 */
import { teamPillStyle } from '../utils/teamColors';

interface Row {
    kind?: 'match' | 'umpiring';
    sortDate: Date;
    time: string;
    division: string;
    venue: string;
    seasonName: string;
    // Matches
    ourTeam?: string;
    opponent?: string;
    isHome?: boolean;
    umpire?: string;
    result?: string;
    playerOfMatchName?: string;
    youtubeVideoUrl?: string;
    scoringAppUrl?: string;
    // Duties
    umpiringTeam?: string;
    homeTeam?: string;
    visitorTeam?: string;
    umpires?: string[];
}

interface Props {
    items: Row[];
    isPast: boolean;
    showLinks: boolean;
    resultBadge: (result: string) => { text: string; color: string };
}

const { items, isPast, showLinks, resultBadge } = Astro.props;
// Every team in the Team column is ours, so the "GSCC" prefix is dropped there
const shortDate = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
---
<p class="scroll-hint">Scroll sideways to see more columns →</p>
<div class="schedule-table-wrap">
    <table class="schedule-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Team</th>
                <th>Match</th>
                <th>Venue</th>
                <th>Umpire</th>
                {showLinks && <th>Links</th>}
            </tr>
        </thead>
        <tbody>
            {items.map((item) => {
                const duty = item.kind === 'umpiring';
                const team = (duty ? item.umpiringTeam : item.ourTeam) || '';
                const badge = isPast && !duty && item.result ? resultBadge(item.result) : null;
                return (
                    <tr
                        class="schedule-row"
                        data-team={team}
                        data-kind={duty ? 'umpiring' : undefined}
                        data-is-home={duty ? undefined : String(item.isHome)}
                        data-is-past={isPast ? 'true' : 'false'}
                    >
                        <td class="nowrap">
                            <div class="font-semibold">{shortDate(item.sortDate)}</div>
                            <div class="sub">{item.time}</div>
                        </td>
                        <td>
                            <span class="team-pill" style={teamPillStyle(team)}>{team.replace(/^GSCC\s+/i, '')}</span>
                            <div class="sub nowrap">
                                {item.division},{' '}
                                <span class={`type-tag type-${duty ? 'umpiring' : item.isHome ? 'home' : 'away'}`}>
                                    {duty ? 'Umpiring' : item.isHome ? 'Home' : 'Away'}
                                </span>
                            </div>
                        </td>
                        <td class="match-cell">
                            {duty
                                ? <>{item.homeTeam}{' '}<span class="text-muted">vs</span>{' '}{item.visitorTeam}</>
                                : <><span class="text-muted">vs</span>{' '}{item.opponent}</>}
                            {/* Past matches: the result on the line below (duties have none) */}
                            {badge && (
                                <div class="result-line">
                                    <span class={`result-badge ${badge.color}`}>{badge.text}</span>
                                    {item.result === 'win' && item.playerOfMatchName && <span class="sub">POTM: {item.playerOfMatchName}</span>}
                                </div>
                            )}
                        </td>
                        <td>{item.venue}</td>
                        <td>
                            {!duty ? (item.umpire || '—')
                                : item.umpires?.length ? <strong class="font-bold">{item.umpires.join(', ')}</strong>
                                : item.umpires ? <span class="text-muted">To be assigned</span>
                                : '—'}
                        </td>
                        {showLinks && (
                            <td class="nowrap">
                                {item.scoringAppUrl && <a href={item.scoringAppUrl} target="_blank" rel="noopener noreferrer">Scorecard</a>}
                                {item.scoringAppUrl && item.youtubeVideoUrl && <span class="text-subtle"> · </span>}
                                {item.youtubeVideoUrl && <a href={item.youtubeVideoUrl} target="_blank" rel="noopener noreferrer">Video</a>}
                            </td>
                        )}
                    </tr>
                );
            })}
        </tbody>
    </table>
</div>

<style>
    .schedule-table-wrap {
        display: none;
        overflow-x: auto;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-card);
        background: var(--color-surface, #fff);
    }
    :global(html[data-view="grid"]) .schedule-table-wrap { display: block; }
    .schedule-table-wrap.is-empty { display: none !important; }
    /* Only when the table is wider than the screen (set by the script below) */
    .scroll-hint {
        display: none;
        margin: 0 0 0.4rem;
        font-size: 0.7rem;
        color: var(--color-muted-text);
        text-align: right;
    }
    :global(html[data-view="grid"]) .scroll-hint.is-shown { display: block; }
    .schedule-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; line-height: 1.3; }
    .schedule-table th {
        position: sticky;
        top: 0;
        text-align: left;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-muted-text);
        background: var(--color-surface-sunken);
        border-bottom: 1px solid var(--color-hairline);
        padding: 0.6rem 0.75rem;
        white-space: nowrap;
    }
    .schedule-table td {
        padding: 0.6rem 0.75rem;
        border-bottom: 1px solid var(--color-hairline);
        vertical-align: top;
        color: var(--color-ink);
    }
    .schedule-table tbody tr:last-child td { border-bottom: 0; }
    /* Alternate rows in the theme's cream; the page re-stripes after filtering so hidden rows don't break it */
    .schedule-table tbody tr.is-alt td { background: var(--color-bg-hero-dark); }
    /* Hovered / tapped row: the brand's maroon tint and a maroon edge, so it doesn't read as a cream row */
    .schedule-table tbody tr:hover td { background: var(--color-maroon-100); }
    .schedule-table tbody tr:hover td:first-child { box-shadow: inset 3px 0 0 var(--color-maroon-600); }
    .schedule-table .nowrap { white-space: nowrap; }
    .schedule-table .match-cell { font-size: 0.78rem; font-weight: 600; min-width: 8.5rem; }
    .schedule-table .sub { margin-top: 0.2rem; font-size: 0.72rem; color: var(--color-muted-text); }
    /* Phones: tighter cells so more of the row fits before it scrolls */
    @media (max-width: 639px) {
        .schedule-table { font-size: 0.75rem; }
        .schedule-table th { padding: 0.5rem 0.5rem; font-size: 0.62rem; }
        .schedule-table td { padding: 0.5rem 0.5rem; }
        .schedule-table .match-cell { font-size: 0.72rem; min-width: 7.5rem; }
        .team-pill { padding: 0.1rem 0.45rem; font-size: 0.68rem; }
    }
    .schedule-table a { color: var(--color-maroon-600); font-weight: 600; text-decoration: underline; }
    .team-pill {
        display: inline-block;
        padding: 0.15rem 0.6rem;
        border-radius: var(--radius-pill);
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .type-tag { font-weight: 700; }
    .type-home { color: #15803d; }
    .type-away { color: #1d4ed8; }
    .type-umpiring { color: var(--color-muted-text); }
    .result-line { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.5rem; margin-top: 0.35rem; font-weight: 400; }
    .result-line .sub { margin-top: 0; }
    .result-badge {
        display: inline-flex;
        padding: 0.2rem 0.6rem;
        border-radius: var(--radius-pill);
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #fff;
        white-space: nowrap;
    }
    .result-win  { background: #1B6B3A; }
    .result-loss { background: #A82B24; }
    .result-tie  { background: #A9821B; }
    .result-nr   { background: #9CA3AF; }
</style>

<script>
    // Show the scroll hint above a table only while its columns don't fit.
    // The observer also fires when Grid view shows the table.
    document.querySelectorAll<HTMLElement>('.schedule-table-wrap').forEach((wrap) => {
        const hint = wrap.previousElementSibling;
        // Measured now and again shortly after, once the table has laid out at the new width
        const measure = () => hint?.classList.toggle('is-shown', wrap.scrollWidth > wrap.clientWidth + 1);
        const check = () => { measure(); setTimeout(measure, 100); };
        // The table too: filtering rows can change how wide it needs to be
        const observer = new ResizeObserver(check);
        observer.observe(wrap);
        observer.observe(wrap.querySelector('table')!);
        window.addEventListener('resize', check);
        check();
    });
</script>
