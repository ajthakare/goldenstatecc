---
interface Stat {
    label: string;
    value: string;
}

interface Props {
    stats: Stat[];
}

const { stats } = Astro.props;
const cols = stats.length === 3
    ? 'grid-cols-3 max-w-3xl'
    : stats.length === 4
    ? 'grid-cols-2 md:grid-cols-4'
    : 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4';
---

<div class={`stats-grid grid ${cols} mx-auto`}>
    {stats.map((stat, i) => (
        <div class:list={["stat-cell", { "stat-cell--divider": i > 0 }]}>
            <div class="stat-cell__value">{stat.value}</div>
            <div class="stat-cell__label">{stat.label}</div>
        </div>
    ))}
</div>

<style>
    .stats-grid { gap: 0; }
    .stat-cell {
        text-align: center;
        padding: 0.75rem 1rem;
        position: relative;
    }
    .stat-cell__value {
        font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1;
        color: var(--color-maroon-600);
        font-variant-numeric: tabular-nums;
    }
    .stat-cell__label {
        margin-top: 0.5rem;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-muted-text);
    }
    /* vertical hairlines between cells (skip first in each row via nth) */
    .stat-cell--divider::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 1px;
        height: 2.5rem;
        background: var(--color-hairline);
    }
    @media (max-width: 640px) {
        .stat-cell:nth-child(odd)::before { display: none; }
    }
</style>
