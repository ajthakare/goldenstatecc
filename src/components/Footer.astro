---
import Icon from '../components/Icon.astro';
import { SITE_CONFIG } from '../config';

const year = new Date().getFullYear();

const explore = [
    { label: 'The Club', href: '/aboutus/club' },
    { label: 'Teams', href: '/teams' },
    { label: 'Fixtures', href: '/fixtures' },
    { label: 'Gallery', href: '/gallery' },
    { label: 'Membership', href: '/members' },
];

const support = [
    { label: 'Non-Profit', href: '/aboutus/non-profit' },
    { label: 'Sponsorships', href: '/aboutus/sponsorships' },
    { label: 'Contact Us', href: '/contact' },
    { label: 'Member Login', href: '/login' },
];
---

<footer class="site-footer mt-16 rounded-t-2xl px-6 sm:px-10 pt-12 pb-8">
    <div class="max-w-5xl mx-auto">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <div class="wm">{SITE_CONFIG.name}</div>
                <p class="text-sm text-muted mt-2 max-w-xs">
                    Competitive cricket and community across the Bay Area since 2018.
                </p>
                <div class="flex gap-2 mt-4">
                    <a href={SITE_CONFIG.social.instagram.url} target="_blank" rel="noopener noreferrer" class="foot-social" aria-label="Instagram">
                        <Icon name="instagram" size={18} />
                    </a>
                    <a href={SITE_CONFIG.social.youtube.url} target="_blank" rel="noopener noreferrer" class="foot-social" aria-label="YouTube">
                        <Icon name="youtube" size={18} />
                    </a>
                    <a href={`mailto:${SITE_CONFIG.email}`} class="foot-social" aria-label="Email">
                        <Icon name="mail" size={18} />
                    </a>
                </div>
            </div>

            <div>
                <div class="foot-h">Explore</div>
                <ul class="space-y-2">
                    {explore.map((l) => <li><a href={l.href} class="foot-link">{l.label}</a></li>)}
                </ul>
            </div>

            <div>
                <div class="foot-h">Club</div>
                <ul class="space-y-2">
                    {support.map((l) => <li><a href={l.href} class="foot-link">{l.label}</a></li>)}
                </ul>
            </div>

            <div>
                <div class="foot-h">Non-Profit</div>
                <span class="badge badge-success">
                    <Icon name="check" size={14} /> {SITE_CONFIG.nonProfit.status}
                </span>
                <p class="text-xs text-subtle mt-3 leading-relaxed">
                    {SITE_CONFIG.nonProfit.name} is a registered 501(c)(3) non-profit.
                    EIN: {SITE_CONFIG.nonProfit.ein}. Donations are tax-deductible to the
                    extent allowed by law.
                </p>
            </div>
        </div>

        <div class="mt-10 pt-6 border-t border-[color:var(--color-hairline)] text-xs text-subtle flex flex-col sm:flex-row gap-1 sm:justify-between">
            <span>&copy; {year} {SITE_CONFIG.name} — {SITE_CONFIG.location}</span>
            <span>All rights reserved.</span>
        </div>
    </div>
</footer>

<style>
    .site-footer .wm {
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        color: var(--color-ink);
    }
    .foot-h {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-muted-text);
        margin-bottom: 0.9rem;
    }
    .foot-link {
        font-size: 0.9375rem;
        color: var(--color-body-text);
        transition: color var(--dur-base) var(--ease-out);
    }
    .foot-link:hover { color: var(--color-maroon-600); }
    .foot-social {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        color: var(--color-body-text);
        background: var(--color-surface);
        border: 1px solid var(--color-hairline);
        transition: all var(--dur-base) var(--ease-out);
    }
    .foot-social:hover {
        color: #fff;
        background: var(--color-maroon-600);
        border-color: var(--color-maroon-600);
    }
</style>
