---
import Icon from './Icon.astro';
import { SITE_CONFIG } from '../config';
import { teamPillStyle } from '../utils/teamColors';
import { youtubeThumbnail, type MatchVideo } from '../utils/matchVideos';

interface Props {
    /** Newest game first */
    videos: MatchVideo[];
    /** How many recent games to show; the rest are on YouTube. */
    limit?: number;
}

const { videos, limit = 6 } = Astro.props;
const recent = videos.slice(0, limit);

// Dates are plain YYYY-MM-DD, so format them in UTC to keep the day as entered.
function parseDay(date: string): Date {
    return new Date(`${date}T12:00:00Z`);
}
function formatDay(date: string): string {
    return parseDay(date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

{videos.length > 0 && (
    <div class="mv">
        <div class="mv__grid">
            {recent.map((video) => (
                <a
                    class="mv__card"
                    href={video.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Watch ${video.team} vs ${video.opponent}, ${formatDay(video.date)}, on YouTube (opens in a new tab)`}
                >
                    <span class="mv__thumb">
                        <img
                            src={youtubeThumbnail(video.videoId)}
                            alt=""
                            width="480"
                            height="360"
                            loading="lazy"
                            referrerpolicy="no-referrer"
                            style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;"
                        />
                        <span class="mv__play" aria-hidden="true">▶</span>
                    </span>
                    <span class="mv__body">
                        <span class="mv__teams">
                            <span class="mv__pill" style={teamPillStyle(video.team)}>{video.team}</span>
                            <span class="mv__vs">vs {video.opponent}</span>
                        </span>
                        <span class="mv__meta">{formatDay(video.date)} · {video.division}</span>
                    </span>
                </a>
            ))}
        </div>

        <div class="mv__more-wrap">
            <a class="btn" href={SITE_CONFIG.social.youtube.url} target="_blank" rel="noopener noreferrer">
                <Icon name="youtube" size={18} /> More videos on our YouTube channel
            </a>
        </div>
    </div>
)}

<style>
    .mv { max-width: 1080px; margin: 0 auto; text-align: left; }

    .mv__grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
    }
    @media (min-width: 640px) { .mv__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (min-width: 1024px) { .mv__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; } }

    .mv__card {
        display: flex;
        flex-direction: column;
        padding: 0;
        text-align: left;
        color: inherit;
        text-decoration: none;
        border-radius: var(--radius-card, 12px);
        overflow: hidden;
        background: var(--color-surface, #fff);
        border: 1px solid var(--color-border, #e5e0d8);
        box-shadow: var(--shadow-card, 0 2px 8px rgba(26, 22, 20, 0.06));
        transition: transform var(--dur-base, 220ms) var(--ease-out, ease-out), box-shadow var(--dur-base, 220ms) var(--ease-out, ease-out);
    }
    .mv__card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md, 0 6px 18px rgba(26, 22, 20, 0.12)); }
    .mv__card:focus-visible { outline: 2px solid var(--color-maroon-500, #a82a22); outline-offset: 2px; }

    /* 16:9 box via padding (no aspect-ratio, per the gallery image rules) */
    .mv__thumb {
        position: relative;
        display: block;
        padding-top: 56.25%;
        background: #111;
        overflow: hidden;
    }
    .mv__thumb img { transition: transform var(--dur-slow, 380ms) var(--ease-out, ease-out); }
    .mv__card:hover .mv__thumb img { transform: scale(1.04); }

    .mv__play {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 56px;
        height: 56px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-left: 4px;
        font-size: 1.3rem;
        color: #fff;
        background: rgba(0, 0, 0, 0.6);
        transition: background var(--dur-base, 220ms) var(--ease-out, ease-out);
    }
    .mv__card:hover .mv__play { background: #ff0033; }

    .mv__body {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.9rem 1rem 1rem;
    }

    /* Team pill, then "vs Opponent" on its own line, the same on every card */
    .mv__teams { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; min-width: 0; }
    .mv__pill {
        flex-shrink: 0;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 999px;
    }
    .mv__vs {
        min-width: 0;
        overflow-wrap: break-word;
        line-height: 1.35;
        font-weight: 600;
        color: var(--color-text-heading, #222);
    }
    .mv__meta { font-size: 0.85rem; color: var(--color-text-muted, #6b6359); }

    .mv__more-wrap { display: flex; justify-content: center; margin-top: 1.75rem; }

    @media (prefers-reduced-motion: reduce) {
        .mv__card, .mv__thumb img { transition: none; }
        .mv__card:hover { transform: none; }
        .mv__card:hover .mv__thumb img { transform: none; }
    }
</style>

