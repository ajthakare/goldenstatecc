---
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { SITE_CONFIG } from '../config';
import { validateAdminSession } from '../middleware/auth';

const navItems = [
    { linkText: 'Home', href: '/' },
    {
        linkText: 'About Us',
        href: '/aboutus/club',
        dropdown: [
            { linkText: 'The Club', href: '/aboutus/club' },
            { linkText: 'Non-Profit', href: '/aboutus/non-profit' },
            { linkText: 'Sponsorships', href: '/aboutus/sponsorships' }
        ]
    },
    { linkText: 'Teams', href: '/teams' },
    { linkText: 'Fixtures', href: '/fixtures' },
    { linkText: 'Members', href: '/members' },
    // /winter-checkin is hidden from nav until the club launches it publicly
    // (SITE_CONFIG.winterCheckIn.isOpen). The page still works by direct URL.
    ...(SITE_CONFIG.winterCheckIn?.isOpen
        ? [{ linkText: 'Winter Check-In', href: '/winter-checkin' }]
        : []),
    { linkText: 'Gallery', href: '/gallery' },
    { linkText: 'Contact Us', href: '/contact' }
];

// Check authentication status
const cookieHeader = Astro.request.headers.get('cookie');
let session = null;
let isAuthenticated = false;
let role = null;
let isAdmin = false;
let isMember = false;
let firstName = '';

if (cookieHeader) {
    session = validateAdminSession(cookieHeader);
    if (session) {
        isAuthenticated = true;
        role = session.role;
        isAdmin = role === 'super_admin' || role === 'admin';
        isMember = ['super_admin', 'admin', 'member'].includes(role);

        // Fetch user's first name
        try {
            const response = await fetch(`${Astro.url.origin}/.netlify/functions/auth-check`, {
                headers: {
                    'Cookie': cookieHeader
                }
            });
            if (response.ok) {
                const data = await response.json();
                firstName = data.user?.firstName || '';
            }
        } catch (error) {
            console.error('Error fetching user data:', error);
        }
    }
}

// Get current path to highlight active page
const currentPath = Astro.url.pathname;
---

<nav class="site-nav py-3 sm:py-4 px-4 sm:px-6">
    <div class="grid grid-cols-[auto_1fr] gap-4 items-center">
        {/* Column 1: Logo */}
        <a href="/" class="flex items-center self-stretch" aria-label="Golden State Cricket Club — home">
            <Logo />
        </a>

        {/* Column 2: Wordmark + nav */}
        <div class="flex flex-col gap-2 min-w-0">
            {/* Row 1: Wordmark + auth + mobile toggle */}
            <div class="flex items-center justify-between gap-3">
                <div class="flex flex-col leading-none min-w-0">
                    <span class="wordmark">{SITE_CONFIG.name}</span>
                    <span class="wordmark-sub">{SITE_CONFIG.location}</span>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    {isAuthenticated ? (
                        <>
                            {firstName && (
                                <span class="hidden lg:block text-sm font-medium text-white/70">
                                    Hi, {firstName}
                                </span>
                            )}
                            <a href="/logout" class="nav-icon-btn hidden lg:flex" aria-label="Log out">
                                <Icon name="log-out" size={18} />
                            </a>
                        </>
                    ) : (
                        <a href="/login" class="nav-icon-btn hidden lg:flex" aria-label="Log in">
                            <Icon name="log-in" size={18} />
                        </a>
                    )}

                    {/* Mobile Menu Button */}
                    <button
                        id="mobile-menu-toggle"
                        class="nav-icon-btn lg:hidden"
                        aria-label="Toggle navigation menu"
                        aria-expanded="false"
                    >
                        <span id="menu-icon"><Icon name="menu" size={26} /></span>
                        <span id="close-icon" class="hidden"><Icon name="x" size={26} /></span>
                    </button>
                </div>
            </div>

            {/* Row 2: Desktop primary nav */}
            {
                !!navItems?.length && (
                    <ul class="hidden lg:flex flex-wrap gap-x-1 xl:gap-x-2 items-center">
                        {navItems.map((item) => {
                            const isActive = item.href !== '/' && (currentPath === item.href || currentPath.startsWith(item.href));
                            const hasDropdown = item.dropdown && item.dropdown.length > 0;

                            return (
                                <li class={hasDropdown ? 'relative dropdown-container' : ''}>
                                    <a
                                        href={item.href}
                                        class={`nav-link ${isActive ? 'nav-active' : ''}`}
                                    >
                                        {item.linkText}
                                        {hasDropdown && <Icon name="chevron-down" size={13} class="ml-0.5 opacity-70" />}
                                    </a>
                                    {hasDropdown && (
                                        <ul class="dropdown-menu absolute left-0 mt-1 rounded-lg py-1.5 min-w-[190px] opacity-0 invisible transition-all duration-200">
                                            {item.dropdown.map((dropdownItem) => {
                                                const isDropdownActive = currentPath === dropdownItem.href || currentPath.startsWith(dropdownItem.href);
                                                return (
                                                    <li>
                                                        <a
                                                            href={dropdownItem.href}
                                                            class={`dropdown-link ${isDropdownActive ? 'is-active' : ''}`}
                                                        >
                                                            {dropdownItem.linkText}
                                                        </a>
                                                    </li>
                                                );
                                            })}
                                        </ul>
                                    )}
                                </li>
                            );
                        })}
                    </ul>
                )
            }

            {/* Row 3: Member strip (authenticated) */}
            {isAuthenticated && (
                <ul class="hidden lg:flex gap-x-1 xl:gap-x-2 items-center member-strip">
                    {isMember && (
                        <li><a href="/myfixtures" class={`nav-link nav-link--sm ${currentPath === '/myfixtures' ? 'nav-active' : ''}`}>My Fixtures</a></li>
                    )}
                    {isMember && (
                        <li><a href="/mypractice" class={`nav-link nav-link--sm ${currentPath === '/mypractice' ? 'nav-active' : ''}`}>Practice Sessions</a></li>
                    )}
                    {isAdmin && (
                        <li><a href="/admin" target="_blank" rel="noopener noreferrer" class="nav-link nav-link--sm inline-flex items-center gap-1">Admin Portal <Icon name="external-link" size={12} /></a></li>
                    )}
                    {isMember && (
                        <li><a href="/profile" class={`nav-link nav-link--sm ${currentPath === '/profile' ? 'nav-active' : ''}`}>My Profile</a></li>
                    )}
                </ul>
            )}
        </div>
    </div>

    {/* Mobile Navigation Menu */}
    <div id="mobile-menu" class="mobile-menu">
        <ul class="flex flex-col gap-1 p-6">
            {isAuthenticated && firstName && (
                <li class="mb-2 pb-3 border-b border-white/15">
                    <span class="block px-5 py-2 text-base font-semibold text-white/80">Hi, {firstName}</span>
                </li>
            )}

            {
                navItems.map((item, index) => {
                    const isActive = item.href !== '/' && (currentPath === item.href || currentPath.startsWith(item.href));
                    const hasDropdown = item.dropdown && item.dropdown.length > 0;

                    return (
                        <li>
                            {hasDropdown ? (
                                <button
                                    class={`mobile-nav-link w-full text-left flex items-center justify-between mobile-dropdown-toggle ${isActive ? 'mobile-nav-active' : ''}`}
                                    data-dropdown-id={`mobile-dropdown-${index}`}
                                >
                                    <span>{item.linkText}</span>
                                    <Icon name="chevron-down" size={16} class="transition-transform mobile-dropdown-icon" />
                                </button>
                            ) : (
                                <a href={item.href} class={`mobile-nav-link ${isActive ? 'mobile-nav-active' : ''}`}>
                                    {item.linkText}
                                </a>
                            )}
                            {hasDropdown && (
                                <ul class="ml-4 mt-1 space-y-1 hidden mobile-dropdown-content" id={`mobile-dropdown-${index}`}>
                                    {item.dropdown.map((dropdownItem) => {
                                        const isDropdownActive = currentPath === dropdownItem.href || currentPath.startsWith(dropdownItem.href);
                                        return (
                                            <li>
                                                <a href={dropdownItem.href} class={`mobile-nav-link text-sm ${isDropdownActive ? 'mobile-nav-active' : ''}`}>
                                                    {dropdownItem.linkText}
                                                </a>
                                            </li>
                                        );
                                    })}
                                </ul>
                            )}
                        </li>
                    );
                })
            }

            <li class="border-t border-white/15 mt-2 pt-2">
                {isAuthenticated ? (
                    <div class="flex flex-col gap-1">
                        {isMember && <a href="/myfixtures" class="mobile-nav-link">My Fixtures</a>}
                        {isMember && <a href="/mypractice" class="mobile-nav-link">Practice Sessions</a>}
                        {isAdmin && <a href="/admin" target="_blank" rel="noopener noreferrer" class="mobile-nav-link">Admin Portal ↗</a>}
                        {isMember && <a href="/profile" class="mobile-nav-link">My Profile</a>}
                        <a href="/logout" class="mobile-nav-link flex items-center gap-2">
                            <Icon name="log-out" size={18} /> Logout
                        </a>
                    </div>
                ) : (
                    <div class="flex flex-col gap-1">
                        <a href="/login" class="mobile-nav-link flex items-center gap-2"><Icon name="log-in" size={18} /> Login</a>
                    </div>
                )}
            </li>
        </ul>
    </div>

    <div id="mobile-menu-overlay" class="mobile-menu-overlay"></div>
</nav>

<style>
    .site-nav {
        margin-bottom: 2.5rem;
    }

    /* Wordmark — heavy sans, not serif */
    .wordmark {
        font-size: 1.05rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        line-height: 1.05;
        text-transform: uppercase;
        color: #E9C86B;
    }
    .wordmark-sub {
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(233, 200, 107, 0.7);
        margin-top: 0.25rem;
    }
    @media (min-width: 640px)  { .wordmark { font-size: 1.4rem; } .wordmark-sub { font-size: 0.75rem; } }
    @media (min-width: 1024px) { .wordmark { font-size: 1.75rem; } .wordmark-sub { font-size: 0.8125rem; } }

    /* Nav links */
    .nav-link {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.7rem;
        font-size: 0.9375rem;
        font-weight: 600;
        white-space: nowrap;
        color: rgba(255, 255, 255, 0.88);
        border-radius: 6px;
        transition: color var(--dur-base) var(--ease-out),
                    background-color var(--dur-base) var(--ease-out);
    }
    .nav-link:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
    .nav-link--sm { font-size: 0.8125rem; font-weight: 500; padding: 0.3rem 0.6rem; color: rgba(255,255,255,0.68); }
    .nav-link--sm:hover { color: #fff; }

    .nav-link.nav-active {
        color: #E9C86B;
        box-shadow: inset 0 -2px 0 #E9C86B;
        border-radius: 0;
    }

    .member-strip {
        margin-top: 0.15rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .nav-icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        color: #E9C86B;
        border-radius: 8px;
        transition: background-color var(--dur-base) var(--ease-out);
    }
    .nav-icon-btn:hover { background: rgba(255, 255, 255, 0.1); }

    /* Dropdown */
    .dropdown-container:hover .dropdown-menu { opacity: 1; visibility: visible; }
    .dropdown-menu {
        z-index: 1000;
        background: #241f1c;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: var(--shadow-lg);
    }
    .dropdown-link {
        display: block;
        padding: 0.55rem 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.85);
        transition: background-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
    }
    .dropdown-link:hover { background: rgba(255, 255, 255, 0.08); color: #fff; }
    .dropdown-link.is-active { color: #E9C86B; }

    /* Mobile drawer */
    .mobile-menu {
        position: fixed;
        top: 0; right: 0; bottom: 0;
        width: 300px;
        max-width: 86vw;
        background: #1A1614;
        box-shadow: -8px 0 40px rgba(0, 0, 0, 0.35);
        border-left: 3px solid #C9A227;
        transform: translateX(100%);
        transition: transform 0.3s var(--ease-out);
        z-index: 1000;
        overflow-y: auto;
    }
    .mobile-menu.active { transform: translateX(0); }

    .mobile-menu-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.3s var(--ease-out), visibility 0.3s var(--ease-out);
        z-index: 999;
    }
    .mobile-menu-overlay.active { opacity: 1; visibility: visible; pointer-events: auto; }

    .mobile-nav-link {
        display: block;
        padding: 0.75rem 1.25rem;
        font-size: 1.0625rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
        border-radius: 8px;
        transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);
    }
    .mobile-nav-link:hover { background: rgba(255, 255, 255, 0.08); color: #E9C86B; }
    .mobile-nav-active {
        background: rgba(201, 162, 39, 0.16);
        color: #E9C86B;
    }

    @media (min-width: 1024px) {
        .mobile-menu, .mobile-menu-overlay { display: none; }
    }
</style>

<script>
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    function toggleMobileMenu() {
        const isActive = mobileMenu.classList.toggle('active');
        mobileMenuOverlay.classList.toggle('active');
        menuIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
        mobileMenuToggle.setAttribute('aria-expanded', isActive.toString());
        document.body.style.overflow = isActive ? 'hidden' : '';
    }

    mobileMenuToggle?.addEventListener('click', toggleMobileMenu);
    mobileMenuOverlay?.addEventListener('click', toggleMobileMenu);

    const mobileNavLinks = mobileMenu?.querySelectorAll('a');
    mobileNavLinks?.forEach((link) => {
        link.addEventListener('click', () => {
            mobileMenu.classList.remove('active');
            mobileMenuOverlay.classList.remove('active');
            menuIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
            document.body.style.overflow = '';
        });
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu?.classList.contains('active')) {
            toggleMobileMenu();
        }
    });

    const mobileDropdownToggles = document.querySelectorAll('.mobile-dropdown-toggle');
    mobileDropdownToggles?.forEach((toggle) => {
        toggle.addEventListener('click', (e) => {
            e.preventDefault();
            const dropdownId = toggle.getAttribute('data-dropdown-id');
            const dropdownContent = document.getElementById(dropdownId);
            const icon = toggle.querySelector('.mobile-dropdown-icon');
            if (dropdownContent) {
                dropdownContent.classList.toggle('hidden');
                icon?.classList.toggle('rotate-180');
            }
        });
    });
</script>
