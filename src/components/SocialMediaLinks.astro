---
import Icon from './Icon.astro';
import { SITE_CONFIG } from '../config';

interface Props {
    layout?: 'horizontal' | 'vertical';
    size?: 'sm' | 'md' | 'lg';
}

const { layout = 'vertical', size = 'md' } = Astro.props;

const links = [
    {
        href: SITE_CONFIG.social.instagram.url,
        icon: 'instagram',
        label: SITE_CONFIG.social.instagram.label,
        description: SITE_CONFIG.social.instagram.description,
        aria: 'Follow us on Instagram',
    },
    {
        href: SITE_CONFIG.social.youtube.url,
        icon: 'youtube',
        label: SITE_CONFIG.social.youtube.label,
        description: SITE_CONFIG.social.youtube.description,
        aria: 'Subscribe to our YouTube channel',
    },
];

const iconSize = size === 'sm' ? 16 : size === 'lg' ? 22 : 18;
---

{layout === 'horizontal' ? (
    <div class="flex flex-wrap gap-2.5">
        {links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="social-pill" aria-label={l.aria}>
                <Icon name={l.icon} size={iconSize} />
            </a>
        ))}
    </div>
) : (
    <div class="space-y-3">
        {links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="social-row" aria-label={l.aria}>
                <span class="social-row__ico"><Icon name={l.icon} size={iconSize} /></span>
                <span class="social-row__body">
                    <span class="social-row__label">{l.label}</span>
                    <span class="social-row__desc">{l.description}</span>
                </span>
            </a>
        ))}
    </div>
)}

<style>
    .social-row {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1rem;
        border-radius: var(--radius-card);
        background: var(--color-surface);
        border: 1px solid var(--color-hairline);
        transition: border-color var(--dur-base) var(--ease-out),
                    box-shadow var(--dur-base) var(--ease-out);
    }
    .social-row:hover {
        border-color: var(--color-maroon-500);
        box-shadow: var(--shadow-sm);
    }
    .social-row__ico {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--color-maroon-100);
        color: var(--color-maroon-600);
        flex-shrink: 0;
    }
    .social-row__body { display: flex; flex-direction: column; line-height: 1.3; }
    .social-row__label { font-weight: 600; color: var(--color-ink); }
    .social-row__desc { font-size: 0.875rem; color: var(--color-muted-text); margin-top: 0.1rem; }

    .social-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--color-surface);
        border: 1px solid var(--color-hairline);
        color: var(--color-body-text);
        transition: all var(--dur-base) var(--ease-out);
    }
    .social-pill:hover {
        color: #fff;
        background: var(--color-maroon-600);
        border-color: var(--color-maroon-600);
    }
</style>
