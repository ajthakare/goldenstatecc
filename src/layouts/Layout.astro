---
import '../styles/globals.css';
import '@fontsource-variable/inter/wght.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import logo from '../assets/GSCC.svg';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickySocial from '../components/StickySocial.astro';
import PWATopBar from '../components/PWATopBar.astro';
import PWABottomNav from '../components/PWABottomNav.astro';
import { SITE_CONFIG } from '../config';
import { validateAdminSession, isMember } from '../middleware/auth';

interface Props {
    title: string;
}

const { title } = Astro.props;

// Used to conditionally render PWA nav (only for authenticated members)
const cookieHeader = Astro.request.headers.get('cookie');
const session = cookieHeader ? validateAdminSession(cookieHeader) : null;
const showPWANav = !!(session && isMember(session));

const vapidPublicKey = import.meta.env.PUBLIC_VAPID_PUBLIC_KEY || '';
---

<!doctype html>
<html lang="en" data-vapid-key={vapidPublicKey}>
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={SITE_CONFIG.description} />

        <!-- Non-Profit Organization Meta Tags -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content="Bengals Inc. | Golden State Cricket Club" />
        <meta property="og:description" content="Golden State Cricket Club is a part of Bengals Inc. - a 501(c)(3) non-profit organization fostering community connection through cricket across Northern California's Bay Area." />
        <meta name="organization:nonprofit-status" content="501(c)(3)" />
        <meta name="organization:legal-name" content="Bengals Inc." />

        <!-- Schema.org Structured Data for Non-Profit Organization -->
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "NonprofitOrganization",
          "name": "Bengals Inc.",
          "legalName": "Bengals Inc.",
          "alternateName": "Golden State Cricket Club",
          "url": "https://goldenstatecc.com",
          "logo": "https://goldenstatecc.com/logo.svg",
          "description": "Golden State Cricket Club is a part of Bengals Inc. - a 501(c)(3) non-profit organization fostering community connection through cricket across Northern California's Bay Area.",
          "taxID": "30-13XXXXX",
          "nonprofitStatus": "Nonprofit501c3",
          "foundingDate": "2018",
          "address": {
            "@type": "PostalAddress",
            "addressRegion": "California",
            "addressCountry": "US"
          },
          "areaServed": {
            "@type": "Place",
            "name": "Bay Area, California (San Jose, Sunnyvale, Fremont, Milpitas, Livermore, Morgan Hill, Tracy, Davis)"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "gsbengalsinc@gmail.com",
            "contactType": "General Inquiries"
          },
          "sameAs": [
            "https://www.instagram.com/goldenstate_cc/",
            "https://www.youtube.com/@GoldenstateCCBayArea"
          ]
        }
        </script>

        <link rel="icon" type="image/svg+xml" href={logo.src} />
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.json" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <meta name="apple-mobile-web-app-title" content="GSCC" />
        <meta name="theme-color" content="#8c1d18" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />

        <!-- Allow pages to inject additional head content -->
        <slot name="head" />
    </head>
    <body class="antialiased text-body" data-pwa-nav={showPWANav ? 'true' : 'false'} style="background-color: var(--color-bg-body);">

        <!-- PWA chrome: top bar + bottom nav (visible only in standalone mode via CSS) -->
        { showPWANav && <PWATopBar /> }
        { showPWANav && <PWABottomNav /> }

        <!-- Single layout — CSS adapts it for both browser and PWA standalone mode -->
        <div class="site-wrapper flex flex-col min-h-screen px-6 bg-noise sm:px-12" style="overflow: visible;">
            <div class="flex flex-col w-full max-w-5xl mx-auto grow" style="overflow: visible;">
                <div class="site-header-wrapper"><Header /></div>
                <main class="site-main grow" style="overflow: visible;"><slot /></main>
                <div class="site-footer-wrapper"><Footer /></div>
            </div>
        </div>

        <StickySocial />

        <!-- PWA Install Banner -->
        <div id="pwa-install-banner" style="display:none;" role="banner" aria-label="Install app">
          <img src="/icons/icon-192.png" alt="GSCC" width="36" height="36" class="pwa-install-icon" />
          <span class="pwa-install-text">Install the GSCC app</span>
          <button id="pwa-install-btn" class="pwa-install-action">Install</button>
          <button id="pwa-install-dismiss" class="pwa-install-close" aria-label="Dismiss">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        { showPWANav && (
          <div id="notif-prompt" style="display:none;" class="fixed z-50 left-4 right-4 bottom-20 sm:left-auto sm:right-4 sm:w-80 bg-white rounded-2xl shadow-xl border border-gray-100 p-4 flex items-center gap-3">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-red-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-gray-900 leading-tight">Stay updated</p>
              <p class="text-xs text-gray-500 mt-0.5">Get notified about fixture votes &amp; practices</p>
            </div>
            <div class="flex flex-col gap-1.5 flex-shrink-0">
              <button id="notif-allow" class="px-3 py-1.5 text-xs font-semibold bg-red-700 text-white rounded-lg hover:bg-red-800 transition-colors">Enable</button>
              <button id="notif-dismiss" class="px-3 py-1.5 text-xs font-medium text-gray-500 hover:text-gray-700 transition-colors">Later</button>
            </div>
          </div>
        )}

        <script>
          // Register service worker
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
              navigator.serviceWorker.register('/sw.js').catch(() => {/* silently ignore */});
            });
          }

          // ─── PWA Install Prompt ───────────────────────────────────────────
          let deferredPrompt: any = null;

          window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;

            const dismissed = localStorage.getItem('gscc-pwa-dismissed');
            if (dismissed) {
              const thirtyDays = 30 * 24 * 60 * 60 * 1000;
              if (Date.now() - parseInt(dismissed, 10) < thirtyDays) return;
            }

            const banner = document.getElementById('pwa-install-banner');
            if (banner) banner.style.display = 'flex';
          });

          document.getElementById('pwa-install-btn')?.addEventListener('click', async () => {
            if (!deferredPrompt) return;
            deferredPrompt.prompt();
            const { outcome } = await deferredPrompt.userChoice;
            if (outcome === 'accepted') {
              const banner = document.getElementById('pwa-install-banner');
              if (banner) banner.style.display = 'none';
            }
            deferredPrompt = null;
          });

          document.getElementById('pwa-install-dismiss')?.addEventListener('click', () => {
            const banner = document.getElementById('pwa-install-banner');
            if (banner) banner.style.display = 'none';
            localStorage.setItem('gscc-pwa-dismissed', Date.now().toString());
          });

          window.addEventListener('appinstalled', () => {
            const banner = document.getElementById('pwa-install-banner');
            if (banner) banner.style.display = 'none';
            deferredPrompt = null;
          });

          // ─── Push notification prompt + subscription ──────────────────────
          const VAPID_PUBLIC_KEY = document.documentElement.dataset.vapidKey;
          const NOTIF_PREF_KEY = 'gscc_notif_pref'; // 'granted' | 'dismissed'

          function urlBase64ToUint8Array(base64: string): Uint8Array {
            const padding = '='.repeat((4 - (base64.length % 4)) % 4);
            const b64 = (base64 + padding).replace(/-/g, '+').replace(/_/g, '/');
            const raw = atob(b64);
            return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
          }

          async function subscribeToPush(reg: ServiceWorkerRegistration): Promise<void> {
            if (!VAPID_PUBLIC_KEY) return;
            try {
              const sub = await reg.pushManager.subscribe({
                userVisibleOnly: true,
                applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY),
              });
              await fetch('/.netlify/functions/push-subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ subscription: sub.toJSON() }),
              });
            } catch (err) {
              console.warn('Push subscription failed:', err);
            }
          }

          async function initNotificationPrompt(): Promise<void> {
            const prompt = document.getElementById('notif-prompt');
            if (!prompt || !VAPID_PUBLIC_KEY) return;

            if (Notification.permission === 'granted') {
              localStorage.setItem(NOTIF_PREF_KEY, 'granted');
              const reg = await navigator.serviceWorker.ready;
              const existing = await reg.pushManager.getSubscription();
              if (!existing) await subscribeToPush(reg);
              return;
            }

            if (Notification.permission === 'denied') return;
            if (localStorage.getItem(NOTIF_PREF_KEY) === 'dismissed') return;
            if (localStorage.getItem(NOTIF_PREF_KEY) === 'granted') return;

            setTimeout(() => { prompt.style.display = 'flex'; }, 3000);

            document.getElementById('notif-allow')?.addEventListener('click', async () => {
              prompt.style.display = 'none';
              const permission = await Notification.requestPermission();
              if (permission === 'granted') {
                localStorage.setItem(NOTIF_PREF_KEY, 'granted');
                const reg = await navigator.serviceWorker.ready;
                await subscribeToPush(reg);
              } else {
                localStorage.setItem(NOTIF_PREF_KEY, 'dismissed');
              }
            });

            document.getElementById('notif-dismiss')?.addEventListener('click', () => {
              prompt.style.display = 'none';
              localStorage.setItem(NOTIF_PREF_KEY, 'dismissed');
            });
          }

          if ('Notification' in window && 'serviceWorker' in navigator) {
            navigator.serviceWorker.ready.then(() => initNotificationPrompt());
          }

          // ─── PWA layout: measure actual rendered bar heights and apply to site-wrapper.
          // We target site-wrapper (not site-main) because site-wrapper has no inline style,
          // so JS assignments win cleanly without fighting CSS specificity.
          function applyPWALayout() {
            const isStandalone = window.matchMedia('(display-mode: standalone)').matches
              || (navigator as any).standalone === true;
            if (!isStandalone) return;

            const siteWrapper = document.querySelector('.site-wrapper') as HTMLElement;
            if (!siteWrapper) return;

            const topBar = document.getElementById('pwa-topbar');
            const bottomNav = document.getElementById('pwa-bottom-nav');

            const topOffset = topBar ? topBar.getBoundingClientRect().height : 0;
            const bottomOffset = bottomNav ? bottomNav.getBoundingClientRect().height : 0;

            siteWrapper.style.position = 'fixed';
            siteWrapper.style.top = topOffset + 'px';
            siteWrapper.style.bottom = bottomOffset + 'px';
            siteWrapper.style.left = '0';
            siteWrapper.style.right = '0';
            siteWrapper.style.overflowY = 'auto';
            siteWrapper.style.overflowX = 'hidden';
            siteWrapper.style.padding = '0';
          }

          // requestAnimationFrame ensures CSS + layout are fully computed before measuring
          requestAnimationFrame(applyPWALayout);
        </script>
    </body>
</html>

<style is:global>
  /* ─── PWA Standalone Layout ──────────────────────────────── */

  /* CSS custom properties for PWA chrome heights */
  :root {
    --pwa-topbar-height: 52px;
    --pwa-bottomnav-height: 56px;
  }

  @media (display-mode: standalone) {
    html, body {
      height: 100dvh;
      overflow: hidden;
    }

    /* site-wrapper becomes the scroll container — it has no inline style so CSS wins cleanly */
    body[data-pwa-nav="true"] .site-wrapper {
      position: fixed !important;
      top: calc(var(--pwa-topbar-height) + env(safe-area-inset-top));
      bottom: calc(var(--pwa-bottomnav-height) + env(safe-area-inset-bottom));
      left: 0;
      right: 0;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-y: contain;
      padding: 0 !important;
      min-height: unset !important;
      background-color: var(--color-bg-body, #f9fafb);
    }

    /* Kill any top spacing on the main content area itself */
    body[data-pwa-nav="true"] .site-main {
      padding-top: 0 !important;
      margin-top: 0 !important;
    }

    body[data-pwa-nav="false"] .site-wrapper {
      position: fixed !important;
      top: env(safe-area-inset-top);
      bottom: env(safe-area-inset-bottom);
      left: 0;
      right: 0;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      padding-left: 0 !important;
      padding-right: 0 !important;
      min-height: unset !important;
    }

    /* Hide header and footer in standalone mode */
    .site-header-wrapper,
    .site-footer-wrapper {
      display: none !important;
    }

    /* site-main: let site-wrapper handle all scrolling */
    .site-main {
      overflow: visible !important;
      height: auto !important;
    }

    /* Restore a consistent side gutter in the app.
       The scroll container (.site-wrapper) must stay padding:0 for the
       fixed-position scroll math, so the gutter lives on .site-main. */
    .site-main {
      padding-left: max(1.05rem, env(safe-area-inset-left)) !important;
      padding-right: max(1.05rem, env(safe-area-inset-right)) !important;
    }
    /* Inner containers already carry their own horizontal padding in the
       browser — collapse it here so it isn't doubled / misaligned. */
    .site-main .section-inner,
    .site-main > [class*="max-w-"] {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    /* Remove top padding from first content element — no gap below top bar */
    .site-main > *:first-child,
    .site-main > section.section-spacing:first-child {
      padding-top: 0 !important;
      margin-top: 0 !important;
    }

    /* Keep section-spacing horizontal padding but kill vertical on first section */
    .site-main > section.section-spacing:first-child {
      padding-top: 0 !important;
    }

    /* Ensure last content has breathing room above bottom nav */
    .site-main > *:last-child {
      padding-bottom: 1.5rem !important;
    }

    /* Hide sticky social buttons — not needed in app */
    .sticky-social-wrapper {
      display: none !important;
    }

    /* Adjust toast position to clear bottom nav */
    .toast {
      bottom: calc(var(--pwa-bottomnav-height) + env(safe-area-inset-bottom) + 12px) !important;
      right: max(16px, env(safe-area-inset-right)) !important;
    }

    /* Hide install banner in standalone mode */
    #pwa-install-banner {
      display: none !important;
    }
  }

  /* PWA Install Banner */
  #pwa-install-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    align-items: center;
    gap: 12px;
    padding: 12px max(16px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
    background: linear-gradient(135deg, #8c1d18 0%, #5a1410 100%);
    border-top: 1px solid rgba(229, 200, 120, 0.3);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.3);
  }

  .pwa-install-icon {
    border-radius: 8px;
    flex-shrink: 0;
  }

  .pwa-install-text {
    flex: 1;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    min-width: 0;
  }

  .pwa-install-action {
    flex-shrink: 0;
    padding: 8px 20px;
    background: #E5C878;
    color: #1a0a09;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .pwa-install-action:hover {
    opacity: 0.85;
  }

  .pwa-install-close {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.2s;
  }

  .pwa-install-close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
</style>
